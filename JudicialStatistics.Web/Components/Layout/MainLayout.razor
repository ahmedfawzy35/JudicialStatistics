@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject JudicialStatistics.Web.Services.CurrentCourtState CourtState
@inject AuthenticationStateProvider AuthStateProvider

<div class="app-layout" dir="rtl">

    @* Sidebar *@
    <aside class="app-sidebar">
        <div class="sidebar-logo d-flex justify-between align-center">
            <div class="d-flex align-center gap-2">
                <span style="font-size:1.4rem;">⚖️</span>
                <span class="sidebar-logo-text">الإحصاء القضائي</span>
            </div>
            <button type="button" class="mobile-sidebar-close-btn" aria-label="إغلاق القائمة">✕</button>
        </div>

        <nav class="sidebar-nav" aria-label="القائمة الرئيسية">
            @* لوحة التحكم *@
            <div class="nav-section">
                <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                    <span class="nav-icon">🏠</span>
                    <span class="nav-label">الرئيسية</span>
                </NavLink>
            </div>

            <div class="nav-section">
                <div class="nav-section-label">الإحصائية</div>
            </div>
            <NavLink class="nav-item" href="/statistics">
                <span class="nav-icon">📊</span>
                <span class="nav-label">الإحصائيات الشهرية</span>
            </NavLink>
            <NavLink class="nav-item" href="/statistics/import">
                <span class="nav-icon">📥</span>
                <span class="nav-label">استيراد من Excel</span>
            </NavLink>

            <div class="nav-section">
                <div class="nav-section-label">التقارير القضائية</div>
            </div>
            <NavLink class="nav-item" href="/reports/circuit-judgments">
                <span class="nav-icon">⚖️</span>
                <span class="nav-label">أحكام الدوائر والجلسات</span>
            </NavLink>
            <NavLink class="nav-item" href="/reports/entry-progress">
                <span class="nav-icon">📋</span>
                <span class="nav-label">نسبة إدخال الإحصائية</span>
            </NavLink>
            <NavLink class="nav-item" href="/reports">
                <span class="nav-icon">📈</span>
                <span class="nav-label">التقارير وترتيب الدوائر</span>
            </NavLink>

            <div class="nav-section">
                <div class="nav-section-label">إدارة المحاكم</div>
            </div>
            <NavLink class="nav-item" href="/organization">
                <span class="nav-icon">🗂️</span>
                <span class="nav-label">التشكيل القضائي</span>
            </NavLink>
            <NavLink class="nav-item" href="/judge-movements">
                <span class="nav-icon">📜</span>
                <span class="nav-label">حركات وانتدابات القضاة</span>
            </NavLink>
            <NavLink class="nav-item" href="/courts">
                <span class="nav-icon">🏛️</span>
                <span class="nav-label">المحاكم التابعة</span>
            </NavLink>
            <NavLink class="nav-item" href="/geo-areas">
                <span class="nav-icon">📍</span>
                <span class="nav-label">النطاقات الجغرافية</span>
            </NavLink>
            @if (CourtState.IsSystemAdmin || CourtState.IsScopeAdmin || CourtState.CanManagePeriodStatus)
            {
                <NavLink class="nav-item" href="/judicial-years">
                    <span class="nav-icon">📅</span>
                    <span class="nav-label">الأعوام وفترات الإحصاء</span>
                </NavLink>
            }

            @if (CourtState.IsSystemAdmin || CourtState.IsScopeAdmin)
            {
                <div class="nav-section">
                    <div class="nav-section-label">الإدارة والتحكم</div>
                </div>
                <NavLink class="nav-item" href="/users">
                    <span class="nav-icon">👥</span>
                    <span class="nav-label">إدارة المستخدمين</span>
                </NavLink>
                <NavLink class="nav-item" href="/settings">
                    <span class="nav-icon">⚙️</span>
                    <span class="nav-label">إعدادات النظام والتقارير</span>
                </NavLink>
            }

            @if (CourtState.IsSystemAdmin)
            {
                <NavLink class="nav-item" href="/rules">
                    <span class="nav-icon">📑</span>
                    <span class="nav-label">قواعد التصنيف</span>
                </NavLink>
                <NavLink class="nav-item" href="/audit">
                    <span class="nav-icon">📜</span>
                    <span class="nav-label">سجل التدقيق</span>
                </NavLink>
            }
        </nav>

        <div style="padding:.75rem">
            <button type="button" class="nav-item sidebar-collapse-btn" id="sidebarCollapseBtn" style="width:100%" title="تصغير / توسيع القائمة">
                <span class="nav-icon" id="sidebarToggleIcon">«</span>
                <span class="nav-label" id="sidebarToggleLabel">تصغير القائمة</span>
            </button>
        </div>

        <AuthorizeView>
            <Authorized>
                <div style="padding:.75rem;border-top:1px solid var(--border-color);margin-top:auto">
                    <form action="/Account/Logout" method="post" style="width:100%">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/Account/Login" />
                        <button type="submit" class="nav-item" style="width:100%;background:none;border:none;color:var(--status-danger, #dc3545);cursor:pointer" title="تسجيل الخروج">
                            <span class="nav-icon">🚪</span>
                            <span class="nav-label">تسجيل الخروج</span>
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </aside>

    @* Header *@
    <header class="app-header">
        <div class="header-start d-flex align-center gap-2">
            <button type="button" class="btn btn-icon btn-outline-secondary mobile-menu-btn"
                    title="القائمة الرئيسية">
                ☰
            </button>

            @* محدد المحكمة الابتدائية (SaaS Multi-tenant) *@
            <PrimaryCourtSelector />
        </div>

        <div class="header-end d-flex align-center gap-2">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-center gap-2 user-header-info">
                        <span class="badge badge-primary user-role-badge">
                            @(string.IsNullOrEmpty(CourtState.CurrentUserRoleName) ? "مستخدم" : CourtState.CurrentUserRoleName)
                        </span>
                        <span class="fw-semibold user-name-display" style="font-size:.85rem;color:var(--text-primary)">
                            @(string.IsNullOrEmpty(CourtState.CurrentUserFullName) ? context.User.Identity?.Name : CourtState.CurrentUserFullName)
                        </span>
                    </div>
                    <form action="/Account/Logout" method="post" style="display:inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/Account/Login" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="تسجيل الخروج">
                            خروج
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login" class="btn btn-sm btn-primary">تسجيل الدخول</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    @* Main Content *@
    <main class="app-main" role="main">
        <CascadingValue Value="this">
            @Body
        </CascadingValue>
    </main>
</div>

@* Mobile Overlay *@
<div class="mobile-overlay" id="mobileOverlay"></div>

@* Blazor Error UI *@
<div id="blazor-error-ui" data-nosnippet>
    حدث خطأ غير متوقع.
    <a href="." class="reload">إعادة التحميل</a>
    <span class="dismiss">✕</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        CourtState.OnChange += OnCourtStateChanged;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true)
        {
            await CourtState.EnsureInitializedAsync(auth.User);
        }
    }

    private void OnCourtStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CourtState.OnChange -= OnCourtStateChanged;
    }
}
