</style>

@code {
    private List<JudicialYearDto>? years;
    private List<StatisticalPeriodDto>? periods;
    private List<CourtUnitDto>? courtUnits;
    private List<CaseTaxonomyNodeDto>? fullTaxonomyTree;
    private List<CaseTaxonomyNodeDto>? availableMainTaxonomies;
    private List<CaseTypeDto>? availableSubCaseTypes;

    private long? selectedYearId;
    private string periodMode = "single"; // "single" | "multi"
    private long? selectedSinglePeriodId;
    private HashSet<long> selectedMultiPeriodIds = new();
    private bool isPeriodDropdownOpen = false;

    private string selectedCourtIdString = "";
    private string selectedDisciplineCode = "";
    private string selectedMainTaxonomyIdString = "";
    private string selectedSubCaseTypeIdString = "";

    private CircuitJudgmentsReportDto? report;
    private bool isLoading = false;
    private bool isExporting = false;
    private string? feedbackMessage;

    protected override async Task OnInitializedAsync()
    {
        years = await YearsService.GetYearsAsync();
        var activeYear = await YearsService.GetActiveYearAsync() ?? years.FirstOrDefault();
        selectedYearId = activeYear?.Id;

        if (selectedYearId.HasValue)
        {
            await LoadPeriodsForYearAsync(selectedYearId.Value);
        }

        courtUnits = await CourtsService.GetFlatAsync(true);
        if (CourtState.SelectedPrimaryCourtId.HasValue && !CourtState.IsSystemAdmin)
        {
            var pId = CourtState.SelectedPrimaryCourtId.Value;
            courtUnits = courtUnits.Where(c => c.Id == pId || c.ParentCourtUnitId == pId).ToList();
        }

        fullTaxonomyTree = await RulesService.GetTaxonomyTreeAsync();
        UpdateCascadingTaxonomies();
    }

    private async Task LoadPeriodsForYearAsync(long yearId)
    {
        periods = await YearsService.GetPeriodsForYearAsync(yearId);
        periods = periods.OrderBy(p => p.MonthStartDate).ToList();

        var now = DateOnly.FromDateTime(DateTime.Today);
        var currentPeriod = periods.FirstOrDefault(p => p.MonthStartDate.Year == now.Year && p.MonthStartDate.Month == now.Month)
                            ?? periods.LastOrDefault();

        selectedSinglePeriodId = currentPeriod?.Id;
        selectedMultiPeriodIds.Clear();
        if (selectedSinglePeriodId.HasValue)
        {
            selectedMultiPeriodIds.Add(selectedSinglePeriodId.Value);
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var yId))
        {
            selectedYearId = yId;
            await LoadPeriodsForYearAsync(yId);
        }
    }

    private void SetPeriodMode(string mode)
    {
        periodMode = mode;
        if (mode == "single" && selectedSinglePeriodId.HasValue)
        {
            selectedMultiPeriodIds.Clear();
            selectedMultiPeriodIds.Add(selectedSinglePeriodId.Value);
        }
    }

    private void OnSinglePeriodChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var pId))
        {
            selectedSinglePeriodId = pId;
            selectedMultiPeriodIds.Clear();
            selectedMultiPeriodIds.Add(pId);
        }
    }

    private void TogglePeriodDropdown() => isPeriodDropdownOpen = !isPeriodDropdownOpen;

    private void TogglePeriodSelection(long pId, ChangeEventArgs e)
    {
        bool isChecked = e.Value is bool b && b;
        if (isChecked) selectedMultiPeriodIds.Add(pId);
        else selectedMultiPeriodIds.Remove(pId);
    }

    private void SelectAllPeriods()
    {
        if (periods is null) return;
        selectedMultiPeriodIds = periods.Select(p => p.Id).ToHashSet();
    }

    private void ClearAllPeriods()
    {
        selectedMultiPeriodIds.Clear();
    }

    private void OnCourtChanged(ChangeEventArgs e)
    {
        selectedCourtIdString = e.Value?.ToString() ?? "";
    }

    private void OnDisciplineChanged(ChangeEventArgs e)
    {
        selectedDisciplineCode = e.Value?.ToString() ?? "";
        selectedMainTaxonomyIdString = "";
        selectedSubCaseTypeIdString = "";
        UpdateCascadingTaxonomies();
    }

    private void UpdateCascadingTaxonomies()
    {
        if (fullTaxonomyTree is null) return;

        if (string.IsNullOrWhiteSpace(selectedDisciplineCode))
        {
            availableMainTaxonomies = fullTaxonomyTree.SelectMany(r => r.Children).ToList();
        }
        else
        {
            var rootCode = selectedDisciplineCode.ToUpperInvariant() switch
            {
                "CIVIL" => "CIVIL",
                "CRIMINAL" => "CRIMINAL",
                "FAMILY" => "FAMILY",
                "LABOR" => "LABOR",
                _ => selectedDisciplineCode
            };

            var rootNode = fullTaxonomyTree.FirstOrDefault(n => n.Code.Equals(rootCode, StringComparison.OrdinalIgnoreCase));
            if (rootNode != null && rootNode.Children.Count > 0)
            {
                availableMainTaxonomies = rootNode.Children;
            }
            else if (rootNode != null)
            {
                availableMainTaxonomies = new List<CaseTaxonomyNodeDto> { rootNode };
            }
            else
            {
                availableMainTaxonomies = new List<CaseTaxonomyNodeDto>();
            }
        }

        UpdateSubCaseTypesAsync();
    }

    private void OnMainTaxonomyChanged(ChangeEventArgs e)
    {
        selectedMainTaxonomyIdString = e.Value?.ToString() ?? "";
        selectedSubCaseTypeIdString = "";
        UpdateSubCaseTypesAsync();
    }

    private async void UpdateSubCaseTypesAsync()
    {
        if (long.TryParse(selectedMainTaxonomyIdString, out var mainTaxId))
        {
            availableSubCaseTypes = await RulesService.GetCaseTypesAsync(mainTaxId);
        }
        else
        {
            availableSubCaseTypes = null;
        }
        StateHasChanged();
    }

    private void OnSubCaseTypeChanged(ChangeEventArgs e)
    {
        selectedSubCaseTypeIdString = e.Value?.ToString() ?? "";
    }

    private List<long> GetEffectivePeriodIds()
    {
        if (periodMode == "single")
        {
            return selectedSinglePeriodId.HasValue ? new List<long> { selectedSinglePeriodId.Value } : new List<long>();
        }
        return selectedMultiPeriodIds.ToList();
    }

    private async Task LoadReportAsync()
    {
        if (!selectedYearId.HasValue)
        {
            feedbackMessage = "يرجى اختيار العام القضائي أولاً.";
            return;
        }

        var pIds = GetEffectivePeriodIds();
        if (pIds.Count == 0)
        {
            feedbackMessage = "يرجى تحديد شهر واحد على الأقل للاستخراج.";
            return;
        }

        isLoading = true;
        feedbackMessage = null;
        isPeriodDropdownOpen = false;

        try
        {
            long? courtId = long.TryParse(selectedCourtIdString, out var cId) ? cId : null;
            long? mainTaxId = long.TryParse(selectedMainTaxonomyIdString, out var mtId) ? mtId : null;
            long? subCtId = long.TryParse(selectedSubCaseTypeIdString, out var sctId) ? sctId : null;

            var filter = new CircuitJudgmentsFilter(
                selectedYearId.Value,
                pIds,
                courtId,
                string.IsNullOrWhiteSpace(selectedDisciplineCode) ? null : selectedDisciplineCode,
                mainTaxId,
                subCtId
            );

            report = await ReportsService.GetCircuitJudgmentsReportAsync(filter);
            if (report.CourtGroups.Count == 0)
            {
                feedbackMessage = "لم يتم العثور على أي جلسات أو إحصائيات معتمدة مطابقة لخيارات الفلترة المحددة.";
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = "حدث خطأ أثناء تحميل التقرير: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportToExcelAsync()
    {
        if (report is null || !selectedYearId.HasValue) return;

        var pIds = GetEffectivePeriodIds();
        if (pIds.Count == 0) return;

        isExporting = true;
        feedbackMessage = null;

        try
        {
            long? courtId = long.TryParse(selectedCourtIdString, out var cId) ? cId : null;
            long? mainTaxId = long.TryParse(selectedMainTaxonomyIdString, out var mtId) ? mtId : null;
            long? subCtId = long.TryParse(selectedSubCaseTypeIdString, out var sctId) ? sctId : null;

            var filter = new CircuitJudgmentsFilter(
                selectedYearId.Value,
                pIds,
                courtId,
                string.IsNullOrWhiteSpace(selectedDisciplineCode) ? null : selectedDisciplineCode,
                mainTaxId,
                subCtId
            );

            var fileBytes = await ReportsService.ExportCircuitJudgmentsToExcelAsync(filter);
            var fileName = $"تقرير_أحكام_الدوائر_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            var base64 = Convert.ToBase64String(fileBytes);
            await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            feedbackMessage = "تم تصدير ملف الإكسل بنجاح وحفظه على جهازك.";
        }
        catch (Exception ex)
        {
            feedbackMessage = "فشل تصدير ملف الإكسل: " + ex.Message;
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task PrintReportAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private static int GetRowVal(CircuitJudgmentsSessionRowDto row, string columnKey) => columnKey switch
    {
        "FINAL" => row.FinalCount,
        "INTERLOC" => row.InterlocutoryCount,
        "EVID_EXPERT" => row.ExpertCount,
        "EVID_OTHER" => row.OtherEvidenceCount,
        "EVID_TOTAL" => row.TotalEvidenceCount,
        "STAY" => row.StayCount,
        "OTHER" => row.OtherCount,
        "TOTAL_JUDGMENTS" => row.TotalJudgmentsCount,
        _ => row.DetailedCounts.GetValueOrDefault(columnKey, 0)
    };

    private static string GetColumnHeaderClass(string columnKey) => columnKey switch
    {
        "FINAL" => "th-final",
        "EVID_TOTAL" => "th-evidence-total",
        "TOTAL_JUDGMENTS" => "th-total-judgments",
        _ => ""
    };

    private static string GetColumnCellClass(string columnKey) => columnKey switch
    {
        "FINAL" => "cell-final",
        "EVID_TOTAL" => "cell-evidence-total",
        "TOTAL_JUDGMENTS" => "cell-total-judgments",
        _ => ""
    };
}
