@page "/reports/circuit-judgments"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using JudicialStatistics.Application.Reports
@using JudicialStatistics.Application.Years
@using JudicialStatistics.Application.Courts
@using JudicialStatistics.Application.Rules
@using JudicialStatistics.Application.Organization
@inject IReportsService ReportsService
@inject IJudicialYearsService YearsService
@inject ICourtsService CourtsService
@inject IRulesService RulesService
@inject IOrganizationService OrgService
@inject JudicialStatistics.Web.Services.CurrentCourtState CourtState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>تقرير أحكام الدوائر والجلسات — الإحصاء القضائي</PageTitle>

<div class="circuit-report-wrapper" dir="rtl">

    @* ==================== ترويسة الصفحة والإجراءات ==================== *@
    <div class="page-header d-flex justify-between align-center flex-wrap gap-3 mb-4 d-print-none">
        <div>
            <div class="d-flex align-center gap-2">
                <span style="font-size:1.8rem;">⚖️</span>
                <h1 class="page-title m-0">تقرير أحكام الدوائر وتوزيع الجلسات</h1>
            </div>
            <p class="page-subtitle mt-1 mb-0">
                كشف إحصائي تفصيلي وتجميعي لأحكام الجلسات والدوائر والمحاكم والمأموريات طبقاً لقواعد العمل والإحصائيات المعتمدة
            </p>
        </div>

        <div class="d-flex align-center gap-2 flex-wrap">
            <a href="/settings" class="btn btn-outline-secondary d-flex align-center gap-2" title="تخصيص وإعداد أعمدة التقرير">
                <span>⚙️ إعدادات التقرير والأعمدة</span>
            </a>
            <button class="btn btn-outline-secondary d-flex align-center gap-2" @onclick="PrintReportAsync" title="طباعة التقرير أو حفظ PDF">
                <span>🖨️ طباعة / حفظ PDF</span>
            </button>
            <button class="btn btn-success d-flex align-center gap-2" @onclick="ExportToExcelAsync" disabled="@(isExporting || report is null)">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>جاري التصدير...</span>
                }
                else
                {
                    <span>📥 تصدير إلى Excel (.xlsx)</span>
                }
            </button>
        </div>
    </div>

    @* رسائل التنبيه أو التصدير *@
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(feedbackMessage.Contains("فشل") || feedbackMessage.Contains("خطأ") ? "alert-danger" : "alert-success") alert-dismissible mb-3 d-flex justify-between align-center d-print-none">
            <div>@feedbackMessage</div>
            <button type="button" class="btn-close" @onclick="() => feedbackMessage = null">✕</button>
        </div>
    }

    @* ==================== شريط الفلاتر التفاعلي ==================== *@
    <div class="card mb-4 filter-card d-print-none">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">

                @* 1. العام القضائي *@
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">📅 العام القضائي</label>
                    <select class="form-control form-control-sm" value="@selectedYearId" @onchange="OnYearChanged">
                        @if (years is not null)
                        {
                            @foreach (var y in years)
                            {
                                <option value="@y.Id">@y.NameAr</option>
                            }
                        }
                    </select>
                </div>

                @* 2. نمط الفترة الشهرية *@
                <div class="col-md-3 col-sm-6">
                    <div class="d-flex justify-between align-center mb-1">
                        <label class="form-label fw-bold m-0">🗓️ الفترة / الشهور</label>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-xs @(periodMode == "single" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPeriodMode("single")'>شهر واحد</button>
                            <button type="button" class="btn btn-xs @(periodMode == "multi" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPeriodMode("multi")'>شهور متعددة</button>
                        </div>
                    </div>

                    @if (periodMode == "single")
                    {
                        <select class="form-control form-control-sm" value="@selectedSinglePeriodId" @onchange="OnSinglePeriodChanged">
                            @if (periods is not null)
                            {
                                @foreach (var p in periods)
                                {
                                    <option value="@p.Id">@p.MonthStartDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))</option>
                                }
                            }
                        </select>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-end d-flex justify-between align-center" type="button" @onclick="TogglePeriodDropdown">
                                <span>@(selectedMultiPeriodIds.Count == 0 ? "اختر شهور التقرير..." : $"تم اختيار ({selectedMultiPeriodIds.Count}) شهر")</span>
                                <span class="arrow">▼</span>
                            </button>
                            @if (isPeriodDropdownOpen)
                            {
                                <div class="dropdown-menu show p-2 w-100 shadow" style="max-height:240px;overflow-y:auto;position:absolute;z-index:1050;background:white;border:1px solid #cbd5e1;">
                                    <div class="d-flex justify-between mb-2 pb-1 border-bottom">
                                        <button class="btn btn-xs btn-link p-0 text-primary" @onclick="SelectAllPeriods">تحديد الكل</button>
                                        <button class="btn btn-xs btn-link p-0 text-danger" @onclick="ClearAllPeriods">مسح التحديد</button>
                                    </div>
                                    @if (periods is not null)
                                    {
                                        @foreach (var p in periods)
                                        {
                                            var isChecked = selectedMultiPeriodIds.Contains(p.Id);
                                            <div class="form-check py-1">
                                                <input class="form-check-input" type="checkbox" id="p_@p.Id" checked="@isChecked" @onchange="(e) => TogglePeriodSelection(p.Id, e)" />
                                                <label class="form-check-label ms-2 cursor-pointer" for="p_@p.Id">
                                                    @p.MonthStartDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                                                </label>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @* 3. المحكمة أو المأمورية *@
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">🏛️ المحكمة / المأمورية</label>
                    <select class="form-control form-control-sm" value="@selectedCourtIdString" @onchange="OnCourtChanged">
                        <option value="">(كافة المحاكم والمأموريات)</option>
                        @if (courtUnits is not null)
                        {
                            @foreach (var cu in courtUnits)
                            {
                                <option value="@cu.Id">@cu.NameAr</option>
                            }
                        }
                    </select>
                </div>

                @* 4. النوع الأساسي للدائرة (التخصص) *@
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">⚖️ نوع الدائرة الأساسي</label>
                    <select class="form-control form-control-sm" value="@selectedDisciplineCode" @onchange="OnDisciplineChanged">
                        <option value="">(كافة التخصصات)</option>
                        <option value="CIVIL">مدني</option>
                        <option value="CRIMINAL">جنائي</option>
                        <option value="FAMILY">أسرة</option>
                        <option value="LABOR">عمال</option>
                    </select>
                </div>

                @* 5. نوع القضايا الرئيسي *@
                <div class="col-md-3 col-sm-6">
                    <label class="form-label fw-bold">📑 نوع القضايا الرئيسي</label>
                    <select class="form-control form-control-sm" value="@selectedMainTaxonomyIdString" @onchange="OnMainTaxonomyChanged">
                        <option value="">(كافة الأنواع الرئيسية)</option>
                        @if (availableMainTaxonomies is not null)
                        {
                            @foreach (var tax in availableMainTaxonomies)
                            {
                                <option value="@tax.Id">@tax.NameAr</option>
                            }
                        }
                    </select>
                </div>

                @* 6. نوع القضايا الفرعي *@
                <div class="col-md-3 col-sm-6">
                    <label class="form-label fw-bold">🔹 نوع القضايا الفرعي</label>
                    <select class="form-control form-control-sm" value="@selectedSubCaseTypeIdString" @onchange="OnSubCaseTypeChanged">
                        <option value="">(كافة الأنواع الفرعية)</option>
                        @if (availableSubCaseTypes is not null)
                        {
                            @foreach (var ct in availableSubCaseTypes)
                            {
                                <option value="@ct.Id">@ct.NameAr</option>
                            }
                        }
                    </select>
                </div>

                @* زر استخراج التقرير *@
                <div class="col-md-2 col-sm-6">
                    <button class="btn btn-primary btn-sm w-100 d-flex align-center justify-center gap-2" @onclick="LoadReportAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>جاري التحميل...</span>
                        }
                        else
                        {
                            <span>🔍 عرض التقرير</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>

    @* ==================== محتوى التقرير ==================== *@

    @* ترويسة التقرير الرسمية للطباعة والمعاينة *@
    @if (report is not null)
    {
        <div class="report-meta-box p-3 mb-3 border rounded bg-white shadow-sm">
            <div class="d-flex justify-between align-center flex-wrap gap-2">
                <div>
                    <h3 class="m-0 fw-bold" style="color:#0f172a;">@report.CourtFilterNameAr</h3>
                    <div class="text-muted mt-1" style="font-size:0.9rem;">
                        <span>العام القضائي: <strong>@report.JudicialYearNameAr</strong></span> |
                        <span>الفترة: <strong>@report.PeriodRangeNameAr</strong></span> |
                        <span>التخصص: <strong>@report.DisciplineFilterNameAr</strong></span> |
                        <span>نوع القضايا: <strong>@report.CaseTypeFilterNameAr</strong></span>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge badge-success px-3 py-2" style="font-size:0.85rem;">🔒 إحصائيات معتمدة نهائياً فقط</span>
                </div>
            </div>
        </div>

        @* جدول التقرير المتكامل *@
        <div class="table-responsive card border-0 shadow-sm mb-4">
            <table class="table table-bordered table-hover align-middle m-0 circuit-report-table text-center">
                <thead>
                    <tr class="header-main-row">
                        <th style="width:40px;">م</th>
                        <th>المحكمة</th>
                        <th>الدائرة</th>
                        <th>نوع الدائرة</th>
                        <th>الجلسة</th>
                        <th>نوع القضايا</th>
                        @foreach (var col in report.ActiveColumns)
                        {
                            var headerClass = GetColumnHeaderClass(col.ColumnKey);
                            <th class="@headerClass">@col.EffectiveTitleAr</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        int seq = 1;
                    }
                    @foreach (var courtGrp in report.CourtGroups)
                    {
                        @foreach (var circGrp in courtGrp.CircuitGroups)
                        {
                            @foreach (var row in circGrp.SessionRows)
                            {
                                <tr class="session-data-row">
                                    <td class="text-muted">@(seq++)</td>
                                    <td class="text-start fw-semibold">@row.CourtNameAr</td>
                                    <td class="text-start">@row.CircuitNameAr</td>
                                    <td><span class="badge badge-light-blue">@row.CircuitKindAr</span></td>
                                    <td class="text-start fw-bold" style="color:#1e293b;">@row.SessionNameAr</td>
                                    <td class="text-start"><span class="badge badge-subtle-gray">@row.CaseTypeNamesAr</span></td>

                                    @foreach (var col in report.ActiveColumns)
                                    {
                                        int val = GetRowVal(row, col.ColumnKey);
                                        var cellClass = GetColumnCellClass(col.ColumnKey);
                                        <td class="@cellClass @(val > 0 ? "fw-bold" : "text-muted")">
                                            @(val > 0 ? val.ToString("N0") : "—")
                                        </td>
                                    }
                                </tr>
                            }

                            @* صف إجمالي الدائرة *@
                            var circSub = circGrp.SubTotal;
                            <tr class="circuit-subtotal-row">
                                <td colspan="4" class="text-start fw-bold ps-3">
                                    <span style="font-size:1rem;">📌</span> @circSub.SessionNameAr
                                </td>
                                <td colspan="2" class="text-muted fw-normal" style="font-size:0.85rem;">
                                    (مجموع جلسات الدائرة)
                                </td>
                                @foreach (var col in report.ActiveColumns)
                                {
                                    int val = GetRowVal(circSub, col.ColumnKey);
                                    var cellClass = GetColumnCellClass(col.ColumnKey);
                                    <td class="@cellClass fw-bold">
                                        @(val > 0 ? val.ToString("N0") : "0")
                                    </td>
                                }
                            </tr>
                        }

                        @* صف إجمالي المحكمة *@
                        var courtSub = courtGrp.SubTotal;
                        <tr class="court-subtotal-row">
                            <td colspan="4" class="text-start fw-bold ps-3" style="font-size:1.02rem;">
                                🏛️ @courtSub.SessionNameAr
                            </td>
                            <td colspan="2" class="text-muted fw-normal" style="font-size:0.85rem;">
                                (مجموع دوائر المحكمة)
                            </td>
                            @foreach (var col in report.ActiveColumns)
                            {
                                int val = GetRowVal(courtSub, col.ColumnKey);
                                var cellClass = GetColumnCellClass(col.ColumnKey);
                                <td class="@cellClass fw-bold" style="font-size:1.05rem;">
                                    @(val > 0 ? val.ToString("N0") : "0")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @* صف الإجمالي العام *@
                    @{
                        var gTotal = report.GrandTotal;
                    }
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-start ps-3 fw-bolder" style="font-size:1.1rem;color:#78350f;">
                            ★ @gTotal.SessionNameAr
                        </td>
                        @foreach (var col in report.ActiveColumns)
                        {
                            int val = GetRowVal(gTotal, col.ColumnKey);
                            var cellClass = GetColumnCellClass(col.ColumnKey);
                            <td class="@cellClass fw-bolder" style="font-size:1.15rem;">
                                @(val > 0 ? val.ToString("N0") : "0")
                            </td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else if (!isLoading)
    {
        <div class="empty-state text-center p-5 card shadow-sm">
            <span style="font-size:3rem;">📊</span>
            <h4 class="mt-3 text-muted">لم يتم استخراج التقرير بعد</h4>
            <p class="text-muted" style="max-width:500px;margin:auto;">
                حدد العام القضائي والفترة المراد استخراج الأحكام عنها، ثم اضغط على زر "عرض التقرير".
            </p>
        </div>
    }

</div>

@* ==================== أنماط التنسيق CSS ==================== *@
