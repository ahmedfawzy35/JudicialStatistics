                                    </td>
                                    <td>
                                        <input type="number" class="form-control" style="font-size:0.85rem;padding:0.25rem 0.5rem;width:85px" @bind="band.FromYear" disabled="@(band.BandKind != "Exact")" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control" style="font-size:0.85rem;padding:0.25rem 0.5rem;width:85px" @bind="band.ToYear" disabled="@(band.BandKind == "AllYears")" />
