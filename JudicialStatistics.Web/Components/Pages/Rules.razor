@page "/rules"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using JudicialStatistics.Application.Organization
@using JudicialStatistics.Application.Rules
@inject IRulesService RulesService
@inject IJudicialYearsService JudicialYearsService
@inject IOrganizationService OrgService

<PageTitle>قواعد التصنيف وجداول التهيئة — الإحصاء القضائي</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">⚙️ قواعد التصنيف وجداول التهيئة</h1>
        <p class="page-subtitle">شجرة تصنيف القضايا، أنواع القضايا، بنود الوارد، أنواع الأحكام، أسباب التأجيلات، والتخصصات القضائية</p>
    </div>
    <div class="page-actions">
        @if (activeTab == "casetypes")
        {
            <button class="btn btn-primary" @onclick="OpenAddCaseTypeModal">
                ➕ إضافة نوع قضية جديد
            </button>
        }
        else if (activeTab == "incoming")
        {
            <button class="btn btn-primary" @onclick="OpenAddIncomingModal">
                ➕ إضافة بند مقدم جديد
            </button>
        }
        else if (activeTab == "production")
        {
            <button class="btn btn-primary" @onclick="OpenAddProductionModal">
                ➕ إضافة بند إنتاج جديد
            </button>
        }
        else if (activeTab == "judgments")
        {
            <button class="btn btn-primary" @onclick="OpenAddJudgmentModal">
                ➕ إضافة نوع حكم قضائي
            </button>
        }
        else if (activeTab == "deferrals")
        {
            <button class="btn btn-primary" @onclick="OpenAddDeferralModal">
                ➕ إضافة سبب تأجيل جديد
            </button>
        }
        else if (activeTab == "disciplines")
        {
            <button class="btn btn-primary" @onclick="OpenAddDisciplineModal">
                ➕ إضافة تخصص قضائي جديد
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") mb-4">
        <span>@(isError ? "⚠️" : "✅") @statusMessage</span>
    </div>
}

<div class="tabs">
    <button class="tab @(activeTab == "casetypes" ? "active" : "")" @onclick='() => SetTab("casetypes")'>
        📚 أنواع القضايا (@(caseTypes?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "taxonomy" ? "active" : "")" @onclick='() => SetTab("taxonomy")'>
        🌳 شجرة التصنيف
    </button>
    <button class="tab @(activeTab == "incoming" ? "active" : "")" @onclick='() => SetTab("incoming")'>
        📥 بنود المقدم (الوارد) (@(incomingTypes?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "production" ? "active" : "")" @onclick='() => SetTab("production")'>
        📊 بنود الإنتاج (@(productionTypes?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "judgments" ? "active" : "")" @onclick='() => SetTab("judgments")'>
        ⚖️ تصنيفات وأنواع الأحكام (@(judgmentTypes?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "deferrals" ? "active" : "")" @onclick='() => SetTab("deferrals")'>
        ⏳ أسباب المؤجلات (@(deferralReasons?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "yearbands" ? "active" : "")" @onclick='() => SetTab("yearbands")'>
        📅 شرائح سنوات القيد (@(yearPolicies?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "disciplines" ? "active" : "")" @onclick='() => SetTab("disciplines")'>
        🏛️ التخصصات القضائية (@(disciplines?.Count ?? 0))
    </button>
</div>

@* ==================== TAB 1: أنواع القضايا ==================== *@
@if (activeTab == "casetypes")
{
    <div class="card">
        <div class="card-header">
            <span class="card-title">أنواع القضايا المعتمدة</span>
        </div>
        <div class="card-body" style="padding:0">
            @if (caseTypes is null)
            {
                <div style="padding:1.5rem" class="d-flex align-center gap-2"><div class="spinner"></div><span>جاري التحميل...</span></div>
            }
            else if (caseTypes.Count == 0)
            {
                <div style="padding:2rem;text-align:center;color:var(--text-muted)">
                    لا توجد أنواع قضايا مسجلة بعد.
                    <button class="btn btn-primary btn-sm mt-3" @onclick="OpenAddCaseTypeModal">إضافة النوع الأول</button>
                </div>
            }
            else
            {
                <div class="table-wrapper" style="border:none">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>كود النوع</th>
                                <th>اسم نوع القضية</th>
                                <th>فرع التصنيف</th>
                                <th>المستوى الإحصائي</th>
                                <th>نوع الإجراء</th>
                                <th>فئة العمر</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in caseTypes)
                            {
                                <tr>
                                    <td><code>@ct.Code</code></td>
                                    <td class="fw-semibold">@ct.NameAr</td>
                                    <td>@ct.TaxonomyNodeNameAr</td>
                                    <td><span class="badge badge-secondary">@ct.StatisticalLevelCode</span></td>
                                    <td>@ct.ProcedureCode</td>
                                    <td>@ct.AgeCategoryCode</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ==================== TAB 2: شجرة التصنيف ==================== *@
@if (activeTab == "taxonomy")
{
    <div class="card">
        <div class="card-header">
            <span class="card-title">هيكل شجرة تصنيف الدعاوى القضائية</span>
        </div>
        <div class="card-body">
            @if (taxonomyTree is null || taxonomyTree.Count == 0)
            {
                <div class="text-muted-color">شجرة التصنيف الافتراضية معتمدة وفقاً لقواعد وزارة العدل.</div>
            }
            else
            {
                @foreach (var node in taxonomyTree)
                {
                    <div style="margin-bottom:1rem;padding:1rem;background:var(--surface-bg);border-radius:var(--radius-md)">
                        <div class="fw-bold text-primary-color">@node.NameAr (@node.Code)</div>
                        @if (node.Children.Count > 0)
                        {
                            <div style="margin-right:1.5rem;margin-top:.5rem;display:flex;gap:.5rem;flex-wrap:wrap">
                                @foreach (var ch in node.Children)
                                {
                                    <span class="badge badge-secondary" style="font-size:.85rem;padding:.4rem .8rem">
                                        @ch.NameAr
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@* ==================== TAB 3: بنود المقدم (الوارد) ==================== *@
@if (activeTab == "incoming")
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-center">
            <span class="card-title">بنود المقدم (مصادر القضايا في الجلسة)</span>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddIncomingModal">➕ إضافة بند مقدم</button>
        </div>
        <div class="card-body" style="padding:0">
            <div class="table-wrapper" style="border:none">
                <table class="table">
                    <thead>
                        <tr>
                            <th>الكود</th>
                            <th>اسم البند</th>
                            <th>طريقة الإدخال</th>
                            <th>الترتيب</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (incomingTypes is not null)
                        {
                            @foreach (var it in incomingTypes)
                            {
                                <tr>
                                    <td><code>@it.Code</code></td>
                                    <td class="fw-semibold">@it.NameAr</td>
                                    <td><span class="badge badge-info">@it.InputSource</span></td>
                                    <td>@it.SortOrder</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditIncomingModal(it)">
                                            ✏️ تعديل
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ==================== TAB 4: بنود الإنتاج ==================== *@
@if (activeTab == "production")
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-center">
            <span class="card-title">بنود الإنتاج والأحكام والإجراءات</span>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddProductionModal">➕ إضافة بند إنتاج</button>
        </div>
        <div class="card-body" style="padding:0">
            <div class="table-wrapper" style="border:none">
                <table class="table">
                    <thead>
                        <tr>
                            <th>الكود</th>
                            <th>اسم البند</th>
                            <th>طبيعة البند</th>
                            <th>شاشة الإدخال</th>
                            <th>الترتيب</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (productionTypes is not null)
                        {
                            @foreach (var pt in productionTypes)
                            {
                                <tr>
                                    <td><code>@pt.Code</code></td>
                                    <td class="fw-semibold">@pt.NameAr</td>
                                    <td>
                                        <span class="badge @(pt.ItemKind == "Judgment" ? "badge-success" : "badge-warning")">
                                            @(pt.ItemKind == "Judgment" ? "حكم قضائي" : "تأجيل / إجراء")
                                        </span>
                                    </td>
                                    <td>@pt.EntryScreen</td>
                                    <td>@pt.SortOrder</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditProductionModal(pt)">
                                            ✏️ تعديل
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ==================== TAB 5: أنواع الأحكام ==================== *@
@if (activeTab == "judgments")
{
    <div class="card" style="margin-bottom:1.5rem">
        <div class="card-header">
            <span class="card-title">🌳 هيكل شجرة تصنيف الأحكام والإجراءات القضائية</span>
        </div>
        <div class="card-body">
            @if (judgmentTree is null || judgmentTree.Count == 0)
            {
                <div class="text-muted-color">جاري التحميل أو لا توجد عقد مسجلة.</div>
            }
            else
            {
                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:1rem">
                    @foreach (var node in judgmentTree)
                    {
                        <div style="padding:1rem;background:var(--surface-bg);border:1px solid var(--border-color);border-radius:var(--radius-md)">
                            <div class="fw-bold text-primary-color" style="margin-bottom:.5rem">
                                ⚖️ @node.NameAr <small class="text-muted">(@node.Code)</small>
                            </div>
                            @if (node.Children.Count > 0)
                            {
                                <div style="display:flex;gap:.4rem;flex-wrap:wrap">
                                    @foreach (var ch in node.Children)
                                    {
                                        <span class="badge badge-secondary" style="font-size:.85rem;padding:.35rem .7rem">
                                            @ch.NameAr
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:.85rem">تصنيف رئيسي مباشر</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-center">
            <span class="card-title">📜 جدول أنواع الأحكام القضائية المعتمدة (@(judgmentTypes?.Count ?? 0))</span>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddJudgmentModal">➕ إضافة نوع حكم جديد</button>
        </div>
        <div class="card-body" style="padding:0">
            <div class="table-wrapper" style="border:none">
                <table class="table">
                    <thead>
                        <tr>
                            <th>الكود</th>
                            <th>نوع الحكم القضائي</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (judgmentTypes is not null)
                        {
                            @foreach (var jt in judgmentTypes)
                            {
                                <tr>
                                    <td><code>@jt.Code</code></td>
                                    <td class="fw-semibold">@jt.NameAr</td>
                                    <td>
                                        <span class="badge @(jt.IsActive ? "badge-success" : "badge-secondary")">
                                            @(jt.IsActive ? "نشط ومفعّل" : "معطّل")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditJudgmentModal(jt)">
                                                ✏️ تعديل
                                            </button>
                                            <button class="btn btn-sm @(jt.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => ToggleJudgmentActive(jt.Id)">
                                                @(jt.IsActive ? "تعطيل" : "تفعيل")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ==================== TAB 6: أسباب المؤجلات ==================== *@
@if (activeTab == "deferrals")
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-center">
            <span class="card-title">أسباب المؤجلات المعتمدة</span>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddDeferralModal">➕ إضافة سبب تأجيل جديد</button>
        </div>
        <div class="card-body" style="padding:0">
            <div class="table-wrapper" style="border:none">
                <table class="table">
                    <thead>
                        <tr>
                            <th>الكود</th>
                            <th>سبب التأجيل</th>
                            <th>مصدر السبب</th>
                            <th>الترتيب</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (deferralReasons is not null)
                        {
                            @foreach (var dr in deferralReasons)
                            {
                                <tr>
                                    <td><code>@dr.Code</code></td>
                                    <td class="fw-semibold">@dr.NameAr</td>
                                    <td>@dr.SourceKind</td>
                                    <td>@dr.SortOrder</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditDeferralModal(dr)">
                                            ✏️ تعديل
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ==================== TAB 7: شرائح سنوات القيد ==================== *@
@if (activeTab == "yearbands")
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="card-title">📅 شرائح سنوات القيد للعام القضائي</span>
                <p class="text-secondary mb-0" style="font-size:0.85rem">
                    إدارة سنوات قيد القضايا المسجلة بالإحصائية وتعديلها سنوياً (مدني كلي: 5 سنوات قيد، أسرة وعمال: 3 سنوات، جنائي: سنة واحدة).
                </p>
            </div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <label class="fw-semibold" style="font-size:0.9rem">العام القضائي:</label>
                <select class="form-control" style="width:auto;display:inline-block" value="@selectedJudicialYearId" @onchange="OnYearPolicyYearChanged">
                    @if (judicialYears is not null)
                    {
                        @foreach (var y in judicialYears)
                        {
                            <option value="@y.Id">@y.NameAr</option>
                        }
                    }
                </select>
                <select class="form-control" style="width:auto;display:inline-block" @bind="selectedDisciplineFilter">
                    <option value="">كافة التخصصات</option>
                    <option value="CIV-FULL">مدني كلي</option>
                    <option value="FAM-">أسرة</option>
                    <option value="LABOR-">عمال</option>
                    <option value="CRIM-">جنائي</option>
                </select>
            </div>
        </div>
        <div class="card-body" style="padding:0">
            @if (yearPolicies is null)
            {
                <div style="padding:1.5rem" class="d-flex align-center gap-2"><div class="spinner"></div><span>جاري التحميل...</span></div>
            }
            else if (FilteredPolicies.Count == 0)
            {
                <div style="padding:2rem;text-align:center;color:var(--text-muted)">لا توجد سياسات مسجلة لهذا العام أو الفلتر.</div>
            }
            else
            {
                <div class="table-wrapper" style="border:none">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>نوع القضية</th>
                                <th>مرجع القرار</th>
                                <th>عدد الشرائح</th>
                                <th>الشرائح المعتمدة لسنة القيد</th>
                                <th>الحالة</th>
                                <th>إجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pol in FilteredPolicies)
                            {
                                <tr>
                                    <td class="fw-semibold">@pol.CaseTypeNameAr</td>
                                    <td style="font-size:0.85rem;color:var(--text-secondary)">@pol.DecisionReference</td>
                                    <td><span class="badge badge-info">@pol.Bands.Count شرائح</span></td>
                                    <td>
                                        <div class="d-flex gap-1 flex-wrap">
                                            @foreach (var b in pol.Bands.OrderBy(x => x.SortOrder))
                                            {
                                                <span class="badge badge-secondary" style="font-size:0.8rem">
                                                    @b.LabelAr
                                                    @if (b.BandKind == "UpTo")
                                                    {
                                                        <small class="text-muted">(حتى @b.ToYear)</small>
                                                    }
                                                    else if (b.BandKind == "Exact")
                                                    {
                                                        <small class="text-muted">(@b.ToYear)</small>
                                                    }
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td><span class="badge badge-success">@pol.Status</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditPolicyModal(pol)">
                                            ✏️ تعديل الشرائح
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ==================== TAB 8: التخصصات القضائية ==================== *@
@if (activeTab == "disciplines")
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-center">
            <div>
                <span class="card-title">🏛️ التخصصات القضائية الإحصائية المعتمدة</span>
                <p class="text-secondary mb-0" style="font-size:0.85rem">
                    إدارة وإضافة التخصصات القضائية (مثل المدني، الجنائي، الأسرة، العمال، الاقتصادية...) وأنواع الدوائر وشاشات الإدخال التابعة لها
                </p>
            </div>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddDisciplineModal">➕ إضافة تخصص قضائي جديد</button>
        </div>
        <div class="card-body" style="padding:0">
            @if (disciplines is null)
            {
                <div style="padding:1.5rem" class="d-flex align-center gap-2"><div class="spinner"></div><span>جاري التحميل...</span></div>
            }
            else if (disciplines.Count == 0)
            {
                <div style="padding:2rem;text-align:center;color:var(--text-muted)">
                    لا توجد تخصصات مسجلة.
                    <button class="btn btn-primary btn-sm mt-3" @onclick="OpenAddDisciplineModal">إضافة التخصص الأول</button>
                </div>
            }
            else
            {
                <div class="table-wrapper" style="border:none">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>الأيقونة</th>
                                <th>الكود</th>
                                <th>اسم التخصص</th>
                                <th>أنواع الدوائر التابعة</th>
                                <th>شكل نموذج الإدخال</th>
                                <th>الترتيب</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in disciplines)
                            {
                                <tr>
                                    <td style="font-size:1.3rem">@d.Icon</td>
                                    <td><code>@d.Code</code></td>
                                    <td class="fw-semibold">@d.NameAr</td>
                                    <td>
                                        @foreach (var k in d.CircuitKinds.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="badge badge-secondary" style="margin-left:4px">@k.Trim()</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(d.EntryFormKind == "Criminal" ? "badge-warning" : "badge-info")">
                                            @(d.EntryFormKind == "Criminal" ? "نموذج جنائي (جدول موحد)" : "نموذج مدني (متعدد التبويبات)")
                                        </span>
                                    </td>
                                    <td>@d.SortOrder</td>
                                    <td>
                                        <span class="badge @(d.IsActive ? "badge-success" : "badge-secondary")">
                                            @(d.IsActive ? "نشط ومفعّل" : "معطّل")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditDisciplineModal(d)">✏️ تعديل</button>
                                            <button class="btn btn-sm @(d.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => ToggleDisciplineActive(d.Id)">
                                                @(d.IsActive ? "تعطيل" : "تفعيل")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

