@code {
    private string activeTab = "casetypes";
    private List<CaseTypeDto>? caseTypes;
    private List<CaseTaxonomyNodeDto>? taxonomyTree;
    private List<IncomingTypeDto>? incomingTypes;
    private List<ProductionItemTypeDto>? productionTypes;
    private List<JudgmentTypeDto>? judgmentTypes;
    private List<JudgmentTreeNodeDto>? judgmentTree;
    private List<DeferralReasonDto>? deferralReasons;
    private List<StatisticalDisciplineDto>? disciplines;

    private List<JudicialYearDto>? judicialYears;
    private long selectedJudicialYearId;
    private List<CaseYearPolicyDto>? yearPolicies;
    private string selectedDisciplineFilter = "";

    // Policy Modal
    private bool showEditPolicyModal = false;
    private CaseYearPolicyDto? editingPolicy;
    private List<CaseYearBandEditModel> editingBands = new();

    // CaseType Modal
    private bool showAddCaseTypeModal = false;
    private CaseTypeFormModel caseTypeModel = new();

    // Judgment Modal
    private bool showJudgmentModal = false;
    private JudgmentFormModel judgmentFormModel = new();

    // Deferral Modal
    private bool showDeferralModal = false;
    private DeferralFormModel deferralFormModel = new();

    // Incoming Modal
    private bool showIncomingModal = false;
    private IncomingFormModel incomingFormModel = new();

    // Production Modal
    private bool showProductionModal = false;
    private ProductionFormModel productionFormModel = new();

    // Discipline Modal
    private bool showDisciplineModal = false;
    private DisciplineFormModel disciplineFormModel = new();

    private bool isSubmitting = false;
    private string? statusMessage;
    private bool isError = false;

    private List<CaseYearPolicyDto> FilteredPolicies
    {
        get
        {
            if (yearPolicies is null) return new();
            if (string.IsNullOrWhiteSpace(selectedDisciplineFilter)) return yearPolicies;
            return yearPolicies.Where(p =>
            {
                var ct = caseTypes?.FirstOrDefault(c => c.Id == p.CaseTypeId);
                return ct != null && ct.Code.StartsWith(selectedDisciplineFilter);
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        caseTypes = await RulesService.GetCaseTypesAsync();
        taxonomyTree = await RulesService.GetTaxonomyTreeAsync();
        incomingTypes = await RulesService.GetIncomingTypesAsync();
        productionTypes = await RulesService.GetProductionItemTypesAsync();
        judgmentTypes = await RulesService.GetJudgmentTypesAsync(true);
        judgmentTree = await RulesService.GetJudgmentTreeAsync();
        deferralReasons = await RulesService.GetDeferralReasonsAsync();
        disciplines = await OrgService.GetDisciplinesAsync(false);

        judicialYears = await JudicialYearsService.GetYearsAsync();
        var activeYear = judicialYears.FirstOrDefault(y => y.Status == "Active") ?? judicialYears.FirstOrDefault();
        if (activeYear != null)
        {
            selectedJudicialYearId = activeYear.Id;
            yearPolicies = await RulesService.GetPoliciesForYearAsync(selectedJudicialYearId);
        }
    }

    private void SetTab(string tab) => activeTab = tab;

    private async Task OnYearPolicyYearChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var yId))
        {
            selectedJudicialYearId = yId;
            yearPolicies = await RulesService.GetPoliciesForYearAsync(selectedJudicialYearId);
        }
    }

    // ========== CaseType Modal Handlers ==========

    private void OpenAddCaseTypeModal()
    {
        caseTypeModel = new CaseTypeFormModel();
        showAddCaseTypeModal = true;
    }

    private void CloseAddCaseTypeModal() => showAddCaseTypeModal = false;

    private async Task HandleCreateCaseType()
    {
        try
        {
            isSubmitting = true;
            statusMessage = null;

            await RulesService.CreateCaseTypeAsync(new CaseTypeCreateCommand(
                1,
                caseTypeModel.Code,
                caseTypeModel.NameAr,
                caseTypeModel.StatisticalLevelCode,
                caseTypeModel.ProcedureCode,
                "All"
            ));

            statusMessage = $"تمت إضافة نوع القضية '{caseTypeModel.NameAr}' بنجاح.";
            isError = false;
            CloseAddCaseTypeModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally { isSubmitting = false; }
    }

    // ========== Policy Modal Handlers ==========

    private void OpenEditPolicyModal(CaseYearPolicyDto pol)
    {
        editingPolicy = pol;
        editingBands = pol.Bands.OrderBy(b => b.SortOrder).Select(b => new CaseYearBandEditModel
        {
            Id = b.Id,
            BandKind = b.BandKind,
            LabelAr = b.LabelAr,
            FromYear = b.FromYear,
            ToYear = b.ToYear,
            SortOrder = b.SortOrder
        }).ToList();
        showEditPolicyModal = true;
    }

    private void CloseEditPolicyModal()
    {
        showEditPolicyModal = false;
        editingPolicy = null;
        editingBands.Clear();
    }

    private void AddBandRow()
    {
        short nextOrder = (short)(editingBands.Count + 1);
        editingBands.Add(new CaseYearBandEditModel
        {
            BandKind = "Exact",
            LabelAr = "سنة جديدة",
            SortOrder = nextOrder
        });
    }

    private void RemoveBandRow(CaseYearBandEditModel band)
    {
        if (editingBands.Count > 1)
        {
            editingBands.Remove(band);
        }
    }

    private async Task HandleSavePolicyBands()
    {
        if (editingPolicy is null) return;
        try
        {
            isSubmitting = true;
            statusMessage = null;

            var dtoList = editingBands.Select((b, idx) => new CaseYearBandDto(
                b.Id,
                editingPolicy.Id,
                b.FromYear,
                b.ToYear,
                b.BandKind,
                b.LabelAr.Trim(),
                (short)(idx + 1)
            )).ToList();

            await RulesService.UpdateCaseYearBandsAsync(editingPolicy.Id, dtoList);
            statusMessage = $"تم حفظ وتحديث شرائح سنوات القيد لـ '{editingPolicy.CaseTypeNameAr}' بنجاح.";
            isError = false;
            CloseEditPolicyModal();
