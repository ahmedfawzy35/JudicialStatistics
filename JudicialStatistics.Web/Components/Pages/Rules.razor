                        <thead>
                            <tr>
                                <th>#</th>
                                <th>المسمى (العنوان)</th>
                                <th>النوع</th>
                                <th>من سنة</th>
                                <th>إلى سنة</th>
                                <th>حذف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int idx = 0; idx < editingBands.Count; idx++)
                            {
                                var band = editingBands[idx];
                                <tr>
                                    <td>@(idx + 1)</td>
                                    <td>
                                        <input class="form-control" style="font-size:0.85rem;padding:0.25rem 0.5rem" @bind="band.LabelAr" placeholder="مثال: 2022 وما قبلها" />
                                    </td>
