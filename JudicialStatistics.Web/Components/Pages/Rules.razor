                                        <select class="form-control" style="font-size:0.85rem;padding:0.25rem 0.5rem" @bind="band.BandKind">
                                            <option value="UpTo">وما قبلها (UpTo)</option>
                                            <option value="Exact">سنة محددة (Exact)</option>
                                            <option value="AllYears">السنة الإحصائية (AllYears)</option>
