            isLoading = false;
        }
    }

    private List<long> GetSelectedPeriodIds()
    {
        if (periods is null || periods.Count == 0) return [];

        if (periodSelectionMode == "single")
        {
            var pid = selectedPeriodId ?? periods.First().Id;
            return [pid];
        }
        else if (periodSelectionMode == "range")
        {
            var startIdx = rangeStartPeriodId.HasValue ? periods.FindIndex(p => p.Id == rangeStartPeriodId.Value) : 0;
            var endIdx = rangeEndPeriodId.HasValue ? periods.FindIndex(p => p.Id == rangeEndPeriodId.Value) : periods.Count - 1;
            if (startIdx < 0) startIdx = 0;
            if (endIdx < 0) endIdx = periods.Count - 1;
            if (startIdx > endIdx) (startIdx, endIdx) = (endIdx, startIdx);
            return periods.Skip(startIdx).Take(endIdx - startIdx + 1).Select(p => p.Id).ToList();
        }
        else // all
        {
            return periods.Select(p => p.Id).ToList();
        }
    }

    private async Task ExportToExcelAsync()
    {
        if (!selectedYearId.HasValue || periods is null || periods.Count == 0) return;

        isExporting = true;
        exportMessage = null;
        try
        {
            var targetPeriodIds = GetSelectedPeriodIds();
            var filter = new CircuitRankingFilter(
                selectedYearId.Value,
                targetPeriodIds,
                selectedReportType,
                selectedCourtId,
                deductSuspendedInMisdemeanors
            );

            var fileBytes = await ReportsService.ExportCircuitRankingToExcelAsync(filter);
            var fileName = $"تقرير_ترتيب_{selectedReportType}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            var base64 = Convert.ToBase64String(fileBytes);
            await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            exportMessage = "تم تصدير ملف الإكسل بنجاح وحفظه على جهازك.";
        }
        catch (Exception ex)
        {
            exportMessage = "فشل تصدير ملف الإكسل: " + ex.Message;
        }
        finally
        {
            isExporting = false;
        }
    }

