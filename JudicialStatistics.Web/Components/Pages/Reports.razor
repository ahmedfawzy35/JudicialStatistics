@code {
    private string activeTab = "rankings";
    private bool isLoading = true;
    private bool isRankingLoading = false;
    private bool isInventoryLoading = false;
    private bool isJudgeSessionsLoading = false;
    private bool isExporting = false;
    private string? exportMessage;

    private List<JudicialYearDto>? years;
    private List<StatisticalPeriodDto>? periods;
    private List<CourtUnitDto>? courts;
    private List<JudgeDto>? judgesList;

    private long? selectedYearId;
    private long? selectedPeriodId;
    private long? selectedCourtId;

    // كشف الترتيب القضائي
    private string selectedReportType = "CivilFull";
    private string periodSelectionMode = "single"; // single | range | all
    private long? rangeStartPeriodId;
    private long? rangeEndPeriodId;
    private bool deductSuspendedInMisdemeanors = true;

    // كشف الجرد الشهري
    private long? selectedBasePeriodId;
    private MonthlyInventoryReportDto? inventoryReport;

    // كشف أحكام وإنجاز قاضٍ محدد بالجلسات
    private long? selectedJudgeId;
    private long? selectedJudgeCourtId;
    private long? selectedJudgeCircuitId;
    private string judgeSearchQuery = string.Empty;
    private bool showFinalBreakdown = false;
    private List<CircuitDto>? judgeCircuits;
    private List<CircuitJudgeAssignmentDto>? yearAssignments;
    private JudgeSessionJudgmentsReportDto? judgeSessionsReport;

    private CircuitRankingReportDto? rankingReport;
    private PeriodReportSummaryDto? periodReport;
    private AnnualReportSummaryDto? annualReport;
    private List<JudgePerformanceDto>? judgesPerformance;

    protected override async Task OnInitializedAsync()
    {
        years = await YearsService.GetYearsAsync();
        courts = await CourtsService.GetFlatAsync(true);
        judgesList = await OrgService.GetJudgesAsync(activeOnly: true);

        if (years.Count > 0)
        {
            var active = years.FirstOrDefault(y => y.Status == "Active") ?? years.First();
            selectedYearId = active.Id;
            periods = await YearsService.GetPeriodsForYearAsync(selectedYearId.Value);
            judgeCircuits = await OrgService.GetCircuitsAsync(selectedYearId.Value);
            yearAssignments = await OrgService.GetAssignmentsForYearAsync(selectedYearId.Value);

            if (periods.Count > 0)
            {
                selectedPeriodId = periods.First().Id;
                selectedBasePeriodId = periods.First().Id;
                rangeStartPeriodId = periods.First().Id;
                rangeEndPeriodId = periods.Last().Id;
            }

            await LoadDataAsync();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task SetTab(string tab)
    {
        activeTab = (tab == "judges") ? "judge_sessions" : tab;
        exportMessage = null;
        if (activeTab == "judge_sessions")
        {
            periodSelectionMode = "range";
        }
        await LoadDataAsync();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var yId))
        {
            selectedYearId = yId;
            periods = await YearsService.GetPeriodsForYearAsync(yId);
            judgeCircuits = await OrgService.GetCircuitsAsync(yId, selectedJudgeCourtId);
            yearAssignments = await OrgService.GetAssignmentsForYearAsync(yId);
            if (periods.Count > 0)
            {
                selectedPeriodId = periods.First().Id;
                selectedBasePeriodId = periods.First().Id;
                rangeStartPeriodId = periods.First().Id;
                rangeEndPeriodId = periods.Last().Id;
            }
            await LoadDataAsync();
        }
    }

    private async Task OnJudgeCourtChanged(ChangeEventArgs e)
    {
        selectedJudgeCourtId = long.TryParse(e.Value?.ToString(), out var cId) ? cId : null;
        selectedJudgeCircuitId = null;
        if (selectedYearId.HasValue)
        {
            judgeCircuits = await OrgService.GetCircuitsAsync(selectedYearId.Value, selectedJudgeCourtId);
        }
        var filtered = GetFilteredJudges().ToList();
        if (selectedJudgeId.HasValue && !filtered.Any(j => j.Id == selectedJudgeId.Value))
        {
            selectedJudgeId = null;
        }
        await LoadJudgeSessionsReportAsync();
    }

    private async Task OnJudgeCircuitChanged(ChangeEventArgs e)
    {
        selectedJudgeCircuitId = long.TryParse(e.Value?.ToString(), out var cId) ? cId : null;
        var filtered = GetFilteredJudges().ToList();
        if (selectedJudgeId.HasValue && !filtered.Any(j => j.Id == selectedJudgeId.Value))
        {
            selectedJudgeId = null;
        }
        else if (!selectedJudgeId.HasValue && filtered.Count == 1)
        {
            selectedJudgeId = filtered.First().Id;
        }
        await LoadJudgeSessionsReportAsync();
    }

    private IEnumerable<JudgeDto> GetFilteredJudges()
    {
        if (judgesList is null) return Enumerable.Empty<JudgeDto>();

        var query = judgesList.AsEnumerable();

        if (selectedJudgeCircuitId.HasValue && yearAssignments is not null)
        {
            var judgeIdsInCircuit = yearAssignments
                .Where(a => a.CircuitId == selectedJudgeCircuitId.Value)
                .Select(a => a.JudgeId)
                .ToHashSet();

            query = query.Where(j => judgeIdsInCircuit.Contains(j.Id));
        }
        else if (selectedJudgeCourtId.HasValue && judgeCircuits is not null && yearAssignments is not null)
        {
            var circuitIdsInCourt = judgeCircuits
                .Where(c => c.CourtUnitId == selectedJudgeCourtId.Value)
                .Select(c => c.Id)
                .ToHashSet();

            var judgeIdsInCourt = yearAssignments
                .Where(a => circuitIdsInCourt.Contains(a.CircuitId))
                .Select(a => a.JudgeId)
                .ToHashSet();

            query = query.Where(j => judgeIdsInCourt.Contains(j.Id) || j.CreatedCourtUnitId == selectedJudgeCourtId.Value);
        }

        if (!string.IsNullOrWhiteSpace(judgeSearchQuery))
        {
            var q = judgeSearchQuery.Trim();
            query = query.Where(j => j.FullNameAr.Contains(q, StringComparison.OrdinalIgnoreCase) || j.Code.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        return query;
    }

    private async Task SelectJudge(long judgeId)
    {
        selectedJudgeId = judgeId;
        await LoadJudgeSessionsReportAsync();
    }

    private async Task OnBasePeriodChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var pId))
        {
            selectedBasePeriodId = pId;
            await LoadMonthlyInventoryReportAsync();
        }
    }

    private async Task OnJudgeChanged(ChangeEventArgs e)
    {
        selectedJudgeId = long.TryParse(e.Value?.ToString(), out var jId) ? jId : null;
        await LoadJudgeSessionsReportAsync();
    }

    private async Task OnReportTypeChanged(ChangeEventArgs e)
    {
        selectedReportType = e.Value?.ToString() ?? "CivilFull";
        await LoadRankingReportAsync();
    }

    private async Task OnPeriodModeChanged(ChangeEventArgs e)
    {
        periodSelectionMode = e.Value?.ToString() ?? "single";
        if (activeTab == "judge_sessions")
            await LoadJudgeSessionsReportAsync();
        else
            await LoadRankingReportAsync();
    }

    private async Task OnSinglePeriodChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var pId))
        {
            selectedPeriodId = pId;
            if (activeTab == "judge_sessions")
                await LoadJudgeSessionsReportAsync();
            else
                await LoadRankingReportAsync();
        }
    }

    private async Task OnRangeStartChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var pId))
        {
            rangeStartPeriodId = pId;
            if (activeTab == "judge_sessions")
                await LoadJudgeSessionsReportAsync();
            else
                await LoadRankingReportAsync();
        }
    }

    private async Task OnRangeEndChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var pId))
        {
            rangeEndPeriodId = pId;
            if (activeTab == "judge_sessions")
                await LoadJudgeSessionsReportAsync();
            else
                await LoadRankingReportAsync();
        }
    }

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        selectedPeriodId = long.TryParse(e.Value?.ToString(), out var pId) ? pId : null;
        await LoadGeneralReportsAsync();
    }

    private async Task OnCourtChanged(ChangeEventArgs e)
    {
        selectedCourtId = long.TryParse(e.Value?.ToString(), out var cId) ? cId : null;
        await LoadDataAsync();
    }

    private async Task ToggleDeductSuspended()
    {
        deductSuspendedInMisdemeanors = !deductSuspendedInMisdemeanors;
        await LoadRankingReportAsync();
    }

    private async Task LoadDataAsync()
    {
        if (activeTab == "rankings")
        {
            await LoadRankingReportAsync();
        }
        else if (activeTab == "inventory")
        {
            await LoadMonthlyInventoryReportAsync();
        }
        else if (activeTab == "judge_sessions")
        {
            await LoadJudgeSessionsReportAsync();
        }
        else
        {
            await LoadGeneralReportsAsync();
        }
    }

    private async Task LoadRankingReportAsync()
    {
        if (!selectedYearId.HasValue || periods is null || periods.Count == 0) return;

        isRankingLoading = true;
        try
        {
            var targetPeriodIds = GetSelectedPeriodIds();
            var filter = new CircuitRankingFilter(
                selectedYearId.Value,
                targetPeriodIds,
                selectedReportType,
                selectedCourtId,
                deductSuspendedInMisdemeanors
            );

            rankingReport = await ReportsService.GetCircuitRankingReportAsync(filter);
        }
        catch (Exception ex)
        {
            exportMessage = "حدث خطأ أثناء تحميل كشف الترتيب: " + ex.Message;
        }
        finally
        {
            isRankingLoading = false;
            isLoading = false;
        }
    }

    private async Task LoadMonthlyInventoryReportAsync()
    {
        if (!selectedYearId.HasValue || !selectedBasePeriodId.HasValue) return;

        isInventoryLoading = true;
        try
        {
            var filter = new MonthlyInventoryFilter(
                selectedYearId.Value,
                selectedBasePeriodId.Value,
                selectedCourtId
            );
            inventoryReport = await ReportsService.GetMonthlyInventoryReportAsync(filter);
        }
        catch (Exception ex)
        {
            exportMessage = "حدث خطأ أثناء تحميل كشف الجرد الشهري: " + ex.Message;
        }
        finally
        {
            isInventoryLoading = false;
            isLoading = false;
        }
    }

