@code {
    private bool isLoading = true;
    private bool isFullScreen = false;
    private long selectedYearId = 0;
    private long selectedPeriodId = 0;
    private long selectedCourtId = 0;
    private string searchTerm = string.Empty;
    private string statusFilter = "All"; // All | Balanced | Unbalanced | NotEntered

    private List<JudicialYearDto>? years;
    private List<StatisticalPeriodDto>? periods;
    private List<CourtUnitDto>? courts;
    private StatisticsEntryProgressReportDto? report;

    protected override async Task OnInitializedAsync()
    {
        await LoadFiltersDataAsync();
        await LoadReportAsync();
    }

    private async Task LoadFiltersDataAsync()
    {
        years = await YearsService.GetYearsAsync();
        courts = await CourtsService.GetFlatAsync();

        if (years.Count > 0 && selectedYearId == 0)
        {
            var active = years.FirstOrDefault(y => y.Status == "Active") ?? years.First();
            selectedYearId = active.Id;
        }

        if (selectedYearId > 0)
        {
            periods = await YearsService.GetPeriodsForYearAsync(selectedYearId);
            if (periods.Count > 0 && selectedPeriodId == 0)
            {
                // اختيار الشهر الحالي أو الأول
                var today = DateOnly.FromDateTime(DateTime.Today);
                var currentPeriod = periods.FirstOrDefault(p => p.MonthStartDate.Year == today.Year && p.MonthStartDate.Month == today.Month)
                                   ?? periods.First();
                selectedPeriodId = currentPeriod.Id;
            }
        }
    }

    private async Task LoadReportAsync()
    {
        if (selectedYearId == 0 || selectedPeriodId == 0)
        {
            isLoading = false;
            return;
        }

        try
        {
            isLoading = true;
            report = await ReportsService.GetStatisticsEntryProgressReportAsync(
                selectedYearId,
                selectedPeriodId,
                selectedCourtId > 0 ? selectedCourtId : null
            );
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var yearId) && yearId > 0)
        {
            selectedYearId = yearId;
            periods = await YearsService.GetPeriodsForYearAsync(yearId);
            selectedPeriodId = periods.FirstOrDefault()?.Id ?? 0;
            await LoadReportAsync();
        }
    }

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var pId) && pId > 0)
        {
            selectedPeriodId = pId;
            await LoadReportAsync();
        }
    }

    private async Task OnCourtFilterChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var cId))
        {
            selectedCourtId = cId;
            await LoadReportAsync();
        }
    }

    private async Task SelectCourtFilter(long courtId)
    {
        if (selectedCourtId == courtId)
        {
            selectedCourtId = 0; // إلغاء التحديد
        }
        else
        {
            selectedCourtId = courtId;
        }
        await LoadReportAsync();
    }

    private void SetStatusFilter(string filter)
    {
        statusFilter = filter;
    }

    private void ToggleFullScreen()
    {
        isFullScreen = !isFullScreen;
    }

    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private List<DisciplineEntryGroupDto> GetFilteredDisciplineGroups()
    {
        if (report is null) return [];
        return report.DisciplineGroups;
    }

    private List<SessionEntryStatusDto> GetFilteredSessions(List<SessionEntryStatusDto> sessions)
    {
        var result = sessions.AsEnumerable();

        // 1. تصفية الحالة
        result = statusFilter switch
        {
            "Balanced" => result.Where(s => s.State == SessionEntryState.EnteredBalanced),
            "Unbalanced" => result.Where(s => s.State == SessionEntryState.EnteredUnbalanced),
            "NotEntered" => result.Where(s => s.State == SessionEntryState.NotEntered),
            _ => result
        };

        // 2. البحث النصي
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            result = result.Where(s =>
                s.SessionNameAr.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.CircuitNameAr.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.CourtUnitNameAr.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.CircuitCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.JudgesNames.Any(j => j.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        return result.ToList();
    }

    private static string GetRowHighlightClass(SessionEntryStatusDto s) => s.State switch
    {
        SessionEntryState.EnteredBalanced => "row-balanced",
        SessionEntryState.EnteredUnbalanced => "row-unbalanced",
        _ => "row-not-entered"
    };

    private static string GetRateColor(double rate) => rate switch
    {
        >= 90 => "#16a34a",
        >= 70 => "#0284c7",
        >= 40 => "#d97706",
        _ => "#dc2626"
    };
}
