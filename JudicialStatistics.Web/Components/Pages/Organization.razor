                    </div>

                    @* تعديل النطاقات الجغرافية والاختصاص المكاني (تغطية نطاق أو أكثر) *@
                    <div class="form-group mb-3">
                        <div class="d-flex justify-between align-center mb-1">
                            <label class="form-label fw-bold mb-0" style="color:var(--brand-primary)">
                                📍 الاختصاص المكاني والنطاقات الجغرافية للجلسة: <span class="required">*</span>
                            </label>
                            <span class="badge @(editingSessionModel.SelectedGeographicAreaIds.Count > 0 ? "badge-primary" : "badge-warning")" style="font-size:0.75rem">
                                @(editingSessionModel.SelectedGeographicAreaIds.Count > 0 ? $"تم اختيار {editingSessionModel.SelectedGeographicAreaIds.Count} نطاق" : "لم يتم الاختيار بعد")
                            </span>
                        </div>
                        <div class="text-secondary mb-2" style="font-size:0.8rem">
