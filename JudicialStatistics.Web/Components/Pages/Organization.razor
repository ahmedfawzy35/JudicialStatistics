                            {
                                <span class="badge badge-secondary">لم يُحدد سكرتير</span>
                            }
                        </label>

                        @if (editingSessionModel.EmployeeId.HasValue && !isSearchingSecretaryInEdit)
                        {
                            <div class="d-flex align-center justify-between p-2 rounded border bg-white shadow-sm">
                                <div class="d-flex align-center gap-2">
                                    <span style="font-size:1.4rem">👨‍💼</span>
                                    <div>
                                        <strong class="text-primary" style="font-size:0.95rem">@editingSessionModel.SelectedEmployeeName</strong>
                                        <div class="text-secondary" style="font-size:0.8rem">@(editingSessionModel.SelectedEmployeeJobTitle ?? "أمين سر الجلسة")</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartChangeSecretaryInEdit" title="تبديل واختيار سكرتير آخر">
                                        🔄 تبديل
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveSecretaryFromEdit" title="حذف الربط">
                                        🗑️ حذف
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <div class="d-flex gap-2 mb-2">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="🔍 ابحث عن الموظف بالاسم أو الكود..."
                                           @bind="editSessionSecretarySearchTerm" @bind:event="oninput" />
                                    @if (editingSessionModel.EmployeeId.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => isSearchingSecretaryInEdit = false">
                                            إلغاء التبديل
                                        </button>
                                    }
                                </div>

                                <div class="border rounded bg-white" style="max-height:160px; overflow-y:auto;">
                                    @{
                                        var matchingEmps = GetFilteredSecretaries(editSessionSecretarySearchTerm).ToList();
                                    }
                                    @if (matchingEmps.Count == 0)
                                    {
                                        <div class="text-muted text-center p-2" style="font-size:0.85rem">
                                            @(string.IsNullOrWhiteSpace(editSessionSecretarySearchTerm) ? "اكتب اسم الموظف أو الكود للبحث..." : "لا يوجد موظف مطابق للبحث")
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var emp in matchingEmps)
                                        {
                                            <div class="d-flex align-center justify-between p-2 border-bottom hover-bg"
                                                 style="cursor:pointer;"
                                                 @onclick="() => SelectSecretaryForEdit(emp)">
                                                <div>
                                                    <span class="badge bg-secondary font-monospace me-1">@emp.Code</span>
                                                    <strong>@emp.FullNameAr</strong>
                                                    <span class="text-muted ms-1" style="font-size:0.8rem">(@(emp.JobTitle ?? "أمين سر"))</span>
                                                    @if (!string.IsNullOrEmpty(emp.CourtUnitNameAr))
                                                    {
                                                        <span class="text-secondary ms-2" style="font-size:0.75rem">— @emp.CourtUnitNameAr</span>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-xs btn-primary">
                                                    اختيار ➕
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">إلغاء</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">حفظ التعديلات</button>
                </div>
            </EditForm>
        </div>
    </div>
}

