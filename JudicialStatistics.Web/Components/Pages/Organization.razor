    private async Task HandleCreateCircuit()
    {
        try
        {
            isSubmitting = true;
            statusMessage = null;

            if (string.IsNullOrWhiteSpace(circuitModel.Code))
            {
                AutoGenerateCircuitCode();
            }
            if (string.IsNullOrWhiteSpace(circuitModel.NameAr))
            {
                AutoSuggestCircuitName();
            }

            // Strict Validation Rules طبقاً للفلسفة المعتمدة
            var allowedKinds = GetAllowedCircuitKindsForCourt(circuitModel.CourtUnitId).Select(k => k.Value).ToList();
            if (!allowedKinds.Contains(circuitModel.CircuitKind))
            {
                throw new InvalidOperationException("قاعدة نظام صارمة: نوع الدائرة المختار غير مسموح به لهذه المحكمة/المأمورية طبقاً لقواعد العمل المعتمدة.");
            }

            var y = years?.FirstOrDefault(x => x.Id == selectedYearId);
            var start = y?.StartDate ?? new DateOnly(2025, 10, 1);
            var end = y?.EndDate ?? new DateOnly(2026, 9, 30);

            short minJudges = (short)(circuitModel.CircuitKind == "Partial" ? 1 : 3);
            short maxJudges = (short)(circuitModel.CircuitKind == "Partial" ? 1 : 4);

            await OrgService.CreateCircuitAsync(new CircuitCreateCommand(
                selectedYearId,
                circuitModel.CourtUnitId,
                circuitModel.Code,
                circuitModel.NameAr,
                circuitModel.CircuitKind,
                start,
                end,
                minJudges,
                maxJudges
            ));

            statusMessage = $"تمت إضافة الدائرة '{circuitModel.NameAr}' بنجاح.";
            isError = false;
            CloseModals();
            await LoadYearDataAsync(selectedYearId);
            await LoadCourtsCascadeAsync();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally { isSubmitting = false; }
    }

