    private IEnumerable<EmployeeDto> GetFilteredSecretaries(string term)
    {
        if (employeesList == null) return Enumerable.Empty<EmployeeDto>();
        var q = employeesList.Where(e => e.IsActive);
        if (!string.IsNullOrWhiteSpace(term))
        {
            var t = term.Trim();
            q = q.Where(e => e.FullNameAr.Contains(t, StringComparison.OrdinalIgnoreCase)
                          || e.Code.Contains(t, StringComparison.OrdinalIgnoreCase)
                          || (e.NationalId != null && e.NationalId.Contains(t)));
        }
        return q.Take(10);
    }

