                    </div>

                    <div class="form-group mb-3 p-2 border rounded" style="background:var(--surface-hover);">
                        <div class="d-flex align-center gap-2">
                            <input type="checkbox" id="editSessionShowProgress" @bind="editingSessionModel.ShowInProgressReport" style="width:18px;height:18px;cursor:pointer" />
                            <label for="editSessionShowProgress" class="m-0 fw-semibold" style="cursor:pointer">
                                📊 ظهور الجلسة في كشف ونسبة إدخال الإحصائية الشهرية
                            </label>
                        </div>
                        <div class="text-secondary mt-1" style="font-size:0.75rem">
                            تظهر كافة الجلسات افتراضياً في تقرير نسبة الإدخال، عدا الجلسات الجنائية المستثناة كالعنف والبيئة والمرور والأمن... إلخ.
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">حالة الجلسة</label>
                        <div class="d-flex align-center gap-2">
                            <input type="checkbox" id="editSessionActive" checked="@(!editingSessionModel.IsClosed)"
                                   @onchange="(e) => editingSessionModel.IsClosed = !(bool)(e.Value ?? true)"
