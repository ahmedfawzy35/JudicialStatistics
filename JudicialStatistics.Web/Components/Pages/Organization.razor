@* ==================== مودال تكليف قاضٍ بدائرة ==================== *@
@if (showAssignJudgeModal)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal" style="max-width: 620px;" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">➕ تكليف قاضٍ بدائرة قضائية</span>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <EditForm Model="assignModel" OnValidSubmit="HandleAssignJudge">
                <div class="modal-body">
                    @* 1. فلترة الدوائر بالمحكمة *@
                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> المحكمة أو المأمورية</label>
                        <select class="form-control" value="@assignCourtId" @onchange="OnAssignCourtChanged">
                            @if (courts is not null)
                            {
                                @foreach (var c in courts)
                                {
                                    <option value="@c.Id">@c.NameAr</option>
                                }
                            }
                        </select>
                    </div>

                    @* 2. اختيار الدائرة القضائية *@
                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> الدائرة القضائية</label>
                        <select class="form-control" value="@assignModel.CircuitId" @onchange="OnAssignCircuitChanged">
                            @foreach (var c in availableCircuitsForAssignModal)
                            {
                                <option value="@c.Id">@c.NameAr (@c.Code) - @GetCircuitLevelShortName(c.CircuitKind)</option>
                            }
                        </select>
                    </div>

                    @* 3. البحث باسم القاضي نظراً لكثرة الأسماء *@
                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> اختيار القاضي المكلف</label>
                        <input type="text" class="form-control form-control-sm mb-1"
                               placeholder="🔍 اكتب اسم القاضي للتصفية الفورية..."
                               @bind="assignJudgeSearchTerm" @bind:event="oninput" />
                        <InputSelect class="form-control" @bind-Value="assignModel.JudgeId" required>
                            <option value="">-- اختر القاضي من القائمة --</option>
                            @foreach (var j in filteredAssignJudges)
                            {
                                <option value="@j.Id">@j.FullNameAr (@j.Code)</option>
                            }
                        </InputSelect>
                    </div>

                    @* 4. الصفة القضائية مقيدة بنصاب الدائرة *@
                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> الصفة القضائية بالتشكيل</label>
                        <InputSelect class="form-control" @bind-Value="assignModel.JudicialRoleId" required>
                            @foreach (var r in allowedJudicialRolesForSelectedCircuit)
                            {
                                <option value="@r.Id">@r.NameAr</option>
                            }
                        </InputSelect>
                        <small class="text-secondary">
                            @if (isSelectedCircuitPartial)
                            {
                                <span>⚠️ دائرة جزئية فردية: الصفة المتاحة نظامياً هي (رئيس الدائرة) فقط.</span>
                            }
                            else
                            {
                                <span>تشكيل كلي (3 قضاة فأكثر): متاح رئيس الدائرة والأعضاء اليمين واليسار حتى العضو السادس.</span>
                            }
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">إلغاء</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">حفظ التكليف</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ==================== مودال الرصيد الافتتاحي للجلسة (أول العام القضائي) ==================== *@
@if (showSessionOpeningBalanceModal && selectedSessionForOpeningBalance is not null)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal modal-lg" @onclick:stopPropagation style="max-width: 820px; max-height: 90vh; display: flex; flex-direction: column;">
            <div class="modal-header">
                <div>
                    <span class="modal-title">💰 الرصيد الافتتاحي للجلسة أول العام القضائي</span>
                    <span class="text-secondary" style="font-size:0.85rem;display:block">
                        الجلسة: <strong>@selectedSessionForOpeningBalance.NameAr</strong> — الدائرة: <strong>@selectedSessionForOpeningBalance.CircuitNameAr</strong>
                    </span>
                </div>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            
            <div class="modal-body" style="overflow-y: auto; flex: 1;">
                <div class="alert alert-info py-2 px-3 mb-3" style="font-size:0.85rem; line-height: 1.6; border-right: 4px solid #0284c7; background-color: #f0f9ff; color: #0369a1;">
                    ⚖️ <strong>حسب القاعدتين 33 و 34 من قواعد الحوكمة القضائية:</strong>
                    <br />
                    • يُسجل الرصيد الافتتاحي للجلسة حصرياً أول كل عام قضائي مع تشكيل الدوائر والجلسات.
                    <br />
                    • يُعتمد عليه بنسبة 100% في تحديد (السابق) لشهر أكتوبر (بداية العام)، وتعتمد عليه تقارير الجرد السنوي.
                    <br />
                    • مؤجلات العام القضائي السابق معزولة تماماً ولا تتداخل مع هذا الرصيد أو مع أشهر العام الجديد.
                </div>

                @if (isLoadingOpeningBalances)
                {
                    <div style="text-align:center; padding: 2.5rem 0;">
                        <div class="spinner mb-2"></div>
                        <div class="text-muted">جاري تحميل شرائح الرصيد الافتتاحي للجلسة...</div>
                    </div>
                }
                else if (sessionOpeningBalanceItems.Count == 0)
                {
                    <div class="alert alert-warning text-center">
                        ⚠️ لا توجد شرائح سنوات قيد أو أنواع قضايا مهيأة لهذه الجلسة للعام القضائي المحدد. يرجى مراجعة إعدادات أنواع القضايا وسياسات الشرائح في شاشة القواعد.
                    </div>
                }
                else
                {
                    @if (DistinctOpeningBalanceCaseTypes.Count() > 1)
                    {
                        <div class="d-flex align-center justify-between mb-3 gap-2 flex-wrap">
                            <div class="d-flex align-center gap-2">
                                <label class="form-label m-0 fw-bold" style="white-space:nowrap">تصفية حسب نوع القضية:</label>
                                <select class="form-control form-control-sm" style="min-width: 200px;" @bind="openingBalanceCaseTypeFilter">
                                    <option value="">-- عرض كل أنواع القضايا (@sessionOpeningBalanceItems.Count شريحة) --</option>
                                    @foreach (var ct in DistinctOpeningBalanceCaseTypes)
                                    {
                                        <option value="@ct">@ct</option>
                                    }
                                </select>
                            </div>
                            <div class="badge badge-info" style="font-size:0.85rem; padding: 0.4rem 0.8rem;">
                                إجمالي كل الشرائح: @sessionOpeningBalanceItems.Sum(i => i.Count) قضية
                            </div>
                        </div>
                    }

                    <div class="table-container mb-3" style="max-height: 420px; overflow-y: auto;">
                        <table class="table table-bordered table-hover mb-0">
                            <thead style="position: sticky; top: 0; background: var(--cs-navy, #1e293b); color: white; z-index: 2;">
                                <tr>
                                    <th style="width: 45%;">نوع القضية</th>
                                    <th style="width: 30%;">شريحة سنة القيد</th>
                                    <th style="width: 25%; text-align: center;">الرصيد الافتتاحي (قضية)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredOpeningBalanceItems)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.CaseTypeNameAr</td>
                                        <td>
                                            <span class="badge badge-secondary" style="font-size:0.8rem">
                                                @item.CaseYearBandLabelAr
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            <input type="number" 
                                                   class="form-control form-control-sm text-center fw-bold" 
                                                   min="0"
                                                   style="width: 110px; margin: 0 auto; background-color: #f8fafc;"
                                                   @bind="item.Count" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot style="position: sticky; bottom: 0; background: #f1f5f9; font-weight: bold; border-top: 2px solid #cbd5e1;">
                                <tr>
                                    <td colspan="2" style="text-align: left; padding-left: 1rem;">
                                        @(string.IsNullOrWhiteSpace(openingBalanceCaseTypeFilter) ? "إجمالي الرصيد الافتتاحي لكافة الأنواع:" : $"مجموع رصيد ({openingBalanceCaseTypeFilter}):")
                                    </td>
                                    <td style="text-align: center; color: var(--cs-primary, #0369a1); font-size: 1.1rem;">
                                        @FilteredOpeningBalanceItems.Sum(i => i.Count)
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer d-flex justify-between align-center">
                <div class="text-muted" style="font-size:0.85rem">
                    إجمالي الرصيد الافتتاحي للجلسة: <strong class="text-primary" style="font-size:1rem">@sessionOpeningBalanceItems.Sum(i => i.Count)</strong> قضية
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">إلغاء</button>
