        AutoGenerateCircuitCode();
        AutoSuggestCircuitName();
    }

    private void AutoGenerateCircuitCode()
    {
        var prefix = circuitModel.CircuitKind switch
        {
            "CivilFull" => "CV",
            "CriminalAppeal" => "CRIM",
            "Family" => "FAM",
            "Labor" => "LAB",
            "Partial" => "PART",
            _ => "CIR"
        };

        int maxNum = 0;
        if (circuits != null)
        {
            foreach (var c in circuits)
            {
                if (string.IsNullOrWhiteSpace(c.Code)) continue;
                var code = c.Code.Trim();
                var parts = code.Split('-');
                if (parts.Length >= 2 && parts[0].Equals(prefix, StringComparison.OrdinalIgnoreCase))
                {
                    if (int.TryParse(parts[1], out int n) && n > maxNum)
                        maxNum = n;
                }
                else if (parts.Length >= 3 && parts[1].Equals(prefix, StringComparison.OrdinalIgnoreCase))
                {
                    if (int.TryParse(parts[2], out int n) && n > maxNum)
                        maxNum = n;
                }
            }
        }

        int nextNum = maxNum + 1;
        circuitModel.Code = $"{prefix}-{nextNum:D2}";
    }

    private void AutoSuggestCircuitName()
    {
        var court = courts?.FirstOrDefault(c => c.Id == circuitModel.CourtUnitId);
        var kindName = circuitModel.CircuitKind switch
        {
            "CivilFull" => "مدني كلي",
            "CriminalAppeal" => "جنح مستأنف",
            "Family" => "أسرة",
            "Labor" => "عمال",
            "Partial" => "جزئي",
            _ => "دائرة"
        };
        var parts = circuitModel.Code.Split('-');
        string numStr = parts.Length >= 2 ? parts[1] : "1";
        if (int.TryParse(numStr, out int numVal)) numStr = numVal.ToString();
        circuitModel.NameAr = $"الدائرة {numStr} {kindName} {(court != null ? court.NameAr : "")}".Trim();
    }

    private void OpenAddCircuitModal()
    {
        var defaultCourt = courts?.FirstOrDefault(c => c.ParentCourtUnitId != null) ?? courts?.FirstOrDefault();
        var defaultKind = "CivilFull";
        if (defaultCourt != null)
        {
            var allowed = GetAllowedCircuitKindsForCourt(defaultCourt.Id);
            defaultKind = allowed.FirstOrDefault().Value ?? "CivilFull";
        }

        circuitModel = new CircuitFormModel
        {
            CourtUnitId = defaultCourt?.Id ?? 0,
            CircuitKind = defaultKind
        };
        AutoGenerateCircuitCode();
        AutoSuggestCircuitName();
        showAddCircuitModal = true;
    }

