                "Family" => allCaseTypes.Where(ct => ct.Code.StartsWith("FAM-") || ct.StatisticalLevelCode == "Family" || ct.ProcedureCode == "Family").ToList(),
                "Labor" => allCaseTypes.Where(ct => ct.Code.StartsWith("LABOR-") || ct.StatisticalLevelCode == "Labor" || ct.ProcedureCode == "Labor").ToList(),
