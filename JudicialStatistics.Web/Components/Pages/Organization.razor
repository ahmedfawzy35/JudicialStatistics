                            <button type="button" class="btn btn-xs btn-outline-primary" @onclick="SelectAllFilteredEditSessionGeoAreas" title="تحديد جميع النطاقات المعروضة">
                                ☑️ تحديد الكل
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary" @onclick="DeselectAllEditSessionGeoAreas" title="إلغاء تحديد كافة النطاقات">
                                ✕ إلغاء التحديد
                            </button>
                        </div>

                        @if (editingSessionModel.SelectedGeographicAreaIds.Count > 0)
                        {
                            <div class="p-2 mb-2 bg-light border rounded d-flex gap-1 flex-wrap align-center">
                                <span class="text-secondary" style="font-size:0.75rem">المحدد:</span>
                                @foreach (var aid in editingSessionModel.SelectedGeographicAreaIds)
