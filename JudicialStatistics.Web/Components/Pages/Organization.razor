    private List<GeographicAreaDto> GetFilteredGeoAreas(string search, string kind)
    {
        var list = activeGeoAreas.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            var t = search.Trim();
            list = list.Where(a => a.NameAr.Contains(t, StringComparison.OrdinalIgnoreCase) || a.Code.Contains(t, StringComparison.OrdinalIgnoreCase));
        }
        if (!string.IsNullOrWhiteSpace(kind))
        {
            list = list.Where(a => a.AreaKind.Equals(kind, StringComparison.OrdinalIgnoreCase));
        }
        return list.ToList();
    }

