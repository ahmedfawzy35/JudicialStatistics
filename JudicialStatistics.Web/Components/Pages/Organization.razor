    private async Task OpenSessionOpeningBalanceModal(SessionDto s)
    {
        selectedSessionForOpeningBalance = s;
        selectedSessionVersionId = s.SessionVersionId;

        if (selectedSessionVersionId <= 0)
        {
            var detail = await OrgService.GetSessionDetailAsync(s.Id);
            selectedSessionVersionId = detail?.Versions.FirstOrDefault()?.Id ?? 0;
        }

        if (selectedSessionVersionId <= 0)
        {
            statusMessage = "تعذر تحديد نسخة الجلسة للعام القضائي المحدد.";
            isError = true;
            return;
        }

        isLoadingOpeningBalances = true;
        showSessionOpeningBalanceModal = true;
        openingBalanceCaseTypeFilter = "";
        sessionOpeningBalanceItems.Clear();

        try
        {
            // 1. الأرصدة الحالية المسجلة للجلسة إن وجدت
            var existingBalances = await OrgService.GetSessionOpeningBalancesAsync(selectedSessionVersionId);
            var existingDict = existingBalances.ToDictionary(
                b => (b.CaseTypeId, b.CaseYearBandId),
                b => b.Count);

            // 2. أنواع القضايا المسندة للجلسة
            var caseTypes = await RulesService.GetCaseTypesForSessionVersionAsync(selectedSessionVersionId);
            if (caseTypes.Count == 0)
            {
                caseTypes = await RulesService.GetCaseTypesAsync();
            }

            // 3. سياسات وشرائح سنوات القيد المعتمدة للعام القضائي
            var policies = await RulesService.GetPoliciesForYearAsync(selectedYearId);
            var defaultBands = policies.FirstOrDefault(p => p.Bands.Count > 0)?.Bands ?? new List<CaseYearBandDto>();

            var items = new List<SessionOpeningBalanceItem>();

            foreach (var ct in caseTypes)
            {
                var policy = policies.FirstOrDefault(p => p.CaseTypeId == ct.Id);
                var bandsToUse = (policy != null && policy.Bands.Count > 0) ? policy.Bands : defaultBands;

                foreach (var band in bandsToUse.OrderBy(b => b.SortOrder))
                {
                    existingDict.TryGetValue((ct.Id, band.Id), out var count);
                    items.Add(new SessionOpeningBalanceItem
                    {
                        CaseTypeId = ct.Id,
                        CaseTypeNameAr = ct.NameAr,
                        CaseYearBandId = band.Id,
                        CaseYearBandLabelAr = band.LabelAr,
                        Count = count
                    });
                }
            }

            // تضمين أي أرصدة مسجلة مسبقاً غير موجودة بالقائمة
            foreach (var ex in existingBalances)
            {
                if (!items.Any(i => i.CaseTypeId == ex.CaseTypeId && i.CaseYearBandId == ex.CaseYearBandId))
                {
                    items.Add(new SessionOpeningBalanceItem
                    {
                        CaseTypeId = ex.CaseTypeId,
                        CaseTypeNameAr = ex.CaseTypeNameAr,
                        CaseYearBandId = ex.CaseYearBandId,
                        CaseYearBandLabelAr = ex.CaseYearBandLabelAr,
                        Count = ex.Count
                    });
                }
            }

            sessionOpeningBalanceItems = items;
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ أثناء تحميل الرصيد الافتتاحي: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoadingOpeningBalances = false;
        }
    }

    private async Task HandleSaveSessionOpeningBalances()
    {
        if (selectedSessionVersionId <= 0) return;

        try
        {
            isSubmitting = true;
            statusMessage = null;

            var toSave = sessionOpeningBalanceItems
                .Select(i => new OpeningBalanceValue(i.CaseTypeId, i.CaseYearBandId, i.Count))
                .ToList();

            await OrgService.SaveSessionOpeningBalancesAsync(selectedSessionVersionId, toSave, currentUserId);

            statusMessage = $"✅ تم حفظ الرصيد الافتتاحي لجلسة ({selectedSessionForOpeningBalance?.NameAr}) بنجاح.";
            isError = false;
            showSessionOpeningBalanceModal = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ أثناء حفظ الرصيد الافتتاحي: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool isExportingFormation;
    private async Task ExportFormationSheet()
    {
        isExportingFormation = true;
        try
        {
            var bytes = await FormationExportService.ExportFormationWorkbookAsync(selectedYearId, selectedPeriodId);
            var fileName = $"شيت_التشكيل_الموحد_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            var base64 = Convert.ToBase64String(bytes);
            await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            statusMessage = "تم تصدير شيت التشكيل بنجاح وتحميله على جهازك.";
            isError = false;
        }
        catch (Exception ex)
        {
            statusMessage = "فشل تصدير شيت التشكيل: " + ex.Message;
            isError = true;
        }
        finally
        {
            isExportingFormation = false;
        }
    }

    public class SessionOpeningBalanceItem
    {
        public long CaseTypeId { get; set; }
        public string CaseTypeNameAr { get; set; } = string.Empty;
        public long CaseYearBandId { get; set; }
        public string CaseYearBandLabelAr { get; set; } = string.Empty;
        public int Count { get; set; }
    }
}
