@page "/organization"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject IOrganizationService OrgService
@inject IRulesService RulesService
@inject IJudicialYearsService YearsService
@inject ICourtsService CourtsService
@inject IServiceScopeFactory ScopeFactory
@inject JudicialStatistics.Web.Services.CurrentCourtState CourtState
@inject JudicialStatistics.Application.Import.IFormationExportService FormationExportService
@inject IJSRuntime JSRuntime

<PageTitle>التشكيل وتوزيع العمل القضائي — الإحصاء القضائي</PageTitle>

<div class="page-header mb-4">
    <div>
        <h1 class="page-title">🗂️ التشكيل وتوزيع العمل القضائي</h1>
        <p class="page-subtitle">استعراض وإدارة الدوائر، الجلسات، تشكيل القضاة، وقرارات الندب والنقل</p>
    </div>
    <div class="page-actions d-flex gap-2">
        <button class="btn btn-outline-success" @onclick="ExportFormationSheet" disabled="@isExportingFormation" title="تصدير شيت التشكيل الموحد كملف إكسل مطابق للنموذج">
            <span>📊</span> @(isExportingFormation ? "جاري التصدير..." : "تصدير شيت التشكيل")
        </button>
        @if (activeTab == "circuits")
        {
            <button class="btn btn-primary" @onclick="OpenAddCircuitModal">➕ إضافة دائرة جديدة</button>
        }
        else if (activeTab == "sessions")
        {
            <button class="btn btn-primary" @onclick="OpenAddSessionModal">➕ إضافة جلسة جديدة</button>
        }
        else if (activeTab == "judges")
        {
            <button class="btn btn-primary" @onclick="OpenAddJudgeModal">➕ إضافة قاضٍ جديد</button>
        }
        else if (activeTab == "employees")
        {
            <button class="btn btn-primary" @onclick="OpenAddEmployeeModal">➕ إضافة موظف جديد</button>
        }
        else if (activeTab == "assignments")
        {
            <button class="btn btn-primary" @onclick="OpenAssignJudgeModal">➕ تكليف قاضٍ بدائرة</button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") mb-4">
        <span>@(isError ? "⚠️" : "✅") @statusMessage</span>
    </div>
}

@* تبويبات التشكيل *@
<div class="tabs mb-4">
    <button class="tab @(activeTab == "formation-view" ? "active" : "")" @onclick='() => SetTab("formation-view")'>
        🔍 استعراض تشكيل الدوائر وتوزيع القضاة
    </button>
    <button class="tab @(activeTab == "circuits" ? "active" : "")" @onclick='() => SetTab("circuits")'>
        ⚖️ كافة الدوائر (@(circuits?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "sessions" ? "active" : "")" @onclick='() => SetTab("sessions")'>
        🗓️ كافة الجلسات (@(sessions?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "judges" ? "active" : "")" @onclick='() => SetTab("judges")'>
        👨‍⚖️ السادة القضاة (@(judges?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "employees" ? "active" : "")" @onclick='() => SetTab("employees")'>
        👨‍💼 الموظفين وسكرتيري الجلسات (@(employeesList?.Count ?? 0))
    </button>
    <button class="tab @(activeTab == "assignments" ? "active" : "")" @onclick='() => SetTab("assignments")'>
        📜 سجل التكليفات (@(assignments?.Count ?? 0))
    </button>
</div>

@* ==================== تبويب 1: استعراض تشكيل الدوائر والقضاة (التصفية التفاعلية) ==================== *@
@if (activeTab == "formation-view")
{
    <section class="setup-card mb-4">
        <div class="setup-heading">
            <div class="setup-heading-icon">⚖️</div>
            <div>
                <h2>استعراض تشكيل الدوائر وتوزيع العمل القضائي</h2>
                <p>اختر نوع التخصص القضائي، ثم حدد المأمورية الكلية أو المحكمة الجزئية لاستعراض الدائرة وتشكيل قضاتها وقراراتها الرسمية.</p>
            </div>
        </div>

        @* أزرار اختيار نوع الإحصائية / التخصص *@
        <div class="mb-4">
            <label class="fw-semibold mb-2 d-block" style="font-size:0.9rem;color:var(--text-secondary)">نوع القضاء / التخصص:</label>
            <div class="discipline-pill-group">
                @foreach (var (code, nameAr) in StatisticalDisciplines.All)
                {
                    <button type="button"
                            class="discipline-pill @(selectedDiscipline == code ? "active" : "")"
                            @onclick="() => OnDisciplineSelected(code)">
                        @switch (code)
                        {
                            case StatisticalDisciplines.Civil:
                                <span>🏛️ @nameAr (كلي وجزئي)</span>
                                break;
                            case StatisticalDisciplines.Criminal:
                                <span>⚖️ @nameAr (مستأنف وجزئي)</span>
                                break;
                            case StatisticalDisciplines.Family:
                                <span>👨‍👩‍👧 @nameAr</span>
                                break;
                            case StatisticalDisciplines.Labor:
                                <span>👷 @nameAr</span>
                                break;
                            default:
                                <span>@(StatisticalDisciplines.GetIcon(code)) @nameAr</span>
                                break;
                        }
                    </button>
                }
            </div>
        </div>

        @* حقول التصفية المتتالية *@
        <div class="setup-fields">
            @* 1. العام القضائي *@
            <div>
                <label>العام القضائي:</label>
                <select class="form-control" value="@selectedYearId" @onchange="OnYearFilterChanged">
                    @if (years is not null)
                    {
                        @foreach (var y in years)
                        {
                            <option value="@y.Id">@y.NameAr @(y.Status == "Active" ? "(نشط)" : "")</option>
                        }
                    }
                </select>
            </div>

            @* 2. الشهر / الفترة *@
            <div>
                <label>الشهر / الفترة:</label>
                <select class="form-control" value="@selectedPeriodId" @onchange="OnPeriodFilterChanged">
                    @if (periods is not null)
                    {
                        @foreach (var p in periods)
                        {
                            <option value="@p.Id">@p.MonthNameAr (@p.MonthStartDate.ToString("yyyy-MM"))</option>
                        }
                    }
                </select>
            </div>

            @* 3. المحكمة / المأمورية *@
            <div>
                <label>المحكمة أو المأمورية:</label>
                <select class="form-control" value="@selectedCourtId" @onchange="OnCourtFilterChanged" disabled="@(isLoadingCourts || filteredCourts == null || filteredCourts.Count == 0)">
                    @if (isLoadingCourts)
                    {
                        <option value="0">جاري تحميل المحاكم...</option>
                    }
                    else if (filteredCourts == null || filteredCourts.Count == 0)
                    {
                        <option value="0">-- لا توجد محاكم مطابقة --</option>
                    }
                    else
                    {
                        @foreach (var c in filteredCourts)
                        {
                            <option value="@c.Id">@c.NameAr</option>
                        }
                    }
                </select>
            </div>

            @* 4. الدائرة القضائية *@
            <div>
                <label>الدائرة القضائية:</label>
                <select class="form-control" value="@selectedCircuitId" @onchange="OnCircuitFilterChanged" disabled="@(isLoadingCircuits || filteredCircuits == null || filteredCircuits.Count == 0)">
                    @if (isLoadingCircuits)
                    {
                        <option value="0">جاري تحميل الدوائر...</option>
                    }
                    else if (filteredCircuits == null || filteredCircuits.Count == 0)
                    {
                        <option value="0">-- لا توجد دوائر مطابقة --</option>
                    }
                    else
                    {
                        @foreach (var cir in filteredCircuits)
                        {
                            <option value="@cir.Id">@cir.NameAr</option>
                        }
                    }
                </select>
            </div>
        </div>
    </section>

    @* ==================== تفاصيل تشكيل الدائرة المحددة ==================== *@
    @if (isLoadingFormation)
    {
        <div style="padding:3rem;text-align:center">
            <div class="spinner" style="margin:0 auto 1rem"></div>
            <div class="fw-semibold">جاري تحميل بيانات وتشكيل الدائرة...</div>
        </div>
    }
    else if (currentFormation is not null)
    {
        @* بطاقة الدائرة ومستواها القضائي *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-between align-center">
                <div>
                    <span class="badge font-monospace bg-secondary me-2">@currentFormation.CircuitCode</span>
                    <strong style="font-size:1.15rem">@currentFormation.CircuitNameAr</strong>
                </div>
                <div>
                    <span class="badge badge-info">المقر: @currentFormation.CourtUnitNameAr</span>
                    <span class="badge @(currentFormation.IsClosed ? "badge-danger" : "badge-success") ms-2">
                        @(currentFormation.IsClosed ? "مغلقة" : "نشطة")
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex gap-4 flex-wrap" style="font-size:0.9rem">
                    <div>
                        <span class="text-secondary">مستوى الدائرة:</span>
                        <strong class="ms-1">@GetCircuitLevelDescription(currentFormation.CircuitKind)</strong>
                    </div>
                    <div>
                        <span class="text-secondary">نصاب التشكيل:</span>
                        <strong class="ms-1">
                            @(currentFormation.MinJudges == 1 ? "قاضٍ فردي واحد" : $"{currentFormation.MinJudges} قضاة على الأقل")
                        </strong>
                    </div>
                    <div>
                        <span class="text-secondary">عدد الجلسات التابعة:</span>
                        <strong class="ms-1">@currentFormation.Sessions.Count جلسة</strong>
                    </div>
                    <div>
                        <span class="text-secondary">عدد القضاة بالتشكيل:</span>
                        <strong class="ms-1">@currentFormation.Judges.Count قاضٍ</strong>
                    </div>
                </div>
            </div>
        </div>

        @* جدول الجلسات التابعة للدائرة *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-between align-center">
                <span class="card-title">🗓️ الجلسات التابعة للدائرة ومواعيد الانعقاد</span>
                <span class="badge badge-muted">@currentFormation.Sessions.Count جلسة</span>
            </div>
            <div class="card-body" style="padding:0">
                @if (currentFormation.Sessions.Count == 0)
                {
                    <div style="padding:2rem;text-align:center;color:var(--text-muted)">لا توجد جلسات مسجلة لهذه الدائرة.</div>
                }
                else
                {
                    <div class="table-wrapper" style="border:none">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ميعاد وجدول الانعقاد</th>
                                    <th>الاختصاص المكاني (المناطق الجغرافية)</th>
                                    <th>سكرتير الجلسة</th>
                                    <th>تاريخ السريان</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in currentFormation.Sessions)
                                {
                                    <tr>
                                        <td class="fw-bold">@s.ScheduleDescription</td>
                                        <td>
                                            @if (s.JurisdictionNamesAr.Count > 0)
                                            {
                                                <div class="d-flex gap-1 flex-wrap">
                                                    @foreach (var area in s.JurisdictionNamesAr)
                                                    {
                                                        <span class="badge badge-secondary" style="font-size:0.75rem">@area</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-secondary" style="font-size:0.85rem">كافة المراكز والمناطق التابعة</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(s.EmployeeNameAr))
                                            {
                                                <span class="badge badge-info" style="font-size:0.8rem">👤 @s.EmployeeNameAr</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted-color">—</span>
                                            }
                                        </td>
                                        <td>من @s.EffectiveFrom.ToString("yyyy-MM-dd") إلى @s.EffectiveTo.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* كشف تشكيل السادة القضاة بالدائرة *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-between align-center">
                <span class="card-title">👨‍⚖️ تشكيل السادة القضاة الذين عملوا بالدائرة خلال العام</span>
                <span class="badge badge-primary">التشكيل الرسمي</span>
            </div>
            <div class="card-body" style="padding:0">
                @if (currentFormation.Judges.Count == 0)
                {
                    <div style="padding:2rem;text-align:center;color:var(--text-muted)">لم يتم تسجيل قضاة لهذه الدائرة بعد.</div>
                }
                else
                {
                    <div class="table-wrapper" style="border:none">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>الصفة القضائية</th>
                                    <th>اسم السيد المستشار / القاضي</th>
                                    <th>تاريخ بدء العمل</th>
                                    <th>حالة القاضي هذا الشهر</th>
                                    <th>ملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var j in currentFormation.Judges)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @(j.JudicialRoleNameAr.Contains("رئيس") ? "badge-primary" : "badge-secondary")">
                                                @j.JudicialRoleNameAr
                                            </span>
                                        </td>
                                        <td class="fw-bold" style="font-size:0.95rem">@j.JudgeNameAr</td>
                                        <td>@j.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (j.StatusThisMonth.Contains("على رأس العمل"))
                                            {
                                                <span class="badge badge-success">🟢 @j.StatusThisMonth</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">🟠 @j.StatusThisMonth</span>
                                            }
                                        </td>
                                        <td>@(j.Notes ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* قرارات الندب والنقل والإجازات المؤثرة على التشكيل *@
        <div class="card mb-4" style="border-right:4px solid var(--brand-primary)">
            <div class="card-header d-flex justify-between align-center flex-wrap gap-2">
                <div>
                    <span class="card-title">📜 قرارات الندب والنقل والإجازات المؤثرة على تشكيل القضاة لهذا العام</span>
                    <span class="badge badge-muted ms-2">سجل الحركات القضائية</span>
                </div>
                <a href="/judge-movements?circuitId=@currentFormation.CircuitId" class="btn btn-sm btn-primary">
                    ➕ تسجيل قرار / حركة جديدة لهذه الدائرة
                </a>
            </div>
            <div class="card-body">
                <div style="display:flex;flex-direction:column;gap:0.75rem">
                    @foreach (var dec in currentFormation.Decisions)
                    {
                        <div class="p-3 border rounded d-flex justify-between align-center flex-wrap gap-2" style="background:var(--surface-hover)">
                            <div>
                                <div class="d-flex align-center gap-2 mb-1">
                                    <span class="badge badge-info">@dec.DecisionType</span>
                                    <strong>@dec.Reference</strong>
                                    <span class="text-secondary" style="font-size:0.8rem">بتاريخ: @dec.DecisionDate.ToString("yyyy-MM-dd")</span>
                                </div>
                                <div style="font-size:0.9rem;color:var(--text-primary)">@dec.Description</div>
                            </div>
                            <div>
                                <span class="badge badge-success">@dec.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@* ==================== تبويب 2: كافة الدوائر القضائية ==================== *@
@if (activeTab == "circuits")
{
    <div class="card">
        <div class="card-header d-flex justify-between align-center flex-wrap gap-2">
            <span class="card-title">قائمة كافة الدوائر القضائية (@filteredCircuitsList.Count دائرة)</span>
            <div class="d-flex align-center gap-2 flex-wrap">
                <input type="text" class="form-control form-control-sm" placeholder="🔍 بحث بالاسم أو الكود..."
                       style="min-width: 200px;"
                       @bind="circuitSearchTerm" @bind:event="oninput" />

                <select class="form-control form-control-sm" value="@selectedYearId" @onchange="OnYearFilterChanged" style="min-width: 140px;">
                    @if (years is not null)
                    {
                        @foreach (var y in years)
                        {
                            <option value="@y.Id">@y.NameAr @(y.Status == "Active" ? "(نشط)" : "")</option>
                        }
                    }
                </select>

                <select class="form-control form-control-sm" @bind="selectedCircuitCourtFilter" style="min-width: 170px;">
                    <option value="0">كل المحاكم والمأموريات</option>
                    @if (userAvailableCourts is not null)
                    {
                        @foreach (var c in userAvailableCourts)
                        {
                            <option value="@c.Id">@c.NameAr</option>
                        }
                    }
                </select>

                <select class="form-control form-control-sm" @bind="selectedCircuitKindFilter" style="min-width: 140px;">
                    <option value="">كل أنواع الدوائر</option>
                    <option value="CivilFull">مدني كلي</option>
                    <option value="CriminalAppeal">جنح مستأنف</option>
                    <option value="Family">أسرة</option>
                    <option value="Labor">عمال</option>
                    <option value="Partial">جزئي</option>
                </select>
            </div>
        </div>
        <div class="card-body" style="padding:0">
            @if (circuits is null)
            {
                <div style="padding:1.5rem" class="d-flex align-center gap-2"><div class="spinner"></div><span>جاري التحميل...</span></div>
            }
            else if (filteredCircuitsList.Count == 0)
            {
                <div style="padding:2rem;text-align:center;color:var(--text-muted)">لا توجد دوائر مطابقة لمعايير البحث.</div>
            }
            else
            {
                <div class="table-wrapper" style="border:none">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>كود الدائرة</th>
                                <th>اسم الدائرة</th>
                                <th>المحكمة / المأمورية</th>
                                <th>نوع الدائرة</th>
                                <th>عدد الجلسات</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in filteredCircuitsList)
                            {
                                <tr>
                                    <td><code>@c.Code</code></td>
                                    <td class="fw-semibold">@c.NameAr</td>
                                    <td>@c.CourtUnitNameAr</td>
                                    <td><span class="badge badge-info">@GetCircuitLevelShortName(c.CircuitKind)</span></td>
                                    <td><span class="badge badge-secondary">@c.SessionsCount جلسات</span></td>
                                    <td><span class="badge @(c.IsClosed ? "badge-danger" : "badge-success")">@(c.IsClosed ? "مغلقة" : "نشطة")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ==================== تبويب 3: كافة الجلسات ==================== *@
@if (activeTab == "sessions")
{
    <div class="card">
        <div class="card-header d-flex justify-between align-center flex-wrap gap-2">
            <span class="card-title">قائمة الجلسات القضائية (@filteredSessionsList.Count جلسة)</span>
            <div class="d-flex align-center gap-2 flex-wrap">
                <input type="text" class="form-control form-control-sm" placeholder="🔍 بحث بالاسم أو الكود..."
                       style="min-width: 200px;"
                       @bind="sessionSearchTerm" @bind:event="oninput" />

                <select class="form-control form-control-sm" value="@selectedYearId" @onchange="OnYearFilterChanged" style="min-width: 140px;">
                    @if (years is not null)
                    {
                        @foreach (var y in years)
                        {
                            <option value="@y.Id">@y.NameAr @(y.Status == "Active" ? "(نشط)" : "")</option>
                        }
                    }
                </select>

                <select class="form-control form-control-sm" @bind="selectedSessionCourtFilter" style="min-width: 170px;">
                    <option value="0">كل المحاكم</option>
                    @if (userAvailableCourts is not null)
                    {
                        @foreach (var c in userAvailableCourts)
                        {
                            <option value="@c.Id">@c.NameAr</option>
                        }
                    }
                </select>

                <select class="form-control form-control-sm" @bind="selectedSessionCircuitFilter" style="min-width: 170px;">
                    <option value="0">كل الدوائر</option>
                    @if (circuits is not null)
                    {
                        var availableCircuits = selectedSessionCourtFilter > 0
                            ? circuits.Where(c => c.CourtUnitId == selectedSessionCourtFilter)
                            : circuits;
                        @foreach (var c in availableCircuits)
                        {
                            <option value="@c.Id">@c.NameAr</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="card-body" style="padding:0">
            @if (sessions is null)
            {
                <div style="padding:1.5rem" class="d-flex align-center gap-2"><div class="spinner"></div><span>جاري التحميل...</span></div>
            }
            else if (filteredSessionsList.Count == 0)
            {
                <div style="padding:2rem;text-align:center;color:var(--text-muted)">لا توجد جلسات مطابقة لمعايير البحث.</div>
            }
            else
            {
                <div class="table-wrapper" style="border:none">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>كود الجلسة</th>
                                <th>اسم وتفاصيل الجلسة</th>
                                <th>الدائرة التابعة</th>
                                <th>نوع الدعاوى (الجلسة)</th>
                                <th>الاختصاص المكاني (النطاقات الجغرافية)</th>
                                <th>سكرتير الجلسة</th>
                                <th style="text-align:center">تقرير الإدخال</th>
                                <th style="text-align:center">الحالة</th>
                                <th style="text-align:center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in filteredSessionsList)
                            {
                                <tr>
                                    <td><code>@s.Code</code></td>
                                    <td>
                                        <div class="fw-semibold text-primary">@s.NameAr</div>
                                        @if (!string.IsNullOrEmpty(s.Description))
                                        {
                                            <div class="text-secondary small mt-1" style="font-size:0.78rem;">
                                                📝 @s.Description
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(s.ScheduleDescription) && s.ScheduleDescription != s.NameAr)
                                        {
                                            <div class="text-secondary small mt-1" style="font-size:0.75rem;">
                                                📅 @s.ScheduleDescription
                                            </div>
                                        }
                                    </td>
                                    <td>@s.CircuitNameAr</td>
                                    <td>
                                        @if (s.CaseTypeNamesAr is { Count: > 0 })
                                        {
                                            <div class="d-flex gap-1 flex-wrap">
                                                @foreach (var ct in s.CaseTypeNamesAr)
                                                {
                                                    <span class="badge badge-info" style="font-size:0.75rem">⚖️ @ct</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted-color">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (s.JurisdictionNamesAr is { Count: > 0 })
                                        {
                                            <div class="d-flex gap-1 flex-wrap">
                                                @foreach (var area in s.JurisdictionNamesAr)
                                                {
                                                    <span class="badge badge-secondary" style="font-size:0.75rem">📍 @area</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted-color">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(s.EmployeeNameAr))
                                        {
                                            <span class="badge badge-info" style="font-size:0.8rem;background:rgba(13,110,253,0.12);color:#0d6efd;border:1px solid rgba(13,110,253,0.3)">
                                                👤 @s.EmployeeNameAr
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted-color">—</span>
                                        }
                                    </td>
                                    <td style="text-align:center">
                                        <span class="badge @(s.ShowInProgressReport ? "badge-success" : "badge-secondary")" style="font-size:0.75rem" title="@(s.ShowInProgressReport ? "تظهر في تقرير نسبة الإدخال الشهري" : "مستثناة من تقرير نسبة الإدخال الشهري")">
                                            @(s.ShowInProgressReport ? "🟢 تظهر" : "⚪ مستثناة")
                                        </span>
                                    </td>
                                    <td style="text-align:center">
                                        <span class="badge @(s.IsClosed ? "badge-danger" : "badge-success")">
                                            @(s.IsClosed ? "مغلقة / معطلة" : "نشطة")
                                        </span>
                                    </td>
                                    <td style="text-align:center">
                                        <div class="d-flex align-center justify-center gap-1 flex-wrap">
                                            <button class="btn btn-sm btn-outline-info" @onclick="() => OpenSessionOpeningBalanceModal(s)" title="الرصيد الافتتاحي للجلسة أول العام القضائي">
                                                💰 الرصيد الافتتاحي
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditSessionModal(s)" title="تعديل بيانات واختصاص الجلسة">
                                                ✏️ تعديل
                                            </button>
                                            <button class="btn btn-sm @(s.IsClosed ? "btn-outline-success" : "btn-outline-danger")"
                                                    @onclick="() => ToggleSessionClosed(s.Id)"
                                                    title="@(s.IsClosed ? "تنشيط الجلسة" : "تعطيل الجلسة")">
                                                @(s.IsClosed ? "✅ تنشيط" : "⛔ تعطيل")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ==================== تبويب 4: السادة القضاة ==================== *@
@if (activeTab == "judges")
{
    <div class="card">
        <div class="card-header d-flex justify-between align-center flex-wrap gap-2">
            <div>
                <span class="card-title">قائمة السادة القضاة (@filteredJudgesTabList.Count قاضٍ)</span>
                <span class="text-secondary" style="font-size:0.8rem;display:block">
                    السادة القضاة العاملون بالجلسات والدوائر المتاحة لنطاقك خلال العام القضائي المحدد
                </span>
            </div>
            <div class="d-flex align-center gap-2 flex-wrap">
                <input type="text" class="form-control form-control-sm" placeholder="🔍 بحث باسم القاضي (يحتوي)..."
                       style="min-width: 220px;"
                       @bind="judgeSearchFilter" @bind:event="oninput" />

                <select class="form-control form-control-sm" value="@selectedYearId" @onchange="OnYearFilterChanged" style="min-width: 140px;">
                    @if (years is not null)
                    {
                        @foreach (var y in years)
                        {
                            <option value="@y.Id">@y.NameAr @(y.Status == "Active" ? "(نشط)" : "")</option>
                        }
                    }
                </select>

                <select class="form-control form-control-sm" @bind="selectedJudgeCourtFilter" style="min-width: 170px;">
                    <option value="0">كل المحاكم المنشئة</option>
                    @if (userAvailableJudgeCourts is not null)
                    {
                        @foreach (var c in userAvailableJudgeCourts)
                        {
                            <option value="@c.Id">🏛️ @c.NameAr</option>
                        }
                    }
                </select>

                <select class="form-control form-control-sm" @bind="selectedJudgeStatusFilter" style="min-width: 120px;">
                    <option value="all">كل الحالات</option>
                    <option value="active">النشطين فقط</option>
                    <option value="inactive">المعطلين فقط</option>
                </select>
            </div>
        </div>
        <div class="card-body" style="padding:0">
            @if (judges is null)
            {
                <div style="padding:1.5rem" class="d-flex align-center gap-2"><div class="spinner"></div><span>جاري التحميل...</span></div>
            }
            else if (filteredJudgesTabList.Count == 0)
            {
                <div style="padding:2rem;text-align:center;color:var(--text-muted)">لا يوجد قضاة مطابقين لمعايير البحث.</div>
            }
            else
            {
                <div class="table-wrapper" style="border:none">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>كود القاضي</th>
                                <th>الاسم الرباعي</th>
                                <th>المحكمة المنشئة</th>
                                <th>الحالة</th>
                                <th style="text-align:center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in filteredJudgesTabList)
                            {
                                var canEditThisJudge = CanEditJudge(j);
                                <tr>
                                    <td><code>@j.Code</code></td>
                                    <td class="fw-semibold">@j.FullNameAr</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(j.CreatedCourtUnitNameAr))
                                        {
                                            <span class="badge badge-info">🏛️ @j.CreatedCourtUnitNameAr</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:0.85rem;color:var(--text-muted)">المركز العام</span>
                                        }
                                    </td>
                                    <td><span class="badge @(j.IsActive ? "badge-success" : "badge-muted")">@(j.IsActive ? "نشط" : "معطل")</span></td>
                                    <td style="text-align:center">
                                        @if (canEditThisJudge)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditJudgeModal(j)">
                                                ✏️ تعديل
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge badge-muted" title="لا يمكن تعديل بيانات القاضي إلا من خلال محكمته المنشئة">🔒 محكمة أخرى</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}


@* ==================== تبويب 5: سجل التكليفات ==================== *@
@if (activeTab == "assignments")
{
    <div class="card">
        <div class="card-header d-flex justify-between align-center flex-wrap gap-2">
            <div>
                <span class="card-title">📜 سجل التكليفات القضائية للدوائر (تشكيل الدوائر)</span>
                <span class="badge badge-info ms-2">@(assignments?.Count ?? 0) تكليفاً مسجلاً</span>
                <span class="text-secondary" style="font-size:0.8rem;display:block">
                    تكليفات وتشكيلات القضاة المؤثرة على الجلسات والدوائر المتاحة لنطاقك خلال العام القضائي المحدد
                </span>
            </div>
            <div class="d-flex align-center gap-2">
                <label class="text-secondary mb-0" style="font-size:0.85rem">العام القضائي:</label>
                <select class="form-control form-control-sm" value="@selectedYearId" @onchange="OnYearFilterChanged" style="min-width: 140px;">
                    @if (years is not null)
                    {
                        @foreach (var y in years)
                        {
                            <option value="@y.Id">@y.NameAr @(y.Status == "Active" ? "(نشط)" : "")</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="card-body">
            @if (circuits is null || circuits.Count == 0)
            {
                <div class="text-muted-color">لا توجد دوائر قضائية مسجلة أو متاحة لنطاقك في هذا العام القضائي لعرض وتعيين تكليفات القضاة.</div>
            }
            else
            {
                <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(420px, 1fr));gap:1.25rem">
                    @foreach (var c in circuits)
                    {
                        var cAssignments = assignments?.Where(a => a.CircuitId == c.Id).OrderBy(a => a.DisplayOrder).ToList()
                            ?? new List<CircuitJudgeAssignmentDto>();

                        <div class="card" style="border:1px solid var(--surface-border);margin-bottom:0;display:flex;flex-direction:column;">
                            <div class="card-header" style="background:var(--surface-bg);display:flex;justify-content:space-between;align-items:center;padding:0.75rem 1rem;">
                                <div>
                                    <span class="badge bg-secondary font-monospace" style="margin-left:0.5rem">@c.Code</span>
                                    <strong>@c.NameAr</strong>
                                </div>
                                <span class="badge badge-secondary" style="font-size:0.75rem">@c.CourtUnitNameAr</span>
                            </div>
                            <div class="card-body" style="padding:0.75rem 1rem;flex:1;">
                                @if (cAssignments.Count == 0)
                                {
                                    <div class="text-muted-color" style="font-size:0.85rem;padding:0.5rem 0;">لا توجد تكليفات مسجلة لهذه الدائرة.</div>
                                }
                                else
                                {
                                    <div style="display:flex;flex-direction:column;gap:0.4rem;">
                                        @foreach (var a in cAssignments)
                                        {
                                            var roleClass = a.JudicialRoleNameAr.Contains("رئيس") ? "badge-primary" : "badge-secondary";
                                            <div style="display:flex;align-items:center;justify-content:space-between;background:var(--surface-ground, #f8f9fa);padding:0.4rem 0.6rem;border-radius:4px;border-right:3px solid var(--primary-color, #1a56db);">
                                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                                    <span class="badge @roleClass" style="min-width:90px;text-align:center;">@a.JudicialRoleNameAr</span>
                                                    <span class="fw-semibold" style="font-size:0.9rem;">@a.JudgeNameAr</span>
                                                </div>
                                                <span class="text-muted-color" style="font-size:0.75rem;">ترتيب: @a.DisplayOrder</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@* ==================== تبويب 6: جدول الموظفين وسكرتيري الجلسات ==================== *@
@if (activeTab == "employees")
{
    <div class="card">
        <div class="card-header d-flex justify-between align-center flex-wrap gap-2">
            <div>
                <span class="card-title">👨‍💼 سجل موظفي المحكمة وسكرتيري الجلسات</span>
                <span class="badge badge-info ms-2">@(employeesList?.Count ?? 0) موظفاً مسجلاً</span>
                <span class="text-secondary" style="font-size:0.8rem;display:block">
                    إدارة أمناء السر وكتبة الجلسات وإمكانية ربطهم بالجلسات وتحديث بياناتهم
                </span>
            </div>
            <div class="d-flex align-center gap-2 flex-wrap">
                <input type="text" class="form-control form-control-sm" placeholder="🔍 بحث بالاسم أو الكود..."
                       style="width: 200px;" @bind="employeeSearchTerm" @bind:event="oninput" />

                <select class="form-control form-control-sm" style="width: 170px;" @bind="selectedEmployeeCourtFilter">
                    <option value="0">كل المحاكم والمأموريات</option>
                    @if (courts is not null)
                    {
                        @foreach (var c in courts)
                        {
                            <option value="@c.Id">@c.NameAr</option>
                        }
                    }
                </select>

                <select class="form-control form-control-sm" style="width: 130px;" @bind="selectedEmployeeStatusFilter">
                    <option value="all">كل الحالات</option>
                    <option value="active">على رأس العمل (نشط)</option>
                    <option value="inactive">غير نشط</option>
                </select>

                <button class="btn btn-sm btn-primary" @onclick="OpenAddEmployeeModal">
                    ➕ موظف جديد
                </button>
            </div>
        </div>
        <div class="card-body">
            @{
                var filteredEmployees = employeesList?.AsEnumerable() ?? Enumerable.Empty<EmployeeDto>();
                if (!string.IsNullOrWhiteSpace(employeeSearchTerm))
                {
                    var term = employeeSearchTerm.Trim();
                    filteredEmployees = filteredEmployees.Where(e =>
                        e.FullNameAr.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                        e.Code.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                        (e.PhoneNumber != null && e.PhoneNumber.Contains(term)) ||
                        (e.NationalId != null && e.NationalId.Contains(term)));
                }
                if (selectedEmployeeCourtFilter > 0)
                {
                    filteredEmployees = filteredEmployees.Where(e => e.CourtUnitId == selectedEmployeeCourtFilter);
                }
                if (selectedEmployeeStatusFilter == "active")
                {
                    filteredEmployees = filteredEmployees.Where(e => e.IsActive);
                }
                else if (selectedEmployeeStatusFilter == "inactive")
                {
                    filteredEmployees = filteredEmployees.Where(e => !e.IsActive);
                }
                var empList = filteredEmployees.OrderBy(e => e.Code).ToList();
            }

            @if (empList.Count == 0)
            {
                <div class="text-muted-color">لا يوجد موظفون مطابقون لخيارات التصفية المحددة.</div>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>الكود</th>
                                <th>الاسم الكامل</th>
                                <th>المسمى الوظيفي</th>
                                <th>المحكمة / المأمورية التابع لها</th>
                                <th>رقم الهاتف</th>
                                <th>الرقم القومي</th>
                                <th>الحالة</th>
                                <th style="text-align: center;">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in empList)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary font-monospace">@emp.Code</span></td>
                                    <td class="fw-semibold">@emp.FullNameAr</td>
                                    <td>
                                        <span class="badge badge-info" style="font-size:0.8rem">
                                            @(emp.JobTitle ?? "أمين سر جلسة")
                                        </span>
                                    </td>
                                    <td>@(emp.CourtUnitNameAr ?? "غير محدد")</td>
                                    <td>@(emp.PhoneNumber ?? "—")</td>
                                    <td class="font-monospace" style="font-size:0.85rem">@(emp.NationalId ?? "—")</td>
                                    <td>
                                        @if (emp.IsActive)
                                        {
                                            <span class="badge badge-success">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">غير نشط</span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="d-flex justify-center gap-1">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditEmployeeModal(emp)" title="تعديل بيانات الموظف">
                                                ✏️ تعديل
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleDeleteEmployee(emp.Id)" title="حذف الموظف">
                                                🗑️ حذف
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ==================== مودال إضافة دائرة (مع التحقق الصارم) ==================== *@
@if (showAddCircuitModal)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">➕ إضافة دائرة قضائية جديدة</span>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <EditForm Model="circuitModel" OnValidSubmit="HandleCreateCircuit">
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> المحكمة أو المأمورية التابعة</label>
                        <InputSelect class="form-control" Value="circuitModel.CourtUnitId" ValueExpression="() => circuitModel.CourtUnitId" ValueChanged="(long id) => OnCircuitCourtChanged(id)" required>
                            @if (courts is not null)
                            {
                                @foreach (var court in courts)
                                {
                                    <option value="@court.Id">@court.NameAr (@GetUnitKindNameAr(court.UnitKind))</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> نوع ومستوى الدائرة (مقيد بالمحكمة)</label>
                        <InputSelect class="form-control" Value="circuitModel.CircuitKind" ValueExpression="() => circuitModel.CircuitKind" ValueChanged="(string k) => OnCircuitKindChanged(k)">
                            @foreach (var opt in GetAllowedCircuitKindsForCourt(circuitModel.CourtUnitId))
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> كود الدائرة (توليد تلقائي)</label>
                        <div class="d-flex gap-2">
                            <InputText class="form-control" @bind-Value="circuitModel.Code" placeholder="مثال: CV-09" required />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => { AutoGenerateCircuitCode(); AutoSuggestCircuitName(); }" title="إعادة توليد الكود والاسم تلقائياً">🔄 توليد تلقائي</button>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> اسم الدائرة</label>
                        <InputText class="form-control" @bind-Value="circuitModel.NameAr" placeholder="مثال: الدائرة التاسعة مدني كلي بني سويف" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">إلغاء</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">حفظ الدائرة</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ==================== مودال إضافة جلسة ==================== *@
@if (showAddSessionModal)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal" style="max-width: 650px;" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">➕ إضافة جلسة قضائية جديدة</span>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <EditForm Model="sessionModel" OnValidSubmit="HandleCreateSession">
                <div class="modal-body">
                    @* 1. اختيار المحكمة أو المأمورية *@
                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> المحكمة أو المأمورية التابعة</label>
                        <select class="form-control" value="@sessionCourtUnitId" @onchange="OnSessionModalCourtChanged">
                            @if (courts is not null)
                            {
                                @foreach (var c in courts)
                                {
                                    <option value="@c.Id">@c.NameAr (@GetUnitKindNameAr(c.UnitKind))</option>
                                }
                            }
                        </select>
                    </div>

                    @* 2. اختيار الدائرة من الدوائر التابعة للمحكمة *@
                    <div class="form-group mb-3">
                        <label class="form-label"><span class="required">*</span> الدائرة التابعة</label>
                        <select class="form-control" value="@sessionModel.CircuitId" @onchange="OnSessionModalCircuitChanged">
                            @foreach (var c in availableCircuitsForSessionModal)
                            {
                                <option value="@c.Id">@c.NameAr (@c.Code) - @GetCircuitLevelShortName(c.CircuitKind)</option>
                            }
                        </select>
                    </div>

                    @* 3. كود واسم الجلسة *@
                    <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                        <div class="form-group mb-3">
                            <label class="form-label"><span class="required">*</span> كود الجلسة</label>
                            <InputText class="form-control" @bind-Value="sessionModel.Code" placeholder="مثال: S-SAT" required />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label"><span class="required">*</span> اسم الجلسة</label>
                            <InputText class="form-control" @bind-Value="sessionModel.NameAr" placeholder="مثال: جلسة السبت أسبوع أول" required />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">جدول الانعقاد واليوم</label>
                        <InputText class="form-control" @bind-Value="sessionModel.ScheduleDescription" placeholder="مثال: السبت أسبوع 1 و 3" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">تفاصيل ووصف الجلسة القياسي (اليوم - النوع - الاختصاص المكاني - اختصار الدائرة)</label>
                        <InputText class="form-control" @bind-Value="sessionModel.Description" placeholder="مثال: السبت - مدني كلي - محافظة بني سويف - د1" />
                        <span class="text-secondary" style="font-size:0.75rem">الصيغة المعتمدة: [اليوم] - [النوع أو الدعاوى] - [الاختصاص المكاني] - [د1، د2]</span>
                    </div>

                    <div class="form-group mb-3 p-2 border rounded" style="background:var(--surface-hover);">
                        <div class="d-flex align-center gap-2">
                            <input type="checkbox" id="addSessionShowProgress" @bind="sessionModel.ShowInProgressReport" style="width:18px;height:18px;cursor:pointer" />
                            <label for="addSessionShowProgress" class="m-0 fw-semibold" style="cursor:pointer">
                                📊 ظهور الجلسة في كشف ونسبة إدخال الإحصائية الشهرية
                            </label>
                        </div>
                        <div class="text-secondary mt-1" style="font-size:0.75rem">
                            تظهر كافة الجلسات افتراضياً في تقرير نسبة الإدخال، عدا الجلسات الجنائية المستثناة كالعنف والبيئة والمرور والأمن... إلخ.
                        </div>
                    </div>

                    @* 4. الاختصاص المكاني والنطاقات الجغرافية (يمكن تغطية أكثر من نطاق جغرافي) *@
                    <div class="form-group mb-3">
                        <div class="d-flex justify-between align-center mb-1">
                            <label class="form-label fw-bold mb-0" style="color:var(--brand-primary)">
                                📍 الاختصاص المكاني والنطاقات الجغرافية للجلسة: <span class="required">*</span>
                            </label>
                            <span class="badge @(sessionModel.SelectedGeographicAreaIds.Count > 0 ? "badge-primary" : "badge-warning")" style="font-size:0.75rem">
                                @(sessionModel.SelectedGeographicAreaIds.Count > 0 ? $"تم اختيار {sessionModel.SelectedGeographicAreaIds.Count} نطاق" : "لم يتم الاختيار بعد")
                            </span>
                        </div>
                        <div class="text-secondary mb-2" style="font-size:0.8rem">
                            قد تغطي الجلسة نطاقاً جغرافياً واحداً أو أكثر (مثال: قسم أول وقسم ثانٍ، أو مركز وبندر معاً).
                        </div>

                        @* شريط تصفية النطاقات وأزرار التحديد السريع *@
                        <div class="d-flex gap-2 mb-2 flex-wrap align-center">
                            <input type="text" class="form-control form-control-sm" placeholder="🔍 تصفية النطاقات بالاسم أو الكود..."
                                   style="max-width:210px;"
                                   @bind="sessionGeoSearchTerm" @bind:event="oninput" />

                            <select class="form-control form-control-sm" style="max-width:130px;" @bind="sessionGeoKindFilter">
                                <option value="">كل الأنواع</option>
                                <option value="Markaz">مراكز</option>
                                <option value="PoliceStation">أقسام شرطة</option>
                                <option value="City">مدن</option>
                                <option value="District">أحياء</option>
                                <option value="Governorate">محافظات</option>
                            </select>

                            <button type="button" class="btn btn-xs btn-outline-primary" @onclick="SelectAllFilteredSessionGeoAreas" title="تحديد جميع النطاقات المعروضة">
                                ☑️ تحديد الكل
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary" @onclick="DeselectAllSessionGeoAreas" title="إلغاء تحديد كافة النطاقات">
                                ✕ إلغاء التحديد
                            </button>
                        </div>

                        @* شريط النطاقات المختارة كـ Badges *@
                        @if (sessionModel.SelectedGeographicAreaIds.Count > 0)
                        {
                            <div class="p-2 mb-2 bg-light border rounded d-flex gap-1 flex-wrap align-center">
                                <span class="text-secondary" style="font-size:0.75rem">المحدد:</span>
                                @foreach (var aid in sessionModel.SelectedGeographicAreaIds)
                                {
                                    var area = activeGeoAreas.FirstOrDefault(a => a.Id == aid);
                                    if (area != null)
                                    {
                                        <span class="badge badge-primary d-inline-flex align-center gap-1" style="font-size:0.78rem; padding:4px 8px;">
                                            <span>📍 @area.NameAr</span>
                                            <button type="button" class="btn btn-link p-0 text-white" style="line-height:1; font-size:0.8rem; text-decoration:none;" @onclick="() => RemoveSessionGeoArea(aid)" title="إزالة">✕</button>
                                        </span>
                                    }
                                }
                            </div>
                        }

                        @* قائمة النطاقات مع Checkboxes *@
                        <div class="p-2 border rounded" style="max-height: 180px; overflow-y: auto; background: var(--surface-hover);">
                            @{
                                var displayedAreas = GetFilteredGeoAreas(sessionGeoSearchTerm, sessionGeoKindFilter);
                            }
                            @if (displayedAreas.Count == 0)
                            {
                                <div class="text-muted-color" style="font-size:0.85rem">لا توجد نطاقات جغرافية نشطة مطابقة للبحث.</div>
                            }
                            else
                            {
                                @foreach (var a in displayedAreas)
                                {
                                    var isChecked = sessionModel.SelectedGeographicAreaIds.Contains(a.Id);
                                    <div class="d-flex align-center gap-2 mb-1 p-1 rounded" style="@(isChecked ? "background:rgba(13, 110, 253, 0.08);" : "")">
                                        <input type="checkbox" id="add_geo_@a.Id"
                                               checked="@isChecked"
                                               @onchange="(e) => ToggleSessionGeoArea(a.Id, e)"
                                               style="width:16px;height:16px;cursor:pointer" />
                                        <label for="add_geo_@a.Id" class="m-0 flex-grow-1 d-flex align-center justify-between gap-2" style="cursor:pointer">
                                            <div>
                                                <strong style="font-size:0.9rem">@a.NameAr</strong>
                                                <span class="text-secondary" style="font-size:0.8rem">(@a.Code)</span>
                                                @if (!string.IsNullOrEmpty(a.ParentAreaNameAr))
                                                {
                                                    <span class="text-muted" style="font-size:0.75rem">— تابع لـ @a.ParentAreaNameAr</span>
                                                }
                                            </div>
                                            <span class="badge badge-info" style="font-size:0.7rem">@GetAreaKindAr(a.AreaKind)</span>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    @* 5. تقييد أنواع الدعاوى المنظورة حصرياً حسب الدائرة المختارة *@
                    <div class="form-group mb-3">
                        <div class="d-flex justify-between align-center mb-1">
                            <label class="form-label fw-bold mb-0" style="color:var(--brand-primary)">
                                ⚖️ أنواع الدعاوى المصرح بنظرها في هذه الجلسة (مقيدة حصرياً بنوع الدائرة المختارة):
                            </label>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-xs btn-outline-primary" @onclick="SelectAllAllowedCaseTypes" style="font-size:0.7rem">
                                    تحديد الكل
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-secondary" @onclick="DeselectAllCaseTypes" style="font-size:0.7rem">
                                    إلغاء التحديد
                                </button>
                            </div>
                        </div>
                        <div class="p-2 border rounded" style="max-height: 180px; overflow-y: auto; background: var(--surface-hover);">
                            @if (allowedCaseTypesForSelectedCircuit.Count == 0)
                            {
                                <div class="text-muted-color">لا توجد أنواع دعاوى مرتبطة بنوع هذه الدائرة.</div>
                            }
                            else
                            {
                                @foreach (var ct in allowedCaseTypesForSelectedCircuit)
                                {
                                    <div class="d-flex align-center gap-2 mb-1">
                                        <input type="checkbox" id="ct_@ct.Id"
                                               checked="@sessionModel.SelectedCaseTypeIds.Contains(ct.Id)"
                                               @onchange="(e) => ToggleSessionCaseType(ct.Id, e)" />
                                        <label for="ct_@ct.Id" class="m-0" style="cursor:pointer">
                                            <strong>@ct.NameAr</strong>
                                            <span class="text-secondary" style="font-size:0.8rem">(@ct.Code)</span>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    @* 6. سكرتير الجلسة (اختياري - بحث، ربط، تبديل، حذف) *@
                    <div class="form-group mb-3 p-3 border rounded" style="background:var(--surface-ground, #f8fafc);">
                        <label class="form-label fw-bold d-flex align-center justify-between mb-2" style="color:var(--brand-primary)">
                            <span>👨‍💼 سكرتير الجلسة (أمين السر) <span class="text-secondary fw-normal font-monospace" style="font-size:0.8rem">(اختياري)</span></span>
                            @if (sessionModel.EmployeeId.HasValue)
                            {
                                <span class="badge badge-success">تم ربط سكرتير</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">لم يُحدد سكرتير</span>
                            }
                        </label>

                        @if (sessionModel.EmployeeId.HasValue && !isSearchingSecretaryInAdd)
                        {
                            <div class="d-flex align-center justify-between p-2 rounded border bg-white shadow-sm">
                                <div class="d-flex align-center gap-2">
                                    <span style="font-size:1.4rem">👨‍💼</span>
                                    <div>
                                        <strong class="text-primary" style="font-size:0.95rem">@sessionModel.SelectedEmployeeName</strong>
                                        <div class="text-secondary" style="font-size:0.8rem">سكرتير الجلسة المكلف</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartChangeSecretaryInAdd" title="تبديل واختيار سكرتير آخر">
                                        🔄 تبديل
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveSecretaryFromAdd" title="حذف الربط">
                                        🗑️ حذف
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <div class="d-flex gap-2 mb-2">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="🔍 ابحث عن الموظف بالاسم أو الكود..."
                                           @bind="sessionSecretarySearchTerm" @bind:event="oninput" />
                                    @if (sessionModel.EmployeeId.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => isSearchingSecretaryInAdd = false">
                                            إلغاء التبديل
                                        </button>
                                    }
                                </div>

                                <div class="border rounded bg-white" style="max-height:160px; overflow-y:auto;">
                                    @{
                                        var matchingEmps = GetFilteredSecretaries(sessionSecretarySearchTerm).ToList();
                                    }
                                    @if (matchingEmps.Count == 0)
                                    {
                                        <div class="text-muted text-center p-2" style="font-size:0.85rem">
                                            @(string.IsNullOrWhiteSpace(sessionSecretarySearchTerm) ? "اكتب اسم الموظف أو الكود للبحث..." : "لا يوجد موظف مطابق للبحث")
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var emp in matchingEmps)
                                        {
                                            <div class="d-flex align-center justify-between p-2 border-bottom hover-bg"
                                                 style="cursor:pointer;"
                                                 @onclick="() => SelectSecretaryForAdd(emp)">
                                                <div>
                                                    <span class="badge bg-secondary font-monospace me-1">@emp.Code</span>
                                                    <strong>@emp.FullNameAr</strong>
                                                    <span class="text-muted ms-1" style="font-size:0.8rem">(@(emp.JobTitle ?? "أمين سر"))</span>
                                                    @if (!string.IsNullOrEmpty(emp.CourtUnitNameAr))
                                                    {
                                                        <span class="text-secondary ms-2" style="font-size:0.75rem">— @emp.CourtUnitNameAr</span>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-xs btn-primary">
                                                    اختيار ➕
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">إلغاء</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">حفظ الجلسة</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ==================== مودال تعديل جلسة ==================== *@
@if (showEditSessionModal && editingSessionModel is not null)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal" style="max-width: 650px;" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">✏️ تعديل بيانات واختصاص الجلسة: @editingSessionModel.Code</span>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <EditForm Model="editingSessionModel" OnValidSubmit="HandleUpdateSession">
                <div class="modal-body">
