                                        </td>
                                        <td>
                                            <input type="number" class="crim-input" min="0" value="@GetCrimVal("CRIM_EXP_RECALL")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimVal("CRIM_EXP_RECALL", e)' />
