        showReviewDialog = true;
    }

    // ========== Workflow Commands ==========

    private async Task HandleSaveDraft()
    {
        if (matrix is null) return;
        try
        {
            isSubmitting = true;
            statusMessage = null;

            if (IsCriminal)
            {
                var ctIdCrim = caseTypes?.FirstOrDefault()?.Id ?? 1;
                var bIdCrim = yearBands.FirstOrDefault()?.Id ?? 1;

                var openingListCrim = new List<OpeningBalanceValue>
                {
                    new(ctIdCrim, bIdCrim, GetCrimVal("CRIM_PREV"))
                };

                var incomingListCrim = new List<IncomingRowValue>();
                foreach (var it in filteredIncomingTypes)
                {
                    int val = GetCrimVal(it.Code);
                    incomingListCrim.Add(new IncomingRowValue(ctIdCrim, bIdCrim, it.Id, null, val));
                }

                var prodListCrim = new List<ProductionRowValue>();

                // 1. المؤجلات
                foreach (var pt in filteredProductionTypes.Where(p => p.ItemKind == "Deferral"))
                {
                    int count = GetCrimVal(pt.Code);
                    prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, pt.Id, count, null));
                }

                // 2. الأحكام الفئوية والتوزيع على القضاة
                if (IsCriminalPartial && assignedJudges is { Count: > 0 })
                {
                    var singleJudgeId = assignedJudges[0].JudgeId;

                    var catSubst = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_SUBST");
                    if (catSubst != null)
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catSubst.Id, ComputeCrimSubst(), new List<AllocationValue> { new(singleJudgeId, ComputeCrimSubst()) }));

                    var catProc = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_PROC");
                    if (catProc != null)
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catProc.Id, ComputeCrimProc(), new List<AllocationValue> { new(singleJudgeId, ComputeCrimProc()) }));

                    var catOrder = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_ORDER");
                    if (catOrder != null)
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catOrder.Id, ComputeCrimOrder(), new List<AllocationValue> { new(singleJudgeId, ComputeCrimOrder()) }));

                    var catPrep = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_PREP");
                    if (catPrep != null)
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catPrep.Id, ComputeCrimPrep(), new List<AllocationValue> { new(singleJudgeId, ComputeCrimPrep()) }));

                    var catStay = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_STAY");
                    if (catStay != null)
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catStay.Id, ComputeCrimStay(), new List<AllocationValue> { new(singleJudgeId, ComputeCrimStay()) }));

                    var catOther = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_OTHER");
                    if (catOther != null)
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catOther.Id, ComputeCrimOther() + ComputeCustomCrimJudgments(), new List<AllocationValue> { new(singleJudgeId, ComputeCrimOther() + ComputeCustomCrimJudgments()) }));

                    // البنود التفصيلية
                    foreach (var pt in filteredProductionTypes.Where(p => p.ItemKind == "Judgment" && !p.Code.StartsWith("CRIM_CAT_")))
                    {
                        int count = GetCrimVal(pt.Code);
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, pt.Id, count, null));
                    }
                }
                else // المستأنف
                {
                    var catSubst = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_SUBST");
                    if (catSubst != null)
                    {
                        var allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetCrimJudgeAlloc(j.JudgeId, "SUBST"))).ToList();
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catSubst.Id, ComputeCrimSubst(), allocs));
                    }

                    var catProc = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_PROC");
                    if (catProc != null)
                    {
                        var allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetCrimJudgeAlloc(j.JudgeId, "PROC"))).ToList();
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catProc.Id, ComputeCrimProc(), allocs));
                    }

                    var catOrder = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_ORDER");
                    if (catOrder != null)
                    {
                        var allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetCrimJudgeAlloc(j.JudgeId, "ORDER"))).ToList();
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catOrder.Id, ComputeCrimOrder(), allocs));
                    }

                    var catPrep = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_PREP");
                    if (catPrep != null)
                    {
                        var allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetCrimJudgeAlloc(j.JudgeId, "PREP"))).ToList();
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catPrep.Id, ComputeCrimPrep(), allocs));
                    }

                    var catStay = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_STAY");
                    if (catStay != null)
                    {
                        var allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetCrimJudgeAlloc(j.JudgeId, "STAY"))).ToList();
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catStay.Id, ComputeCrimStay(), allocs));
                    }

                    var catExec = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_EXEC");
                    if (catExec != null)
                    {
                        var allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetCrimJudgeAlloc(j.JudgeId, "EXEC"))).ToList();
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catExec.Id, ComputeCrimExec(), allocs));
                    }

                    var catOther = filteredProductionTypes.FirstOrDefault(p => p.Code == "CRIM_CAT_OTHER");
                    if (catOther != null)
                    {
                        var allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetCrimJudgeAlloc(j.JudgeId, "OTHER"))).ToList();
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, catOther.Id, ComputeCrimOther() + ComputeCustomCrimJudgments(), allocs));
                    }

                    // البنود التفصيلية
                    foreach (var pt in filteredProductionTypes.Where(p => p.ItemKind == "Judgment" && !p.Code.StartsWith("CRIM_CAT_")))
                    {
                        int count = GetCrimVal(pt.Code);
                        prodListCrim.Add(new ProductionRowValue(ctIdCrim, bIdCrim, pt.Id, count, null));
                    }
                }

                var judgeJudgmentsListCrim = new List<JudgeJudgmentValue>();
                if (assignedJudges is { Count: > 0 })
                {
                    foreach (var kvp in crimJudgeAlloc)
                    {
                        if (kvp.Value > 0)
                        {
                            judgeJudgmentsListCrim.Add(new JudgeJudgmentValue(
                                kvp.Key.JudgeId,
                                bIdCrim,
                                "CRIM_CAT_" + kvp.Key.Category,
                                kvp.Value
                            ));
                        }
                    }
                }

                var postponementsListCrim = new List<PostponementValue>();
                var nextPeriod = futurePeriods?.FirstOrDefault();
                var crimItemsToSave = new[]
                {
                    new { Code = "CRIM_DEF_GENERAL", Total = ComputeCrimMoajal() },
                    new { Code = "CRIM_DEF_EXPERT",  Total = ComputeCrimPrep() }
                };

                foreach (var item in crimItemsToSave)
                {
                    var laterSum = (futurePeriods != null && futurePeriods.Count > 1)
                        ? futurePeriods.Skip(1).Sum(fp => crimMoajalPeriodDist.GetValueOrDefault((item.Code, fp.Id), 0))
                        : 0;
                    var firstMonthVal = Math.Max(0, item.Total - laterSum);

                    // الشهر التالي مباشرة
                    if (nextPeriod != null && firstMonthVal > 0)
                    {
                        postponementsListCrim.Add(new PostponementValue(
                            bIdCrim,
                            item.Code,
                            nextPeriod.Id,
                            firstMonthVal
                        ));
                    }

                    // الشهور اللاحقة (إن وجدت)
                    if (futurePeriods != null)
                    {
                        foreach (var p in futurePeriods.Skip(1))
                        {
                            var val = crimMoajalPeriodDist.GetValueOrDefault((item.Code, p.Id), 0);
                            if (val > 0)
                            {
                                postponementsListCrim.Add(new PostponementValue(
                                    bIdCrim,
                                    item.Code,
                                    p.Id,
                                    val
                                ));
                            }
                        }
                    }
                }

                var cmdCrim = new SaveStatisticsDataCommand(
                    matrix.Header.Id,
                    matrix.Header.RowVersion,
                    openingListCrim,
                    incomingListCrim,
                    prodListCrim,
                    judgeJudgmentsListCrim,
                    postponementsListCrim
                );

                await StatsService.SaveDraftAsync(cmdCrim, currentUserId);
                lastSavedTime = DateTime.Now.ToString("HH:mm:ss");
                statusMessage = $"تم حفظ المسودة بنجاح الساعة {lastSavedTime}.";
                isError = false;
                await LoadMatrixAsync();
                return;
            }

            var ctId = caseTypes?.FirstOrDefault()?.Id ?? 1;

            var openingList = yearBands.Select(b =>
                new OpeningBalanceValue(ctId, b.Id, GetPreviousBalance(b.Id))).ToList();

            var incomingList = new List<IncomingRowValue>();
            foreach (var b in yearBands)
            {
                foreach (var it in filteredIncomingTypes)
                {
                    var val = GetIncomingByCode(b.Id, it.Code);
                    long? sourcePeriodId = (it.Code == "SHORT") ? GetShortfallPeriod(b.Id) : null;
                    incomingList.Add(new IncomingRowValue(ctId, b.Id, it.Id, sourcePeriodId, val));
                }
            }

            var prodList = new List<ProductionRowValue>();
            foreach (var b in yearBands)
            {
                foreach (var pt in filteredProductionTypes)
                {
                    int count = 0;
                    List<AllocationValue>? allocs = null;

                    if (pt.Code == "PROD_STRIKE") count = GetManualProduction(b.Id, "STRIKE");
                    else if (pt.Code == "PROD_RECUSAL") count = GetManualProduction(b.Id, "RECUSAL_WAIT");
                    else if (pt.Code == "PROD_FINAL_JUDGMENT")
                    {
                        count = ComputeAllJudgesFinal(b.Id);
                        allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, ComputeJudgeFinal(j.JudgeId, b.Id))).ToList();
                    }
                    else if (pt.Code == "PROD_INTERLOCUTORY")
                    {
                        count = ComputeAllJudgesInterloc(b.Id);
                        allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetJudgeDetail(j.JudgeId, b.Id, "INTERLOC"))).ToList();
                    }
                    else if (pt.Code == "PROD_EVIDENCE")
                    {
                        count = ComputeAllJudgesEvidence(b.Id);
                        allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, ComputeJudgeEvidence(j.JudgeId, b.Id))).ToList();
                    }
                    else if (pt.Code == "PROD_STAY")
                    {
                        count = ComputeAllJudgesStay(b.Id);
                        allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, ComputeJudgeStay(j.JudgeId, b.Id))).ToList();
                    }
                    else if (pt.Code == "PROD_INTERRUPT")
                    {
                        count = ComputeAllJudgesInterrupt(b.Id);
                        allocs = assignedJudges?.Select(j => new AllocationValue(j.JudgeId, GetJudgeDetail(j.JudgeId, b.Id, "INTERRUPT"))).ToList();
                    }
                    else if (pt.Code == "PROD_EXTEND") count = ComputeAllJudgesExtend(b.Id);
                    else if (pt.Code == "PROD_REOPEN") count = ComputeAllJudgesReopen(b.Id);
                    else if (pt.Code == "PROD_DEF_RESERVED") count = GetPostponementManual(b.Id, "RESERVED");
                    else if (pt.Code == "PROD_DEF_REPORT") count = GetPostponementManual(b.Id, "FOR_REPORT");
                    else if (pt.Code == "PROD_DEF_OTHER") count = GetPostponementManual(b.Id, "OTHER");
                    else if (pt.Code == "PROD_DEF_EXPERT_RET") count = GetManualProduction(b.Id, "EXPERT_RET");
                    else count = productionValues.GetValueOrDefault((ctId, b.Id, pt.Id), 0);

                    prodList.Add(new ProductionRowValue(ctId, b.Id, pt.Id, count, allocs));
                }
            }

            var judgeJudgmentsList = new List<JudgeJudgmentValue>();
            if (assignedJudges is { Count: > 0 })
            {
                foreach (var kvp in judgeDetailedAllocations)
                {
                    if (kvp.Value > 0)
                    {
                        judgeJudgmentsList.Add(new JudgeJudgmentValue(
                            kvp.Key.JudgeId,
                            kvp.Key.BandId,
                            kvp.Key.Kind,
                            kvp.Value
                        ));
                    }
                }
            }

            var postponementsList = new List<PostponementValue>();
            foreach (var kvp in detailedDistribution)
            {
                if (kvp.Value > 0)
                {
                    postponementsList.Add(new PostponementValue(
                        kvp.Key.BandId,
                        kvp.Key.Kind,
                        kvp.Key.PeriodId,
                        kvp.Value
                    ));
                }
            }

            var cmd = new SaveStatisticsDataCommand(
                matrix.Header.Id,
                matrix.Header.RowVersion,
                openingList,
                incomingList,
                prodList,
                judgeJudgmentsList,
                postponementsList
            );

            await StatsService.SaveDraftAsync(cmd, currentUserId);
            lastSavedTime = DateTime.Now.ToString("HH:mm:ss");
            statusMessage = $"تم حفظ المسودة بنجاح الساعة {lastSavedTime}.";
            isError = false;
            await LoadMatrixAsync();
        }

        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally { isSubmitting = false; }
    }

    private async Task HandleSubmit()
    {
        if (matrix is null) return;
        try
        {
            isSubmitting = true;
            statusMessage = null;

            if (IsCriminal && !IsCrimBalanced)
            {
                statusMessage = "لا يمكن تقديم الإحصائية: الجلسة غير متوازنة (جملة المقدم لا تساوي المؤجل + المحكوم فيه).";
                isError = true;
                return;
            }

            if (IsCriminalAppeal && !IsAllCrimCategoriesBalanced)
            {
                statusMessage = $"لا يمكن تقديم الإحصائية: توزيع الأحكام على القضاة غير متطابق مع المحكوم فيه في ({string.Join("، ", GetCrimUnbalancedCategoryNames())}).";
                isError = true;
                return;
            }

            await HandleSaveDraft();
            await StatsService.SubmitAsync(matrix.Header.Id, matrix.Header.RowVersion, currentUserId);
            statusMessage = "تم تقديم الإحصائية للمراجعة بنجاح.";
            isError = false;
            await LoadMatrixAsync();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally { isSubmitting = false; }
    }

