                                        @* المحكوم فيه *@
                                        <td class="crim-total-cell" style="background:#dcfce7;color:#15803d">
                                            @ComputeCrimMahkoum()
                                        </td>
                                        <td class="crim-total-cell" style="background:#ffedd5;color:#9a3412">
                                            @ComputeCrimSubst()
