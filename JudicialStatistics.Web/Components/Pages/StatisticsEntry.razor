                                        </td>
                                        <td>
                                            <input type="number" class="crim-input" min="0" value="@GetCrimVal("CRIM_DEF_DOC")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimVal("CRIM_DEF_DOC", e)' />
                                        </td>
                                        <td>
