@* نافذة تفصيل توزيع شهور المؤجلات في الجنائي *@
@if (showCrimMonthsModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5);z-index:1050" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" style="direction:rtl">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">📅 تفصيل توزيع المؤجلات على الشهور القادمة (الجنائي)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 mb-3" style="font-size:0.88rem; line-height: 1.6;">
                        ⚖️ <strong>قاعدة العمل المعتمدة بالجنائي:</strong> يتم ترحيل المؤجلات تحت بندين رئيسيين فقط:
                        <br />
                        1. <strong>المؤجلات:</strong> تضم كافة قضايا المؤجل خارج الشهر بجميع أسبابها.
                        <br />
                        2. <strong>أحكام الخبير:</strong> تضم أحكام الإثبات (ندب خبير + إعادة للخبير).
                        <br />
                        ℹ️ افتراضياً، يتم ترحيل الإجمالي إلى الشهر التالي مباشرة (<strong>@(futurePeriods?.FirstOrDefault()?.MonthNameAr ?? "الشهر القادم")</strong>).
                        وعند إدخال قضايا مؤجلة لأشهر لاحقة، تُخصم آلياً من الشهر التالي.
                    </div>

                    @if (futurePeriods == null || futurePeriods.Count == 0)
                    {
                        <div class="text-muted text-center py-3">لا توجد فترات مستقبلية متاحة للعام القضائي الحالي.</div>
                    }
                    else
                    {
                        var periodsToDisplay = futurePeriods.Take(Math.Min(4, futurePeriods.Count)).ToList();
                        var crimItems = new[]
                        {
                            new {
                                Code = "CRIM_DEF_GENERAL",
                                Label = "المؤجلات",
                                Total = ComputeCrimMoajal(),
                                Note = "كافة المؤجلات خارج الشهر (إعلان، ورود تقرير، ضم، أسباب أخرى، حكم، مد أجل، إعادة مرافعة)"
                            },
                            new {
                                Code = "CRIM_DEF_EXPERT",
                                Label = "أحكام الخبير",
                                Total = ComputeCrimPrep(),
                                Note = "أحكام الإثبات (ندب خبير + إعادة للخبير)"
                            }
                        };

                        <div style="overflow-x:auto">
                            <table class="table table-bordered table-sm text-center align-middle" style="font-size:0.88rem">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 250px;">نوع البند المرحل</th>
                                        <th style="width: 120px;">إجمالي العدد</th>
                                        @foreach (var p in periodsToDisplay)
                                        {
                                            <th>@p.MonthNameAr</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in crimItems)
                                    {
                                        var total = item.Total;
                                        var laterSum = periodsToDisplay.Skip(1).Sum(fp => crimMoajalPeriodDist.GetValueOrDefault((item.Code, fp.Id), 0));
                                        var firstMonthVal = Math.Max(0, total - laterSum);

                                        <tr>
                                            <td class="text-end">
                                                <strong class="d-block" style="color:var(--cs-navy)">@item.Label</strong>
                                                <small class="text-muted" style="font-size:0.75rem">@item.Note</small>
                                            </td>
                                            <td class="fw-bold bg-light" style="font-size:1rem">@total</td>
                                            <td class="fw-bold text-primary" style="background:#eff6ff; font-size:1rem">
                                                @firstMonthVal
                                            </td>
                                            @foreach (var p in periodsToDisplay.Skip(1))
                                            {
                                                <td>
                                                    <input type="number" class="form-control form-control-sm text-center mx-auto" style="max-width:75px; font-weight:600" min="0" max="@total"
                                                           value="@crimMoajalPeriodDist.GetValueOrDefault((item.Code, p.Id), 0)"
                                                           @onchange='(e) => {
                                                               if(int.TryParse(e.Value?.ToString(), out var v)) {
                                                                   crimMoajalPeriodDist[(item.Code, p.Id)] = Math.Max(0, Math.Min(item.Total, v));
                                                                   StateHasChanged();
                                                               }
                                                           }' />
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold" style="background:#f8fafc">
                                    <tr>
                                        <td class="text-end">الإجمالي المرحل</td>
                                        <td>@(ComputeCrimMoajal() + ComputeCrimPrep())</td>
                                        <td style="color:#1d4ed8">
                                            @(Math.Max(0, ComputeCrimMoajal() - periodsToDisplay.Skip(1).Sum(fp => crimMoajalPeriodDist.GetValueOrDefault(("CRIM_DEF_GENERAL", fp.Id), 0)))
                                            + Math.Max(0, ComputeCrimPrep() - periodsToDisplay.Skip(1).Sum(fp => crimMoajalPeriodDist.GetValueOrDefault(("CRIM_DEF_EXPERT", fp.Id), 0))))
                                        </td>
                                        @foreach (var p in periodsToDisplay.Skip(1))
                                        {
                                            <td style="color:#1d4ed8">
                                                @(crimMoajalPeriodDist.GetValueOrDefault(("CRIM_DEF_GENERAL", p.Id), 0) + crimMoajalPeriodDist.GetValueOrDefault(("CRIM_DEF_EXPERT", p.Id), 0))
                                            </td>
                                        }
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseModals">✓ اعتماد التوزيع والعودة</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long HeaderId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private long currentUserId = 1;

    private StatisticsMatrixDto? matrix;
    private List<CaseTypeDto>? caseTypes;
    private List<IncomingTypeDto>? incomingTypes;
    private List<ProductionItemTypeDto>? productionTypes;
    private List<CaseYearBandDto> yearBands = new();
    private List<CircuitJudgeAssignmentDto>? assignedJudges;
    private List<StatisticalPeriodDto>? futurePeriods;
    private List<StatisticalPeriodDto>? allPeriods;

    private List<IncomingTypeDto> filteredIncomingTypes = new();
    private List<ProductionItemTypeDto> filteredProductionTypes = new();

    private string activeTab = "incoming";
    private bool isSubmitting = false;
    private string? statusMessage;
    private bool isError = false;
    private string? lastSavedTime;

    private bool IsCriminal => (matrix?.Header.DisciplineCode == StatisticalDisciplines.Criminal)
        || (StatisticalDisciplines.GetEntryFormKind(matrix?.Header.DisciplineCode ?? "") == "Criminal");
    private bool IsFamily => matrix?.Header.DisciplineCode == StatisticalDisciplines.Family;
    private bool IsCriminalPartial => IsCriminal && (matrix?.Header.CircuitKind == "Partial" || matrix?.Header.CircuitNameAr.Contains("جزئي") == true);
    private bool IsCriminalAppeal => IsCriminal && !IsCriminalPartial;

    // بنود وأعمدة الجنائي القياسية والبنود المخصصة الإضافية
    private static readonly HashSet<string> StandardCrimIncomingCodes = new(StringComparer.OrdinalIgnoreCase)
    {
        "CRIM_PREV", "CRIM_RETURN", "CRIM_ACCEL", "CRIM_TRANSFER", "CRIM_NEW", "CRIM_OPP_NEW"
    };

    private static readonly HashSet<string> StandardCrimDeferralCodes = new(StringComparer.OrdinalIgnoreCase)
    {
        "CRIM_DEF_NOTICE", "CRIM_DEF_REP", "CRIM_DEF_DOC", "CRIM_DEF_OTHER", "CRIM_DEF_RES", "CRIM_DEF_EXT", "CRIM_DEF_REARG"
    };

    private static readonly HashSet<string> StandardCrimJudgmentCodes = new(StringComparer.OrdinalIgnoreCase)
    {
        "CRIM_IMPRIS", "CRIM_FINE", "CRIM_ACQUIT", "CRIM_PREV_DEC", "CRIM_EXP_TIME",
        "CRIM_ORDER", "CRIM_CARE",
        "CRIM_RECON", "CRIM_DEATH", "CRIM_OPP_VOID", "CRIM_OPP_INAD", "CRIM_INAD", "CRIM_APP_FORFEIT", "CRIM_ORDER_FINAL", "CRIM_NO_JURIS",
        "CRIM_EXP_NEW", "CRIM_EXP_RECALL",
        "CRIM_SUSP_RECON", "CRIM_SUSP", "CRIM_STAY", "CRIM_RESUME",
        "CRIM_OTHER", "CRIM_CARE_DISMISS"
    };

    private List<IncomingTypeDto> CustomCrimIncomingItems =>
        filteredIncomingTypes?.Where(i => !StandardCrimIncomingCodes.Contains(i.Code)).ToList() ?? new();

    private List<ProductionItemTypeDto> CustomCrimDeferralItems =>
        filteredProductionTypes?.Where(p => p.ItemKind == "Deferral" && !StandardCrimDeferralCodes.Contains(p.Code)).ToList() ?? new();

    private List<ProductionItemTypeDto> CustomCrimJudgmentItems =>
        filteredProductionTypes?.Where(p => p.ItemKind == "Judgment" && !p.Code.StartsWith("CRIM_CAT_") && !StandardCrimJudgmentCodes.Contains(p.Code)).ToList() ?? new();

    // قاموس بيانات الجنائي المباشر حسب الكود
    private Dictionary<string, int> criminalValues = new();

    // قاموس توزيع الأحكام على القضاة في الجنائي: (JudgeId, Category) => Count
    // Categories: SUBST, PROC, ORDER, PREP, STAY, EXEC, OTHER
    private Dictionary<(long JudgeId, string Category), int> crimJudgeAlloc = new();

    // نافذة تعديل توزيع شهور المؤجلات في الجنائي
    private bool showCrimMonthsModal = false;
    private Dictionary<(string Code, long PeriodId), int> crimMoajalPeriodDist = new();

    // Dictionaries for in-memory edits
    private Dictionary<(long CaseTypeId, long BandId), int> openingValues = new();
    private Dictionary<(long CaseTypeId, long BandId, long IncomingTypeId), int> incomingValues = new();
    private Dictionary<(long CaseTypeId, long BandId, long ProductionTypeId), int> productionValues = new();
    private Dictionary<(long JudgeId, string Category), int> judgeAllocations = new();
    private Dictionary<(long CaseTypeId, long BandId, long PeriodId), int> postponementAllocations = new();

    // قاموس بيانات المقدم حسب الكود: (BandId, IncomingTypeCode) => Count
    private Dictionary<(long BandId, string Code), int> incomingByCode = new();

    // الشهر المقصر منه: BandId => PeriodId
    private Dictionary<long, long> shortfallPeriods = new();

    // المؤجلات اليدوية: (BandId, Kind) => Count
    private Dictionary<(long BandId, string Kind), int> manualPostponements = new();

    // تفاصيل أحكام القضاة: (JudgeId, BandId, Kind) => Count
    private Dictionary<(long JudgeId, long BandId, string Kind), int> judgeDetailedAllocations = new();

    // الإنتاج اليدوي: (BandId, Kind) => Count (Kind: STRIKE, RECUSAL_WAIT, EXPERT_RET)
    private Dictionary<(long BandId, string Kind), int> manualProductionValues = new();

    // توزيع المؤجلات على الشهور: (BandId, Kind, PeriodId) => Count
    private Dictionary<(long BandId, string Kind, long PeriodId), int> detailedDistribution = new();

    // إعدادات التوزيع والقضاة
    private int displayedMonthsCount = 3;
    private string activePostponementReason = "INTERLOC_EVID";
    private bool showComprehensivePostponementTable = false;
    private long selectedJudgeId = 0;
    private bool showAllJudges = false;
    private long highlightedBandId = 0;

    // Modals & Validation Issues
    private bool showReviewDialog = false;
    private record ValidationIssue(string Title, string Message, string TargetTab, long BandId = 0, string? TargetReason = null);
    private List<ValidationIssue> validationIssues = new();

    private bool showReviewModal = false;
    private bool isReviewApproval = false;
    private string? reviewComment;
    private bool showReopenModal = false;
    private string? reopenReason;
    private bool isUnauthorized = false;
    private string? unauthorizedMessage;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserIdAsync();
        await LoadMatrixAsync();
    }

    private async Task ResolveCurrentUserIdAsync()
    {
        try
        {
            if (AuthState != null)
            {
                var auth = await AuthState;
                var user = auth.User;
                if (user.Identity?.IsAuthenticated == true)
                {
                    await CourtState.EnsureInitializedAsync(user);
                    if (CourtState.CurrentAppUserId > 0)
                    {
                        currentUserId = CourtState.CurrentAppUserId;
                        return;
                    }

                    var sub = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    var email = user.Identity.Name;

                    using var scope = ScopeFactory.CreateScope();
                    var db = scope.ServiceProvider.GetRequiredService<JudicialStatistics.Infrastructure.Persistence.JudicialDbContext>();
                    var appUser = await db.AppUsers.FirstOrDefaultAsync(u => u.IdentitySubject == sub || u.Email == email);
                    if (appUser != null)
                    {
                        currentUserId = appUser.Id;
                    }
                }
            }
        }
        catch
        {
            if (CourtState.CurrentAppUserId > 0)
            {
                currentUserId = CourtState.CurrentAppUserId;
            }
        }
    }

    private async Task LoadMatrixAsync()
    {
        try
        {
            matrix = await StatsService.GetMatrixByIdAsync(HeaderId, currentUserId);
        caseTypes = await RulesService.GetCaseTypesForSessionVersionAsync(matrix.Header.SessionVersionId);
        incomingTypes = await RulesService.GetIncomingTypesAsync();
        productionTypes = await RulesService.GetProductionItemTypesAsync();

        if (IsCriminal)
        {
            filteredIncomingTypes = incomingTypes.Where(x => x.Code.StartsWith("CRIM_")).OrderBy(x => x.SortOrder).ToList();
            filteredProductionTypes = productionTypes.Where(x => x.Code.StartsWith("CRIM_")).OrderBy(x => x.SortOrder).ToList();
        }
        else if (IsFamily)
        {
            filteredIncomingTypes = incomingTypes.Where(x => !x.Code.StartsWith("CRIM_")).OrderBy(x => x.SortOrder).ToList();
            filteredProductionTypes = productionTypes.Where(x => !x.Code.StartsWith("CRIM_")).OrderBy(x => x.SortOrder).ToList();
        }
        else
        {
            filteredIncomingTypes = incomingTypes.Where(x => !x.Code.StartsWith("CRIM_")).OrderBy(x => x.SortOrder).ToList();
            filteredProductionTypes = productionTypes.Where(x => !x.Code.StartsWith("CRIM_") && x.Code != "ARBITRATORS_APPOINT").OrderBy(x => x.SortOrder).ToList();
        }

        if (caseTypes is { Count: > 0 })
        {
            var policy = await RulesService.GetPolicyForCaseTypeAsync(matrix.Header.JudicialYearId, caseTypes[0].Id);
            if (policy?.Bands is { Count: > 0 })
            {
                yearBands = policy.Bands.OrderBy(b => b.SortOrder).ToList();
            }
        }

        if (yearBands.Count == 0)
        {
            yearBands = new List<CaseYearBandDto>
            {
                new(1, matrix.Header.CaseYearPolicyId, null, null, "AllYears", IsCriminal ? "السنة الإحصائية" : "كافة السنوات", 1)
            };
        }

        allPeriods = await YearsService.GetPeriodsForYearAsync(matrix.Header.JudicialYearId);
        var currentPeriod = allPeriods.FirstOrDefault(p => p.Id == matrix.Header.StatisticalPeriodId);
        if (currentPeriod != null)
        {
            futurePeriods = allPeriods
                .Where(p => p.MonthStartDate > currentPeriod.MonthStartDate)
                .OrderBy(p => p.MonthStartDate)
                .ToList();

            assignedJudges = await OrgService.GetActiveJudgesForSessionMonthAsync(
                matrix.Header.SessionVersionId,
                currentPeriod.MonthStartDate.Year,
                currentPeriod.MonthStartDate.Month
            );
        }

        if (assignedJudges == null || assignedJudges.Count == 0)
        {
            assignedJudges = await OrgService.GetJudgeAssignmentsForSessionVersionAsync(matrix.Header.SessionVersionId);
        }

        if (assignedJudges is { Count: > 0 } && selectedJudgeId == 0)
        {
            selectedJudgeId = assignedJudges[0].JudgeId;
        }

        openingValues.Clear();
        foreach (var ob in matrix.OpeningBalances)
        {
            openingValues[(ob.CaseTypeId, ob.CaseYearBandId)] = ob.Count;
        }

        incomingValues.Clear();
        foreach (var inc in matrix.IncomingRows)
        {
            incomingValues[(inc.CaseTypeId, inc.CaseYearBandId, inc.IncomingTypeId)] = inc.Count;
        }

        productionValues.Clear();
        foreach (var pr in matrix.ProductionRows)
        {
            productionValues[(pr.CaseTypeId, pr.CaseYearBandId, pr.ProductionItemTypeId)] = pr.Count;
        }

        if (IsCriminal)
        {
            criminalValues.Clear();
            var prevBal = matrix.OpeningBalances.Sum(ob => ob.Count);
            criminalValues["CRIM_PREV"] = prevBal;

            foreach (var inc in matrix.IncomingRows)
            {
                var it = filteredIncomingTypes.FirstOrDefault(x => x.Id == inc.IncomingTypeId);
                if (it != null) criminalValues[it.Code] = inc.Count;
            }

            foreach (var pr in matrix.ProductionRows)
            {
                var pt = filteredProductionTypes.FirstOrDefault(x => x.Id == pr.ProductionItemTypeId);
                if (pt != null)
                {
                    criminalValues[pt.Code] = pr.Count;
                    if (pt.Code.StartsWith("CRIM_CAT_") && pr.Allocations is { Count: > 0 })
                    {
                        var catKey = pt.Code switch
                        {
                            "CRIM_CAT_SUBST" => "SUBST",
                            "CRIM_CAT_PROC" => "PROC",
                            "CRIM_CAT_ORDER" => "ORDER",
                            "CRIM_CAT_PREP" => "PREP",
                            "CRIM_CAT_STAY" => "STAY",
                            "CRIM_CAT_EXEC" => "EXEC",
                            "CRIM_CAT_OTHER" => "OTHER",
                            _ => ""
                        };
                        if (!string.IsNullOrEmpty(catKey))
                        {
                            foreach (var al in pr.Allocations)
                            {
                                crimJudgeAlloc[(al.JudgeId, catKey)] = al.Count;
                            }
                        }
                    }
                }
            }

            if (IsCriminalPartial && assignedJudges is { Count: > 0 })
            {
                var jId = assignedJudges[0].JudgeId;
                crimJudgeAlloc[(jId, "SUBST")] = ComputeCrimSubst();
                crimJudgeAlloc[(jId, "PROC")]  = ComputeCrimProc();
                crimJudgeAlloc[(jId, "ORDER")] = ComputeCrimOrder();
                crimJudgeAlloc[(jId, "PREP")]  = ComputeCrimPrep();
                crimJudgeAlloc[(jId, "STAY")]  = ComputeCrimStay();
                crimJudgeAlloc[(jId, "OTHER")] = ComputeCrimOther() + ComputeCustomCrimJudgments();
            }
            else if (IsCriminalAppeal && crimJudgeAlloc.Count == 0)
            {
                AutoDistributeCrimJudges();
            }

            if (activeTab != "audit")
            {
                activeTab = "crim_ledger";
            }

            // تحميل أحكام القضاة والمؤجلات من الجداول الجديدة للجنائي
            foreach (var jj in matrix.JudgeJudgments)
            {
                if (jj.JudgmentKind.StartsWith("CRIM_CAT_"))
                {
                    var catKey = jj.JudgmentKind.Substring("CRIM_CAT_".Length);
                    crimJudgeAlloc[(jj.JudgeId, catKey)] = jj.Count;
                }
            }
            crimMoajalPeriodDist.Clear();
            foreach (var p in matrix.Postponements)
            {
                var code = (p.PostponementKind == "CRIM_DEF_EXPERT" || p.PostponementKind == "CRIM_EXP_NEW" || p.PostponementKind == "CRIM_EXP_RECALL")
                    ? "CRIM_DEF_EXPERT"
                    : "CRIM_DEF_GENERAL";
                var existing = crimMoajalPeriodDist.GetValueOrDefault((code, p.TargetPeriodId), 0);
                crimMoajalPeriodDist[(code, p.TargetPeriodId)] = existing + p.Count;
            }
        }
        else
        {
            // تحميل بيانات المدني والأسرة والعمال
            incomingByCode.Clear();
            shortfallPeriods.Clear();
            foreach (var inc in matrix.IncomingRows)
            {
                var it = filteredIncomingTypes.FirstOrDefault(x => x.Id == inc.IncomingTypeId);
                if (it != null)
                {
                    incomingByCode[(inc.CaseYearBandId, it.Code)] = inc.Count;
                    if (it.Code == "SHORT" && inc.SourcePeriodId.HasValue)
                    {
                        shortfallPeriods[inc.CaseYearBandId] = inc.SourcePeriodId.Value;
                    }
                }
            }

            judgeDetailedAllocations.Clear();
            foreach (var jj in matrix.JudgeJudgments)
            {
                judgeDetailedAllocations[(jj.JudgeId, jj.CaseYearBandId, jj.JudgmentKind)] = jj.Count;
            }

            detailedDistribution.Clear();
            foreach (var p in matrix.Postponements)
            {
                detailedDistribution[(p.CaseYearBandId, p.PostponementKind, p.TargetPeriodId)] = p.Count;
            }

            manualProductionValues.Clear();
            manualPostponements.Clear();
            foreach (var pr in matrix.ProductionRows)
            {
                var pt = filteredProductionTypes.FirstOrDefault(x => x.Id == pr.ProductionItemTypeId);
                if (pt != null)
                {
                    if (pt.Code == "PROD_STRIKE") manualProductionValues[(pr.CaseYearBandId, "STRIKE")] = pr.Count;
                    else if (pt.Code == "PROD_RECUSAL") manualProductionValues[(pr.CaseYearBandId, "RECUSAL_WAIT")] = pr.Count;
                    else if (pt.Code == "PROD_DEF_EXPERT_RET") manualProductionValues[(pr.CaseYearBandId, "EXPERT_RET")] = pr.Count;
                    else if (pt.Code == "PROD_DEF_RESERVED") manualPostponements[(pr.CaseYearBandId, "RESERVED")] = pr.Count;
                    else if (pt.Code == "PROD_DEF_REPORT") manualPostponements[(pr.CaseYearBandId, "FOR_REPORT")] = pr.Count;
                    else if (pt.Code == "PROD_DEF_OTHER") manualPostponements[(pr.CaseYearBandId, "OTHER")] = pr.Count;
                }
            }
        }


        UpdateValidationIssues();
        }
        catch (UnauthorizedAccessException ex)
        {
            isUnauthorized = true;
            unauthorizedMessage = ex.Message;
        }
    }

    private void SetActiveTab(string tab)
    {
