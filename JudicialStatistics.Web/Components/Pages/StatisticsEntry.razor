    // ========== دوال ومعادلات الإحصاء الجنائي (الجنح الجزئي والمستأنف) ==========

    private static readonly string[] JudgeLetters = { "أ", "ب", "ج", "د" };

    private long GetAppealJudgeId(int index)
    {
        if (assignedJudges != null && index < assignedJudges.Count)
            return assignedJudges[index].JudgeId;
        return -(index + 1);
    }

    private string GetAppealJudgeTitle(int index)
    {
        var letter = index < JudgeLetters.Length ? JudgeLetters[index] : $"{index + 1}";
        if (assignedJudges != null && index < assignedJudges.Count)
        {
            var j = assignedJudges[index];
            return $"{letter} ({j.JudgeNameAr})";
        }
        var role = index == 0 ? "رئيس الدائرة" : (index == 1 ? "عضو يمين" : (index == 2 ? "عضو يسار" : "احتياطي"));
        return $"{letter} ({role})";
    }

    private int GetCrimVal(string code) => criminalValues.GetValueOrDefault(code, 0);

    private void SetCrimVal(string code, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            criminalValues[code] = Math.Max(0, val);

            // في الجزئي: التوزيع فوري وتلقائي 100% على القاضي الفردي
            if (IsCriminalPartial && assignedJudges is { Count: > 0 })
            {
                var jId = assignedJudges[0].JudgeId;
                crimJudgeAlloc[(jId, "SUBST")] = ComputeCrimSubst();
                crimJudgeAlloc[(jId, "PROC")]  = ComputeCrimProc();
                crimJudgeAlloc[(jId, "ORDER")] = ComputeCrimOrder();
                crimJudgeAlloc[(jId, "PREP")]  = ComputeCrimPrep();
                crimJudgeAlloc[(jId, "STAY")]  = ComputeCrimStay();
                crimJudgeAlloc[(jId, "OTHER")] = ComputeCrimOther() + ComputeCustomCrimJudgments();
            }
            else if (IsCriminalAppeal)
            {
                // في المستأنف: التوزيع التلقائي بالتساوي مع تمييز رئيس الدائرة بباقي الكسر
                var cat = GetCategoryForCode(code);
                if (cat != null)
                {
                    AutoDistributeCrimJudges(cat);
                }
            }

            UpdateValidationIssues();
            StateHasChanged();
        }
    }

    private string? GetCategoryForCode(string code)
    {
        if (CustomCrimJudgmentItems.Any(p => p.Code == code)) return "OTHER";
        return code switch
        {
            "CRIM_IMPRIS" or "CRIM_FINE" or "CRIM_ACQUIT" or "CRIM_PREV_DEC" or "CRIM_EXP_TIME" => "SUBST",
            "CRIM_ORDER" => "ORDER",
            "CRIM_RECON" or "CRIM_DEATH" or "CRIM_OPP_VOID" or "CRIM_OPP_INAD" or "CRIM_INAD" or "CRIM_APP_FORFEIT" or "CRIM_ORDER_FINAL" or "CRIM_NO_JURIS" => "PROC",
            "CRIM_EXP_NEW" or "CRIM_EXP_RECALL" => "PREP",
            "CRIM_SUSP_RECON" or "CRIM_SUSP" => "STAY",
            "CRIM_STAY" or "CRIM_RESUME" => "EXEC",
            "CRIM_OTHER" or "CRIM_CARE" or "CRIM_CARE_DISMISS" => "OTHER",
            _ => null
        };
    }

    private int GetCrimJudgeAlloc(long judgeId, string cat) => crimJudgeAlloc.GetValueOrDefault((judgeId, cat), 0);

    private void SetCrimJudgeAlloc(long judgeId, string cat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            crimJudgeAlloc[(judgeId, cat)] = Math.Max(0, val);
            UpdateValidationIssues();
            StateHasChanged();
        }
    }

    private void AutoDistributeCrimJudges(string? specificCategory = null)
    {
        var categories = specificCategory != null 
            ? new[] { specificCategory } 
            : new[] { "SUBST", "PROC", "ORDER", "PREP", "STAY", "EXEC", "OTHER" };

        var judgeIds = new List<long>();
        if (assignedJudges is { Count: > 0 })
        {
            judgeIds = assignedJudges.Take(Math.Min(4, assignedJudges.Count)).Select(j => j.JudgeId).ToList();
        }
        else
        {
            judgeIds = new List<long> { -1, -2, -3 };
        }

        int n = Math.Min(3, judgeIds.Count); // الدائرة الثلاثية الأساسية (رئيس، يمين، يسار)
        if (n == 0) return;

        foreach (var cat in categories)
        {
            int total = cat switch
            {
                "SUBST" => ComputeCrimSubst(),
                "PROC"  => ComputeCrimProc(),
                "ORDER" => ComputeCrimOrder(),
                "PREP"  => ComputeCrimPrep(),
                "STAY"  => ComputeCrimStay(),
                "EXEC"  => ComputeCrimExec(),
                "OTHER" => ComputeCrimOther() + ComputeCustomCrimJudgments(),
                _ => 0
            };

            int baseVal = total / n;
            int remainder = total % n;

            for (int i = 0; i < judgeIds.Count; i++)
            {
                var jId = judgeIds[i];
                if (i >= n)
                {
                    // القاضي الرابع (الاحتياطي) لا يوزع عليه تلقائياً إلا إذا عُدل يدوياً
                    crimJudgeAlloc[(jId, cat)] = 0;
                    continue;
                }

                int alloc = baseVal;
                // تمييز رئيس الدائرة بباقي الكسر ثم اليمين ثم اليسار
                if (remainder == 1 && i == 0) alloc += 1;
                else if (remainder == 2 && (i == 0 || i == 1)) alloc += 1;

                crimJudgeAlloc[(jId, cat)] = alloc;
            }
        }
        UpdateValidationIssues();
    }

    // حساب مجاميع الفئات الجنائية
    private int ComputeCrimSubst() =>
        GetCrimVal("CRIM_IMPRIS") + GetCrimVal("CRIM_FINE") + GetCrimVal("CRIM_ACQUIT") + GetCrimVal("CRIM_PREV_DEC") + GetCrimVal("CRIM_EXP_TIME");

    private int ComputeCrimOrder() => GetCrimVal("CRIM_ORDER");

    private int ComputeCrimCare() => GetCrimVal("CRIM_CARE") + GetCrimVal("CRIM_CARE_DISMISS");

    private int ComputeCrimProc() =>
        GetCrimVal("CRIM_RECON") + GetCrimVal("CRIM_DEATH") + GetCrimVal("CRIM_OPP_VOID") + GetCrimVal("CRIM_OPP_INAD") +
        GetCrimVal("CRIM_INAD") + GetCrimVal("CRIM_APP_FORFEIT") + GetCrimVal("CRIM_ORDER_FINAL") + GetCrimVal("CRIM_NO_JURIS");

    private int ComputeCrimPrep() => GetCrimVal("CRIM_EXP_NEW") + GetCrimVal("CRIM_EXP_RECALL");

    private int ComputeCrimStay() => GetCrimVal("CRIM_SUSP_RECON") + GetCrimVal("CRIM_SUSP");

    private int ComputeCrimExec() => GetCrimVal("CRIM_STAY") + GetCrimVal("CRIM_RESUME");

    private int ComputeCrimOther() => GetCrimVal("CRIM_OTHER");

    private int ComputeCustomCrimJudgments() =>
        CustomCrimJudgmentItems.Sum(p => GetCrimVal(p.Code));

    private int ComputeCustomCrimDeferrals() =>
        CustomCrimDeferralItems.Sum(p => GetCrimVal(p.Code));

    private int ComputeCustomCrimIncoming() =>
        CustomCrimIncomingItems.Sum(i => GetCrimVal(i.Code));

    private int ComputeCrimMahkoum() =>
        ComputeCrimSubst() + ComputeCrimOrder() + ComputeCrimCare() + ComputeCrimProc() + ComputeCrimPrep() + ComputeCrimStay() + (IsCriminalAppeal ? ComputeCrimExec() : 0) + ComputeCrimOther() + ComputeCustomCrimJudgments();

    private int ComputeCrimMoajal() =>
        GetCrimVal("CRIM_DEF_NOTICE") + GetCrimVal("CRIM_DEF_REP") + GetCrimVal("CRIM_DEF_DOC") + GetCrimVal("CRIM_DEF_OTHER") +
        GetCrimVal("CRIM_DEF_RES") + GetCrimVal("CRIM_DEF_EXT") + GetCrimVal("CRIM_DEF_REARG") + ComputeCustomCrimDeferrals();

    private int ComputeCrimMuqaddam() =>
        GetCrimVal("CRIM_PREV") + GetCrimVal("CRIM_RETURN") + GetCrimVal("CRIM_ACCEL") + GetCrimVal("CRIM_TRANSFER") +
        GetCrimVal("CRIM_NEW") + GetCrimVal("CRIM_OPP_NEW") + ComputeCustomCrimIncoming();

    private bool IsCrimBalanced => ComputeCrimMuqaddam() == (ComputeCrimMoajal() + ComputeCrimMahkoum());
    private int CrimBalanceDiff => ComputeCrimMuqaddam() - (ComputeCrimMoajal() + ComputeCrimMahkoum());

    // فحص توازن توزيع القضاة في المستأنف
    private int GetCrimJudgeCategoryTotal(string cat)
    {
        if (assignedJudges is { Count: > 0 })
            return assignedJudges.Sum(j => GetCrimJudgeAlloc(j.JudgeId, cat));
        return new[] { -1L, -2L, -3L, -4L }.Sum(jId => GetCrimJudgeAlloc(jId, cat));
    }

    private int GetCrimJudgeCategoryTarget(string cat) => cat switch
    {
        "SUBST" => ComputeCrimSubst(),
        "PROC"  => ComputeCrimProc(),
        "ORDER" => ComputeCrimOrder(),
        "PREP"  => ComputeCrimPrep(),
        "STAY"  => ComputeCrimStay(),
        "EXEC"  => ComputeCrimExec(),
        "OTHER" => ComputeCrimOther() + ComputeCustomCrimJudgments(),
        _ => 0
    };

    private bool IsCrimCategoryBalanced(string cat) =>
        GetCrimJudgeCategoryTotal(cat) == GetCrimJudgeCategoryTarget(cat);

    private bool IsAllCrimCategoriesBalanced =>
        IsCrimCategoryBalanced("SUBST") &&
        IsCrimCategoryBalanced("PROC") &&
        IsCrimCategoryBalanced("ORDER") &&
        IsCrimCategoryBalanced("PREP") &&
        IsCrimCategoryBalanced("STAY") &&
        (!IsCriminalAppeal || IsCrimCategoryBalanced("EXEC")) &&
        IsCrimCategoryBalanced("OTHER");

    private List<string> GetCrimUnbalancedCategoryNames()
    {
        var list = new List<string>();
        if (!IsCrimCategoryBalanced("SUBST")) list.Add("موضوعي");
        if (!IsCrimCategoryBalanced("PROC")) list.Add("إجرائي");
        if (!IsCrimCategoryBalanced("ORDER")) list.Add("أوامر جنائية");
        if (!IsCrimCategoryBalanced("PREP")) list.Add("تمهيدي");
        if (!IsCrimCategoryBalanced("STAY")) list.Add("وقف");
        if (IsCriminalAppeal && !IsCrimCategoryBalanced("EXEC")) list.Add("إشكالات");
        if (!IsCrimCategoryBalanced("OTHER")) list.Add("أخرى");
        return list;
    }

