    /// <summary>
    /// حساب جملة الشكلي - دمج عدم الاختصاص في حكم واحد فقط (FORMAL_INCOMP)
    /// </summary>
    private int ComputeJudgeFormal(long jId, long bId) =>
        GetJudgeDetail(jId, bId, "FORMAL_REJECT") +
        GetJudgeDetail(jId, bId, "FORMAL_INCOMP") +
        GetJudgeDetail(jId, bId, "FORMAL_LAPSE_RIGHT") +
        GetJudgeDetail(jId, bId, "FORMAL_LAPSE_LITIG") +
        GetJudgeDetail(jId, bId, "FORMAL_WAIVE") +
        GetJudgeDetail(jId, bId, "FORMAL_NULL") +
        GetJudgeDetail(jId, bId, "FORMAL_DEEMED_NULL") +
        GetJudgeDetail(jId, bId, "FORMAL_OTHER");

    private int ComputeJudgeSubstantive(long jId, long bId) =>
        GetJudgeDetail(jId, bId, "SUBST_ACCEPT") +
        GetJudgeDetail(jId, bId, "SUBST_REJECT_STATE") +
        GetJudgeDetail(jId, bId, "SUBST_REJECT") +
        GetJudgeDetail(jId, bId, "SUBST_RES_JUDICATA") +
        (IsFamily ? (GetJudgeDetail(jId, bId, "FAM_DIVORCE") + GetJudgeDetail(jId, bId, "FAM_ALIMONY") + GetJudgeDetail(jId, bId, "FAM_CUSTODY") + GetJudgeDetail(jId, bId, "FAM_IMPRISON") + GetJudgeDetail(jId, bId, "FAM_WAGES")) : 0);

    private int ComputeJudgeFinal(long jId, long bId) =>
        ComputeJudgeFormal(jId, bId) + ComputeJudgeSubstantive(jId, bId) + GetJudgeDetail(jId, bId, "SETTLEMENT");

    private int ComputeJudgeEvidence(long jId, long bId) =>
        GetJudgeDetail(jId, bId, "EVID_EXPERT") +
        GetJudgeDetail(jId, bId, "EVID_RE_EXPERT") +
        GetJudgeDetail(jId, bId, "EVID_INVEST") +
        GetJudgeDetail(jId, bId, "EVID_CROSS") +
        GetJudgeDetail(jId, bId, "EVID_OATH") +
        (IsFamily ? GetJudgeDetail(jId, bId, "FAM_ARBITRATORS") : 0);

    private int ComputeJudgeInterlocAndEvidence(long jId, long bId) =>
        GetJudgeDetail(jId, bId, "INTERLOC") + ComputeJudgeEvidence(jId, bId);

    private int ComputeJudgeStay(long jId, long bId) =>
        GetJudgeDetail(jId, bId, "STAY_PENAL") +
        GetJudgeDetail(jId, bId, "STAY_COND") +
        GetJudgeDetail(jId, bId, "STAY_AGREE");

    private int ComputeJudgeTotalDetailedAllocation(long jId, long bId) =>
        ComputeJudgeFinal(jId, bId) +
        ComputeJudgeInterlocAndEvidence(jId, bId) +
        ComputeJudgeStay(jId, bId) +
        GetJudgeDetail(jId, bId, "INTERRUPT");

    // ========== تجميع أحكام القضاة لكشف الإنتاج ==========

    private int ComputeAllJudgesDetail(long bId, string kind) =>
        assignedJudges?.Sum(j => GetJudgeDetail(j.JudgeId, bId, kind)) ?? 0;

    private int ComputeAllJudgesFormal(long bId) =>
        assignedJudges?.Sum(j => ComputeJudgeFormal(j.JudgeId, bId)) ?? 0;

    private int ComputeAllJudgesSubstantive(long bId) =>
        assignedJudges?.Sum(j => ComputeJudgeSubstantive(j.JudgeId, bId)) ?? 0;

    private int ComputeAllJudgesSettlement(long bId) =>
        assignedJudges?.Sum(j => GetJudgeDetail(j.JudgeId, bId, "SETTLEMENT")) ?? 0;

    private int ComputeAllJudgesFinal(long bId) =>
        ComputeAllJudgesFormal(bId) + ComputeAllJudgesSubstantive(bId) + ComputeAllJudgesSettlement(bId);

    private int ComputeAllJudgesInterloc(long bId) =>
        assignedJudges?.Sum(j => GetJudgeDetail(j.JudgeId, bId, "INTERLOC")) ?? 0;

    private int ComputeAllJudgesEvidence(long bId) =>
        assignedJudges?.Sum(j => ComputeJudgeEvidence(j.JudgeId, bId)) ?? 0;

    private int ComputeAllJudgesInterlocAndEvidence(long bId) =>
        ComputeAllJudgesInterloc(bId) + ComputeAllJudgesEvidence(bId);

    private int ComputeAllJudgesStay(long bId) =>
        assignedJudges?.Sum(j => ComputeJudgeStay(j.JudgeId, bId)) ?? 0;

    private int ComputeAllJudgesInterrupt(long bId) =>
        assignedJudges?.Sum(j => GetJudgeDetail(j.JudgeId, bId, "INTERRUPT")) ?? 0;

    private int ComputeAllJudgesExtend(long bId) =>
        assignedJudges?.Sum(j => GetJudgeDetail(j.JudgeId, bId, "EXTEND_JUDGMENT")) ?? 0;

    private int ComputeAllJudgesReopen(long bId) =>
        assignedJudges?.Sum(j => GetJudgeDetail(j.JudgeId, bId, "RETURN_PLEADING")) ?? 0;

    private int ComputeAllJudgesReturnAppeal(long bId) =>
        assignedJudges?.Sum(j => GetJudgeDetail(j.JudgeId, bId, "RETURN_APPEAL_IND")) ?? 0;

    private int ComputeAllJudgesTotalJudged(long bId) =>
        ComputeAllJudgesFinal(bId) +
        ComputeAllJudgesInterlocAndEvidence(bId) +
        ComputeAllJudgesStay(bId) +
        ComputeAllJudgesInterrupt(bId);

