                                    @* 3. مجدد من الشطب *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@renew"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "RENEW", e)' />
                                        }
                                        else { <span class="cs-computed">@renew</span> }
                                    </td>

                                    @* 4. لحين الفصل في طلب الرد *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@recusal"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "RECUSAL_WAIT", e)' />
                                        }
                                        else { <span class="cs-computed">@recusal</span> }
                                    </td>

                                    @* 5. جزائي *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@accelP"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "ACCEL_PENAL", e)' />
                                        }
                                        else { <span class="cs-computed">@accelP</span> }
                                    </td>

                                    @* 6. تعليقي *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@accelS"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "ACCEL_SUSP", e)' />
                                        }
                                        else { <span class="cs-computed">@accelS</span> }
                                    </td>

                                    @* 7. اتفاقي *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@accelA"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "ACCEL_AGREE", e)' />
                                        }
                                        else { <span class="cs-computed">@accelA</span> }
                                    </td>

                                    @* 8. معجل من الانقطاع *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@accelI"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "ACCEL_INTERRUPT", e)' />
                                        }
                                        else { <span class="cs-computed">@accelI</span> }
                                    </td>

                                    @* 9. معاد من الاستئناف *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@retApp"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "RETURN_APPEAL", e)' />
                                        }
                                        else { <span class="cs-computed">@retApp</span> }
                                    </td>

                                    @* 10. عدد الدعاوى المقصرة *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@shortV"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "SHORT", e)' />
                                        }
                                        else { <span class="cs-computed">@shortV</span> }
                                    </td>

                                    @* 11. الشهر المقصر منه *@
                                    <td>
                                        @if (matrix.CanEdit && allPeriods != null)
                                        {
                                            <select class="form-control form-control-sm text-center cs-select-compact"
                                                    value="@GetShortfallPeriod(band.Id)"
                                                    @onchange="(e) => SetShortfallPeriod(band.Id, e)">
                                                <option value="">-- اختر --</option>
                                                @foreach (var p in GetAllPeriods())
                                                {
                                                    <option value="@p.Id">@p.MonthNameAr</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <span style="font-size:12px">@GetShortfallPeriodName(band.Id)</span>
                                        }
                                    </td>

                                    @* 12. إحالة من الدائرة (خصم) *@
                                    <td style="background:#fff5f5">
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   style="color:#b91c1c;border-color:#fca5a5"
                                                   value="@transF"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "TRANSFER_FROM", e)' />
                                        }
                                        else { <span class="cs-computed" style="color:#b91c1c">@transF</span> }
                                    </td>

                                    @* 13. إحالة إلى الدائرة (إضافة) *@
                                    <td style="background:#f0fdf4">
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   style="color:#166534;border-color:#86efac"
                                                   value="@transTo"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "TRANSFER_TO", e)' />
                                        }
                                        else { <span class="cs-computed" style="color:#166534">@transTo</span> }
                                    </td>

                                    @* 14. الجديد *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@newV"
                                                   @onchange='(e) => SetIncomingByCode(band.Id, "NEW", e)' />
                                        }
                                        else { <span class="cs-computed">@newV</span> }
                                    </td>

                                    @* 15. جملة المقدم (أقصى اليسار) *@
                                    <td class="cs-total-cell" style="background:#f0f7ff;color:#0369a1;font-weight:700">@jumlaMuq</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>الإجمالي</td>
                                <td class="cs-computed" style="background:#fdecdb;font-weight:700">@yearBands.Sum(b => GetPreviousBalance(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "RENEW"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "RECUSAL_WAIT"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "ACCEL_PENAL"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "ACCEL_SUSP"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "ACCEL_AGREE"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "ACCEL_INTERRUPT"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "RETURN_APPEAL"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "SHORT"))</td>
                                <td>-</td>
                                <td class="cs-computed" style="color:#b91c1c">@yearBands.Sum(b => GetIncomingByCode(b.Id, "TRANSFER_FROM"))</td>
                                <td class="cs-computed" style="color:#166534">@yearBands.Sum(b => GetIncomingByCode(b.Id, "TRANSFER_TO"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetIncomingByCode(b.Id, "NEW"))</td>
                                <td class="cs-total-cell" style="background:#e0f2fe;font-weight:700">@yearBands.Sum(b => ComputeJumlaMuqaddam(b.Id))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="cs-panel-foot">
                    <span>💡 <strong>معادلة جملة المقدم:</strong> السابق + مجدد من الشطب + المعجل من الوقف (طلب الرد، جزائي، تعليقي، اتفاقي) + معجل انقطاع + معاد استئناف + عدد الدعاوى المقصرة − إحالة من الدائرة + إحالة إلى الدائرة + الجديد</span>
                    <span>الرصيد السابق محسوب ومعتمد من قاعدة البيانات</span>
                </div>
            }

            @* -------------------- تبويب 2: كشف الإنتاج والمحكوم فيه والمؤجلات -------------------- *@
            @if (activeTab == "production")
            {
                <div class="cs-panel-head">
                    <div>
                        <h2>كشف الإنتاج والمحكوم فيه والمؤجلات — @matrix.Header.PeriodMonthNameAr</h2>
                        <p>الشطب وطلب الرد والمؤجلات إدخال يدوي. باقي الأحكام مجمعة آلياً من أحكام القضاة.</p>
                    </div>
                    <div class="cs-input-legend">
                        <i/> خانات الإدخال
                    </div>
                </div>

                <div style="overflow-x:auto;padding:0">
                    <table class="cs-ledger" style="min-width:1750px;direction:rtl">
                        <thead>
                            <tr class="group-head">
                                <th rowspan="2" style="width:115px">سنة القيد</th>
                                <th rowspan="2" class="incoming-group">جملة المقدم</th>
                                <th rowspan="2" style="background:#e0f7fa;color:#006064">الشطب</th>
                                <th rowspan="2" style="background:#eef2ff;color:#3730a3">وقف طلب الرد</th>
                                <th colspan="4" style="background:#e8f5e9;color:#1e3a1e">الأحكام القطعية</th>
                                <th rowspan="2" style="background:#f1f5f9;color:#334155">أحكام فرعية</th>
                                <th colspan="6" style="background:#fef3c7;color:#92400e">أحكام الإثبات</th>
                                <th colspan="4" style="background:#fffbeb;color:#b45309">الوقف</th>
                                <th rowspan="2" style="background:#ffedd5;color:#9a3412">انقطاع سير الخصومة</th>
                                <th rowspan="2" style="background:#126d69;color:#fff;font-weight:700">المحكوم فيه</th>
                                <th colspan="6" class="outgoing-group">المؤجل دون أحكام</th>
                                <th rowspan="2" style="background:#f8fafc;color:#475569;font-weight:600" title="بيان إحصائي مستقل للعلم والإحاطة، لا يدخل في المؤجلات ولا في حسابات الموازنة">معاد من الخبراء (بيان مستقل)</th>
                                <th rowspan="2" style="background:#152c49;color:#fff;font-weight:700">جملة الخارج</th>
                                <th rowspan="2" style="width:95px">حالة الصف</th>
                            </tr>
                            <tr>
                                @* قطعية *@
                                <th>شكلي</th>
                                <th>موضوعي</th>
                                <th>صلح</th>
                                <th style="background:#dcfce7;color:#166534">جملة القطعية</th>
                                @* إثبات *@
                                <th>ندب خبير</th>
                                <th>إعادة خبير</th>
                                <th>تحقيق</th>
                                <th>استجواب</th>
                                <th>حلف يمين</th>
                                <th style="background:#fde68a;color:#854d0e">جملة الإثبات</th>
                                @* وقف *@
                                <th>جزائي</th>
                                <th>تعليقي</th>
                                <th>اتفاقي</th>
                                <th style="background:#fef3c7;color:#78350f">جملة الوقف</th>
                                @* مؤجلات *@
                                <th>محجوز للحكم</th>
                                <th>مد أجل 🔒</th>
                                <th>إعادة مرافعة 🔒</th>
                                <th>مؤجل للتقرير</th>
                                <th>أسباب أخرى</th>
                                <th style="background:#d1fae5;color:#065f46">جملة المؤجل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var band in yearBands)
                            {
                                var bId = band.Id;
                                var inc = ComputeJumlaMuqaddam(bId);
                                var strike = GetManualProduction(bId, "STRIKE");
                                var recusalWait = GetManualProduction(bId, "RECUSAL_WAIT");
                                var formal = ComputeAllJudgesFormal(bId);
                                var substantive = ComputeAllJudgesSubstantive(bId);
                                var settlement = ComputeAllJudgesSettlement(bId);
                                var finalTotal = formal + substantive + settlement;
                                var interloc = ComputeAllJudgesInterloc(bId);
                                var expert = ComputeAllJudgesDetail(bId, "EVID_EXPERT");
                                var reExpert = ComputeAllJudgesDetail(bId, "EVID_RE_EXPERT");
                                var invest = ComputeAllJudgesDetail(bId, "EVID_INVEST");
                                var cross = ComputeAllJudgesDetail(bId, "EVID_CROSS");
                                var oath = ComputeAllJudgesDetail(bId, "EVID_OATH");
                                var evidTotal = ComputeAllJudgesEvidence(bId);
                                var stayPenal = ComputeAllJudgesDetail(bId, "STAY_PENAL");
                                var stayCond = ComputeAllJudgesDetail(bId, "STAY_COND");
                                var stayAgree = ComputeAllJudgesDetail(bId, "STAY_AGREE");
                                var stayTotal = ComputeAllJudgesStay(bId);
                                var interrupt = ComputeAllJudgesDetail(bId, "INTERRUPT");
                                var totalJudged = ComputeAllJudgesTotalJudged(bId);

                                var reserved = GetPostponementManual(bId, "RESERVED");
                                var extend = ComputeAllJudgesExtend(bId);
                                var reopen = ComputeAllJudgesReopen(bId);
                                var report = GetPostponementManual(bId, "FOR_REPORT");
                                var other = GetPostponementManual(bId, "OTHER");
                                var totalDef = ComputeTotalPostponements(bId);
                                var retExpert = GetManualProduction(bId, "EXPERT_RET");

                                var outgoing = ComputeRowOutgoing(bId);
                                var diff = inc - outgoing;
                                var isRowErr = diff != 0;

                                <tr data-band="@band.Id" class="@(isRowErr ? "row-error" : "") @(highlightedBandId == band.Id ? "highlight-row" : "")">
                                    <td>
                                        <span class="cs-year-main">@band.LabelAr</span>
                                    </td>
                                    @* جملة المقدم مع رابط الانتقال *@
                                    <td class="cs-total-cell" style="background:#f0f7ff">
                                        <button type="button" class="cs-derived-link" title="انتقال لتفاصيل المقدم" @onclick='() => SetActiveTab("incoming")'>
                                            @inc
                                        </button>
                                    </td>
                                    @* الشطب *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@strike"
                                                   @onchange='(e) => SetManualProduction(bId, "STRIKE", e)' />
                                        } else { <span class="cs-computed">@strike</span> }
                                    </td>
                                    @* وقف طلب الرد *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@recusalWait"
                                                   @onchange='(e) => SetManualProduction(bId, "RECUSAL_WAIT", e)' />
                                        } else { <span class="cs-computed">@recusalWait</span> }
                                    </td>
                                    @* قطعية *@
                                    <td class="cs-computed">@formal</td>
                                    <td class="cs-computed">@substantive</td>
                                    <td class="cs-computed">@settlement</td>
                                    <td class="cs-computed" style="background:#f0fdf4;color:#15803d;font-weight:700">@finalTotal</td>
                                    @* فرعية *@
                                    <td class="cs-computed">@interloc</td>
                                    @* إثبات *@
                                    <td class="cs-computed">@expert</td>
                                    <td class="cs-computed">@reExpert</td>
                                    <td class="cs-computed">@invest</td>
                                    <td class="cs-computed">@cross</td>
                                    <td class="cs-computed">@oath</td>
                                    <td class="cs-computed" style="background:#fef3c7;color:#b45309;font-weight:700">@evidTotal</td>
                                    @* وقف *@
                                    <td class="cs-computed">@stayPenal</td>
                                    <td class="cs-computed">@stayCond</td>
                                    <td class="cs-computed">@stayAgree</td>
                                    <td class="cs-computed" style="background:#fffbeb;color:#92400e;font-weight:700">@stayTotal</td>
                                    @* انقطاع *@
                                    <td class="cs-computed">@interrupt</td>
                                    @* المحكوم فيه *@
                                    <td class="cs-total-cell" style="background:#eaf5f3;color:#126d69">
                                        <button type="button" class="cs-derived-link" title="انتقال لتفاصيل أحكام القضاة" @onclick='() => SetActiveTab("judges")'>
                                            @totalJudged
                                        </button>
                                    </td>
                                    @* مؤجلات *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@reserved"
                                                   @onchange='(e) => SetPostponementManual(bId, "RESERVED", e)' />
                                        } else { <span class="cs-computed">@reserved</span> }
                                    </td>
                                    <td class="cs-computed" style="background:#f8fafc">
                                        <button type="button" class="cs-derived-link" title="محسوب من بيان القضاة" @onclick='() => SetActiveTab("judges")'>
                                            @extend
                                        </button>
                                    </td>
                                    <td class="cs-computed" style="background:#f8fafc">
                                        <button type="button" class="cs-derived-link" title="محسوب من بيان القضاة" @onclick='() => SetActiveTab("judges")'>
                                            @reopen
                                        </button>
                                    </td>
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@report"
                                                   @onchange='(e) => SetPostponementManual(bId, "FOR_REPORT", e)' />
                                        } else { <span class="cs-computed">@report</span> }
                                    </td>
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@other"
                                                   @onchange='(e) => SetPostponementManual(bId, "OTHER", e)' />
                                        } else { <span class="cs-computed">@other</span> }
                                    </td>
                                    <td class="cs-computed" style="background:#ecfdf5;color:#047857;font-weight:700">@totalDef</td>
                                    @* معاد خبراء *@
                                    <td>
                                        @if (matrix.CanEdit)
                                        {
                                            <input type="number" class="cs-cell-input" min="0"
                                                   value="@retExpert"
                                                   @onchange='(e) => SetManualProduction(bId, "EXPERT_RET", e)' />
                                        } else { <span class="cs-computed">@retExpert</span> }
                                    </td>
                                    @* جملة الخارج *@
                                    <td class="cs-total-cell" style="background:#f1f5f9;color:#0f172a">@outgoing</td>
                                    @* حالة الصف *@
                                    <td>
                                        @if (diff == 0)
                                        {
                                            <span class="cs-diff-good">✓ متزن</span>
                                        }
                                        else
                                        {
                                            <span class="cs-diff-bad">
                                                @(diff > 0 ? $"ناقص {diff}" : $"زائد {Math.Abs(diff)}")
                                            </span>
                                            <span class="cs-row-error-note">عدم توازن</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>الإجمالي</td>
                                <td class="cs-total-cell">@yearBands.Sum(b => ComputeJumlaMuqaddam(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetManualProduction(b.Id, "STRIKE"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetManualProduction(b.Id, "RECUSAL_WAIT"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesFormal(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesSubstantive(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesSettlement(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesFinal(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesInterloc(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "EVID_EXPERT"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "EVID_RE_EXPERT"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "EVID_INVEST"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "EVID_CROSS"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "EVID_OATH"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesEvidence(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "STAY_PENAL"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "STAY_COND"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "STAY_AGREE"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesStay(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesDetail(b.Id, "INTERRUPT"))</td>
                                <td class="cs-total-cell" style="background:#eaf5f3;color:#126d69">@yearBands.Sum(b => ComputeAllJudgesTotalJudged(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetPostponementManual(b.Id, "RESERVED"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesExtend(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeAllJudgesReopen(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetPostponementManual(b.Id, "FOR_REPORT"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetPostponementManual(b.Id, "OTHER"))</td>
                                <td class="cs-computed">@yearBands.Sum(b => ComputeTotalPostponements(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetManualProduction(b.Id, "EXPERT_RET"))</td>
                                <td class="cs-total-cell">@ComputeTotalOutgoing()</td>
                                <td>
                                    @{ var totalDiff = ComputeTotalIncoming() - ComputeTotalOutgoing(); }
                                    @if (totalDiff == 0)
                                    {
                                        <span class="cs-diff-good">✓ متزن</span>
                                    }
                                    else
                                    {
                                        <span class="cs-diff-bad">فرق @totalDiff</span>
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="cs-panel-foot">
                    <span>💡 <strong>قاعدة التوازن:</strong> جملة المقدم = المحكوم فيه + الشطب وطلب الرد + جملة المؤجل</span>
                    <span>الأحكام الفرعية والإثبات ضمن المحكوم فيه، وتُوزع على الشهور لأن الدعوى مستمرة</span>
                </div>
            }

            @* -------------------- تبويب 3: توزيع أحكام القضاة -------------------- *@
            @if (activeTab == "judges")
            {
                @if (assignedJudges == null || assignedJudges.Count == 0)
                {
                    <div class="alert alert-warning m-4">⚠️ لم يتم تسجيل قضاة لهذه الدائرة في التشكيل القضائي لهذا العام.</div>
                }
                else
                {
                    @* شريط اختيار القضاة الأنيق (Judge Selection Bar) *@
                    <div class="cs-judge-tabs-bar">
                        @foreach (var judge in assignedJudges)
                        {
                            var jId = judge.JudgeId;
                            var jTotal = yearBands.Sum(b => ComputeJudgeTotalDetailedAllocation(jId, b.Id));
                            var isSelected = (selectedJudgeId == jId) && !showAllJudges;

                            <button type="button" class="cs-judge-btn @(isSelected ? "active" : "")"
                                    @onclick="() => SelectJudge(jId)">
                                <div class="cs-judge-identity">
                                    <strong>@judge.JudgeNameAr</strong>
                                    <small>@judge.JudicialRoleNameAr @(!string.IsNullOrWhiteSpace(judge.Notes) ? $"• {judge.Notes}" : "")</small>
                                </div>
                                <div class="cs-judge-count">
                                    <span>أحكام</span>
                                    <strong>@jTotal</strong>
                                </div>
                            </button>
                        }

                        <button type="button" class="btn btn-sm @(showAllJudges ? "btn-primary" : "btn-outline-secondary")"
                                style="align-self:center;margin-inline-start:auto;height:42px"
                                @onclick="ToggleShowAllJudges">
                            @(showAllJudges ? "عرض القاضي المحدد فقط" : "عرض كافة القضاة معاً")
                        </button>
                    </div>

                    var judgesToDisplay = showAllJudges ? assignedJudges : assignedJudges.Where(j => j.JudgeId == selectedJudgeId).ToList();
                    if (judgesToDisplay.Count == 0) judgesToDisplay = assignedJudges.Take(1).ToList();

                    @foreach (var judge in judgesToDisplay)
                    {
                        var jId = judge.JudgeId;
                        <div class="p-3 d-flex justify-between align-center" style="background:#f8fafc;border-bottom:1px solid #e2e8f0">
                            <div>
                                <span class="badge badge-primary me-2">@judge.JudicialRoleNameAr</span>
                                <strong style="font-size:15px;color:var(--cs-navy)">@judge.JudgeNameAr</strong>
                            </div>
                            <div>
                                <span class="text-muted" style="font-size:13px">إجمالي إنتاج القاضي: </span>
                                <strong class="badge badge-success" style="font-size:14px">
                                    @yearBands.Sum(b => ComputeJudgeTotalDetailedAllocation(jId, b.Id))
                                </strong>
                            </div>
                        </div>

                        <div style="overflow-x:auto;padding:0">
                            <table class="cs-ledger" style="min-width:2050px;direction:rtl;font-size:13px">
                                <thead>
                                    <tr class="group-head">
                                        <th rowspan="2" style="width:115px">سنة القيد</th>
                                        <th colspan="9" style="background:#e0f2fe;color:#0369a1">أحكام قطعية شكلية</th>
                                        <th colspan="@(IsFamily ? 10 : 5)" style="background:#dcfce7;color:#166534">أحكام قطعية موضوعية</th>
                                        <th colspan="1" style="background:#fef9c3;color:#854d0e">صلح</th>
                                        <th rowspan="2" style="background:#fee2e2;color:#991b1b;font-weight:700">جملة القطعية</th>
                                        <th colspan="1" style="background:#f1f5f9;color:#334155">فرعية</th>
                                        <th colspan="@(IsFamily ? 7 : 6)" style="background:#f3e8fa;color:#6b21a8">أحكام الإثبات</th>
                                        <th rowspan="2" style="background:#ede9fe;color:#5b21b6;font-weight:700">جملة ف.+إثبات</th>
                                        <th colspan="4" style="background:#fef3c7;color:#92400e">أحكام الوقف</th>
                                        <th rowspan="2" style="background:#ffedd5;color:#9a3412">انقطاع</th>
                                        <th colspan="2" style="background:#e0e7ff;color:#3730a3">بيان مستقل (للمؤجلات)</th>
                                        <th rowspan="2" style="background:#f3f4f6;color:#4b5563">معاد استئناف</th>
                                        <th rowspan="2" style="background:#152c49;color:#fff;font-weight:700">إجمالي الإنتاج</th>
                                    </tr>
                                    <tr>
                                        @* شكلية: عدم اختصاص حكم واحد فقط *@
                                        <th>عدم قبول</th>
                                        <th style="background:#bae6fd;color:#0284c7;font-weight:700">عدم اختصاص</th>
                                        <th>سقوط الحق</th>
                                        <th>سقوط الخصومة</th>
                                        <th>ترك الخصومة</th>
                                        <th>انعدام الخصومة</th>
                                        <th>كأن لم تكن</th>
                                        <th>شكلية أخرى</th>
                                        <th style="background:#bae6fd;color:#0369a1;font-weight:700">جملة الشكلي</th>

                                        @* موضوعية *@
                                        <th>قبول</th>
                                        <th>رفض بحالتها</th>
                                        <th>رفض</th>
                                        <th>ع.جواز الفصل</th>
                                        @if (IsFamily)
                                        {
                                            <th>تطليق (خلع/ضرر)</th>
                                            <th>نفقات ومصروفات</th>
                                            <th>حضانة ورؤية</th>
                                            <th>حبس لامتناع سداد</th>
                                            <th>أجور ونفقات</th>
                                        }
                                        <th style="background:#bbf7d0;color:#15803d;font-weight:700">جملة الموضوعي</th>

                                        @* صلح *@
                                        <th>الصلح</th>

                                        @* فرعي *@
                                        <th>فرعي/تمهيدي</th>

                                        @* إثبات *@
                                        <th>ندب خبير</th>
                                        <th>إعادة خبير</th>
                                        <th>تحقيق</th>
                                        <th>استجواب</th>
                                        <th>حلف يمين</th>
                                        @if (IsFamily)
                                        {
                                            <th>ندب حكمين</th>
                                        }
                                        <th style="background:#e9d5ff;color:#6b21a8;font-weight:700">جملة الإثبات</th>

                                        @* وقف *@
                                        <th>وقف جزائي</th>
                                        <th>وقف تعليقي</th>
                                        <th>وقف اتفاقي</th>
                                        <th style="background:#fde68a;color:#78350f;font-weight:700">جملة الوقف</th>

                                        @* بيان مستقل *@
                                        <th>مد الأجل</th>
                                        <th>إعادة للمرافعة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var band in yearBands)
                                    {
                                        var bId = band.Id;
                                        <tr data-band="@band.Id" class="@(highlightedBandId == band.Id ? "highlight-row" : "")">
                                            <td>
                                                <span class="cs-year-main">@band.LabelAr</span>
                                            </td>

                                            @* شكلية (مع عمود واحد فقط لعدم الاختصاص FORMAL_INCOMP) *@
                                            @foreach (var kind in new[]{ "FORMAL_REJECT", "FORMAL_INCOMP", "FORMAL_LAPSE_RIGHT", "FORMAL_LAPSE_LITIG", "FORMAL_WAIVE", "FORMAL_NULL", "FORMAL_DEEMED_NULL", "FORMAL_OTHER" })
                                            {
                                                var k = kind;
                                                <td>
                                                    @if (matrix.CanEdit)
                                                    {
                                                        <input type="number" class="cs-cell-input" min="0"
                                                               value="@GetJudgeDetail(jId, bId, k)"
                                                               @onchange="(e) => SetJudgeDetail(jId, bId, k, e)" />
                                                    } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, k)</span> }
                                                </td>
                                            }
                                            <td class="cs-computed" style="background:#e0f2fe;color:#0369a1;font-weight:700">@ComputeJudgeFormal(jId, bId)</td>

                                            @* موضوعية *@
                                            @foreach (var kind in new[]{ "SUBST_ACCEPT", "SUBST_REJECT_STATE", "SUBST_REJECT", "SUBST_RES_JUDICATA" })
                                            {
                                                var k = kind;
                                                <td>
                                                    @if (matrix.CanEdit)
                                                    {
                                                        <input type="number" class="cs-cell-input" min="0"
                                                               value="@GetJudgeDetail(jId, bId, k)"
                                                               @onchange="(e) => SetJudgeDetail(jId, bId, k, e)" />
                                                    } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, k)</span> }
                                                </td>
                                            }
                                            @if (IsFamily)
                                            {
                                                @foreach (var kind in new[]{ "FAM_DIVORCE", "FAM_ALIMONY", "FAM_CUSTODY", "FAM_IMPRISON", "FAM_WAGES" })
                                                {
                                                    var k = kind;
                                                    <td>
                                                        @if (matrix.CanEdit)
                                                        {
                                                            <input type="number" class="cs-cell-input" min="0"
                                                                   value="@GetJudgeDetail(jId, bId, k)"
                                                                   @onchange="(e) => SetJudgeDetail(jId, bId, k, e)" />
                                                        } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, k)</span> }
                                                    </td>
                                                }
                                            }
                                            <td class="cs-computed" style="background:#dcfce7;color:#15803d;font-weight:700">@ComputeJudgeSubstantive(jId, bId)</td>

                                            @* صلح *@
                                            @{ var kSettlement = "SETTLEMENT"; }
                                            <td>
                                                @if (matrix.CanEdit)
                                                {
                                                    <input type="number" class="cs-cell-input" min="0"
                                                           value="@GetJudgeDetail(jId, bId, kSettlement)"
                                                           @onchange="(e) => SetJudgeDetail(jId, bId, kSettlement, e)" />
                                                } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, kSettlement)</span> }
                                            </td>

                                            @* جملة القطعية *@
                                            <td class="cs-computed" style="background:#fee2e2;color:#991b1b;font-weight:700">@ComputeJudgeFinal(jId, bId)</td>

                                            @* فرعي *@
                                            @{ var kInterloc = "INTERLOC"; }
                                            <td>
                                                @if (matrix.CanEdit)
                                                {
                                                    <input type="number" class="cs-cell-input" min="0"
                                                           value="@GetJudgeDetail(jId, bId, kInterloc)"
                                                           @onchange="(e) => SetJudgeDetail(jId, bId, kInterloc, e)" />
                                                } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, kInterloc)</span> }
                                            </td>

                                            @* إثبات *@
                                            @foreach (var kind in new[]{ "EVID_EXPERT", "EVID_RE_EXPERT", "EVID_INVEST", "EVID_CROSS", "EVID_OATH" })
                                            {
                                                var k = kind;
                                                <td>
                                                    @if (matrix.CanEdit)
                                                    {
                                                        <input type="number" class="cs-cell-input" min="0"
                                                               value="@GetJudgeDetail(jId, bId, k)"
                                                               @onchange="(e) => SetJudgeDetail(jId, bId, k, e)" />
                                                    } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, k)</span> }
                                                </td>
                                            }

                                            @if (IsFamily)
                                            {
                                                var kArb = "FAM_ARBITRATORS";
                                                <td>
                                                    @if (matrix.CanEdit)
                                                    {
                                                        <input type="number" class="cs-cell-input" min="0"
                                                               value="@GetJudgeDetail(jId, bId, kArb)"
                                                               @onchange="(e) => SetJudgeDetail(jId, bId, kArb, e)" />
                                                    } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, kArb)</span> }
                                                </td>
                                            }
                                            <td class="cs-computed" style="background:#f3e8fa;color:#6b21a8;font-weight:700">@ComputeJudgeEvidence(jId, bId)</td>

                                            @* جملة فرعي + إثبات *@
                                            <td class="cs-computed" style="background:#ede9fe;color:#5b21b6;font-weight:700">@ComputeJudgeInterlocAndEvidence(jId, bId)</td>

                                            @* وقف *@
                                            @foreach (var kind in new[]{ "STAY_PENAL", "STAY_COND", "STAY_AGREE" })
                                            {
                                                var k = kind;
                                                <td>
                                                    @if (matrix.CanEdit)
                                                    {
                                                        <input type="number" class="cs-cell-input" min="0"
                                                               value="@GetJudgeDetail(jId, bId, k)"
                                                               @onchange="(e) => SetJudgeDetail(jId, bId, k, e)" />
                                                    } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, k)</span> }
                                                </td>
                                            }
                                            <td class="cs-computed" style="background:#fef3c7;color:#92400e;font-weight:700">@ComputeJudgeStay(jId, bId)</td>

                                            @* انقطاع *@
                                            @{ var kInterrupt = "INTERRUPT"; }
                                            <td>
                                                @if (matrix.CanEdit)
                                                {
                                                    <input type="number" class="cs-cell-input" min="0"
                                                           value="@GetJudgeDetail(jId, bId, kInterrupt)"
                                                           @onchange="(e) => SetJudgeDetail(jId, bId, kInterrupt, e)" />
                                                } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, kInterrupt)</span> }
                                            </td>

                                            @* بيان مستقل: مد الأجل وإعادة للمرافعة *@
                                            @{ var kExtend = "EXTEND_JUDGMENT"; var kReturn = "RETURN_PLEADING"; }
                                            <td style="background:#f0f4ff">
                                                @if (matrix.CanEdit)
                                                {
                                                    <input type="number" class="cs-cell-input" min="0"
                                                           value="@GetJudgeDetail(jId, bId, kExtend)"
                                                           @onchange="(e) => SetJudgeDetail(jId, bId, kExtend, e)" />
                                                } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, kExtend)</span> }
                                            </td>
                                            <td style="background:#f0f4ff">
                                                @if (matrix.CanEdit)
                                                {
                                                    <input type="number" class="cs-cell-input" min="0"
                                                           value="@GetJudgeDetail(jId, bId, kReturn)"
                                                           @onchange="(e) => SetJudgeDetail(jId, bId, kReturn, e)" />
                                                } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, kReturn)</span> }
                                            </td>

                                            @* معاد من الاستئناف *@
                                            @{ var kReturnAppeal = "RETURN_APPEAL_IND"; }
                                            <td>
                                                @if (matrix.CanEdit)
                                                {
                                                    <input type="number" class="cs-cell-input" min="0"
                                                           value="@GetJudgeDetail(jId, bId, kReturnAppeal)"
                                                           @onchange="(e) => SetJudgeDetail(jId, bId, kReturnAppeal, e)" />
                                                } else { <span class="cs-computed">@GetJudgeDetail(jId, bId, kReturnAppeal)</span> }
                                            </td>

                                            @* إجمالي إنتاج القاضي *@
                                            <td class="cs-total-cell" style="background:#152c49;color:#fff">
                                                @ComputeJudgeTotalDetailedAllocation(jId, bId)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>الإجمالي</td>
                                        @foreach (var kind in new[]{ "FORMAL_REJECT", "FORMAL_INCOMP", "FORMAL_LAPSE_RIGHT", "FORMAL_LAPSE_LITIG", "FORMAL_WAIVE", "FORMAL_NULL", "FORMAL_DEEMED_NULL", "FORMAL_OTHER" })
                                        {
                                            var k = kind;
                                            <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, k))</td>
                                        }
                                        <td class="cs-computed">@yearBands.Sum(b => ComputeJudgeFormal(jId, b.Id))</td>
                                        @foreach (var kind in new[]{ "SUBST_ACCEPT", "SUBST_REJECT_STATE", "SUBST_REJECT", "SUBST_RES_JUDICATA" })
                                        {
                                            var k = kind;
                                            <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, k))</td>
                                        }
                                        @if (IsFamily)
                                        {
                                            @foreach (var kind in new[]{ "FAM_DIVORCE", "FAM_ALIMONY", "FAM_CUSTODY", "FAM_IMPRISON", "FAM_WAGES" })
                                            {
                                                var k = kind;
                                                <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, k))</td>
                                            }
                                        }
                                        <td class="cs-computed">@yearBands.Sum(b => ComputeJudgeSubstantive(jId, b.Id))</td>
                                        @{ var kStlTot = "SETTLEMENT"; }
                                        <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, kStlTot))</td>
                                        <td class="cs-computed">@yearBands.Sum(b => ComputeJudgeFinal(jId, b.Id))</td>
                                        @{ var kIlTot = "INTERLOC"; }
                                        <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, kIlTot))</td>
                                        @foreach (var kind in new[]{ "EVID_EXPERT", "EVID_RE_EXPERT", "EVID_INVEST", "EVID_CROSS", "EVID_OATH" })
                                        {
                                            var k = kind;
                                            <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, k))</td>
                                        }
                                        @if (IsFamily)
                                        {
                                            var kArbTot = "FAM_ARBITRATORS";
                                            <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, kArbTot))</td>
                                        }
                                        <td class="cs-computed">@yearBands.Sum(b => ComputeJudgeEvidence(jId, b.Id))</td>
                                        <td class="cs-computed">@yearBands.Sum(b => ComputeJudgeInterlocAndEvidence(jId, b.Id))</td>
                                        @foreach (var kind in new[]{ "STAY_PENAL", "STAY_COND", "STAY_AGREE" })
                                        {
                                            var k = kind;
                                            <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, k))</td>
                                        }
                                        <td class="cs-computed">@yearBands.Sum(b => ComputeJudgeStay(jId, b.Id))</td>
                                        @{ var kInTot = "INTERRUPT"; var kExTot = "EXTEND_JUDGMENT"; var kRpTot = "RETURN_PLEADING"; var kRaTot = "RETURN_APPEAL_IND"; }
                                        <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, kInTot))</td>
                                        <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, kExTot))</td>
                                        <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, kRpTot))</td>
                                        <td class="cs-computed">@yearBands.Sum(b => GetJudgeDetail(jId, b.Id, kRaTot))</td>
                                        <td class="cs-total-cell" style="background:#152c49;color:#fff">
                                            @yearBands.Sum(b => ComputeJudgeTotalDetailedAllocation(jId, b.Id))
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }

                    <div class="cs-panel-foot">
                        <span>💡 <strong>ملاحظة قضائية:</strong> تم توحيد عدم الاختصاص في حكم واحد («عدم اختصاص»). مد الأجل والإعادة بيان مستقل يدخل في المؤجلات فقط ولا يضاف لأحكام القاضي. معاد من الخبراء (أول جلسة) بيان مستقل لا يدخل في المؤجلات ولا في حسابات الموازنة ولا يعاد تدويره.</span>
                    </div>
                }
            }

            @* -------------------- تبويب 4: توزيع المؤجلات على الشهور -------------------- *@
            @if (activeTab == "postponements")
            {
                var postponementKindsList = new[]
                {
                    new { Kind = "INTERLOC_EVID",   Label = "أحكام فرعية وإثبات",    Source = "أحكام القضاة", TargetTab = "judges" },
                    new { Kind = "RESERVED",       Label = "محجوز للحكم",           Source = "كشف الإنتاج", TargetTab = "production" },
                    new { Kind = "EXTEND",         Label = "مد الأجل",              Source = "البيان المستقل للقضاة", TargetTab = "judges" },
                    new { Kind = "RETURN_PLEADING",Label = "إعادة للمرافعة",        Source = "البيان المستقل للقضاة", TargetTab = "judges" },
                    new { Kind = "FOR_REPORT",     Label = "المؤجل لورود التقرير",  Source = "كشف الإنتاج", TargetTab = "production" },
                    new { Kind = "OTHER",          Label = "المؤجل لأسباب أخرى",   Source = "كشف الإنتاج", TargetTab = "production" },
                };

                var activeMeta = postponementKindsList.FirstOrDefault(p => p.Kind == activePostponementReason) ?? postponementKindsList[0];
                var currentPeriods = GetDisplayedPeriods();

                @* شريط اختيار نوع المؤجل وملخصه (Reason Picker & Allocation Summary) *@
                <div class="cs-reason-picker">
                    <label>نوع المؤجل:</label>
                    <select class="form-control" style="width:230px;height:38px;font-weight:600"
                            value="@activePostponementReason"
                            @onchange="(e) => activePostponementReason = e.Value?.ToString() ?? activePostponementReason">
                        @foreach (var pk in postponementKindsList)
                        {
                            var issuesForThisKind = validationIssues.Count(i => i.TargetReason == pk.Kind);
                            <option value="@pk.Kind">
                                @pk.Label @(issuesForThisKind > 0 ? $"· ({issuesForThisKind} ملاحظات)" : "")
                            </option>
                        }
                    </select>

                    <div class="cs-allocation-summary">
                        <span>المطلوب: <strong>@GetDistributionTargetTotal(activePostponementReason)</strong></span>
                        <span>الموزع: <strong>@GetTotalDistributedTotal(activePostponementReason)</strong></span>
                        @{ var diffTot = GetDistributionDifferenceTotal(activePostponementReason); }
                        <span class="@(diffTot == 0 ? "good" : "amber")">
                            فرق التوزيع: <strong>@(diffTot == 0 ? "متزن (0)" : diffTot > 0 ? $"متبقي {diffTot}" : $"زيادة {Math.Abs(diffTot)}")</strong>
                        </span>
                    </div>

                    <div class="d-flex gap-2 ms-auto align-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="TogglePostponementView">
                            @(showComprehensivePostponementTable ? "📑 عرض النوع المحدد فقط" : "📊 عرض الجدول الشامل لكافة الأنواع")
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddExtraMonth" disabled="@(futurePeriods != null && displayedMonthsCount >= futurePeriods.Count)">
                            ➕ إضافة شهر
                        </button>
                        @if (displayedMonthsCount > 1)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RemoveExtraMonth">
                                ➖ إزالة شهر
                            </button>
                        }
                    </div>
                </div>

                @if (!showComprehensivePostponementTable)
                {
                    @* العرض الهادئ والمركز لنوع مؤجل واحد (ChatGPT style) *@
                    <div class="cs-allocation-source">
                        <span>🔒 مصدر العدد المطلوب: <strong>@activeMeta.Source</strong></span>
                        <button type="button" class="cs-issue-btn" @onclick='() => SetActiveTab(activeMeta.TargetTab)'>
                            الانتقال إلى مصدر العدد ←
                        </button>
                    </div>

                    <div style="overflow-x:auto;padding:0">
                        <table class="cs-ledger" style="min-width:980px;direction:rtl">
                            <thead>
                                <tr class="group-head">
                                    <th style="width:115px">سنة القيد</th>
                                    <th style="background:#eaf2fa;color:#1e3a8a;width:130px">العدد المطلوب (@activeMeta.Label)</th>
                                    @foreach (var p in currentPeriods)
                                    {
                                        <th>@p.MonthNameAr</th>
                                    }
                                    <th style="background:#f0fdf4;color:#166534;width:120px">إجمالي الموزع</th>
                                    <th style="width:140px">حالة التوزيع</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var band in yearBands)
                                {
                                    var bId = band.Id;
                                    var target = GetDistributionTarget(bId, activePostponementReason);
                                    var distributed = GetTotalDistributed(bId, activePostponementReason);
                                    var diff = target - distributed;
                                    var isRowErr = diff != 0;

                                    <tr data-band="@band.Id" class="@(isRowErr ? "row-error" : "") @(highlightedBandId == band.Id ? "highlight-row" : "")">
                                        <td>
                                            <span class="cs-year-main">@band.LabelAr</span>
                                        </td>
                                        <td class="cs-total-cell" style="background:#f0f7ff">
                                            @target 🔒
                                        </td>
                                        @foreach (var p in currentPeriods)
                                        {
                                            <td>
                                                @if (matrix.CanEdit)
                                                {
                                                    <input type="number" class="cs-cell-input" min="0"
                                                           value="@GetDistribution(bId, activePostponementReason, p.Id)"
                                                           @onchange='(e) => SetDistribution(bId, activePostponementReason, p.Id, e)' />
                                                }
                                                else
                                                {
                                                    <span class="cs-computed">@GetDistribution(bId, activePostponementReason, p.Id)</span>
                                                }
                                            </td>
                                        }
                                        <td class="cs-total-cell" style="background:#f0fdf4;color:#15803d">
                                            @distributed
                                        </td>
                                        <td>
                                            @if (diff == 0)
                                            {
                                                <span class="cs-diff-good">✓ متزن</span>
                                            }
                                            else
                                            {
                                                <span class="cs-diff-bad">
                                                    @(diff > 0 ? $"متبقي {diff}" : $"زيادة {Math.Abs(diff)}")
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>الإجمالي</td>
                                    <td class="cs-total-cell">@GetDistributionTargetTotal(activePostponementReason)</td>
                                    @foreach (var p in currentPeriods)
                                    {
                                        <td class="cs-computed">@yearBands.Sum(b => GetDistribution(b.Id, activePostponementReason, p.Id))</td>
                                    }
                                    <td class="cs-total-cell">@GetTotalDistributedTotal(activePostponementReason)</td>
                                    <td>
                                        @{ var dDiff = GetDistributionDifferenceTotal(activePostponementReason); }
                                        @if (dDiff == 0)
                                        {
                                            <span class="cs-diff-good">✓ متزن</span>
                                        }
                                        else
                                        {
                                            <span class="cs-diff-bad">فرق @dDiff</span>
                                        }
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    @* العرض الشامل لكافة الأنواع الستة جنباً إلى جنب *@
                    var postponementColorMap = new[]
                    {
                        new { Kind = "INTERLOC_EVID",   Label = "أحكام فرعية وإثبات",    BgColor = "#ead1f7", HeaderBg = "#7030a0" },
                        new { Kind = "RESERVED",       Label = "محجوز للحكم",           BgColor = "#dce6f1", HeaderBg = "#2e75b6" },
                        new { Kind = "EXTEND",         Label = "مد الأجل",              BgColor = "#e2efda", HeaderBg = "#375623" },
                        new { Kind = "RETURN_PLEADING",Label = "إعادة للمرافعة",        BgColor = "#fce4d6", HeaderBg = "#c65911" },
                        new { Kind = "FOR_REPORT",     Label = "المؤجل لورود التقرير",  BgColor = "#fff2cc", HeaderBg = "#bf8f00" },
                        new { Kind = "OTHER",          Label = "المؤجل لأسباب أخرى",   BgColor = "#f2f2f2", HeaderBg = "#595959" },
                    };

                    <div style="overflow-x:auto;padding:0">
                        <table class="cs-ledger" style="min-width:2000px;direction:rtl;font-size:12.5px">
                            <thead>
                                <tr class="group-head">
                                    <th rowspan="2" style="width:115px">سنة القيد</th>
                                    @foreach (var pk in postponementColorMap)
                                    {
                                        <th colspan="@(currentPeriods.Count + 3)" style="background:@pk.HeaderBg;color:#fff">@pk.Label</th>
                                    }
                                    <th colspan="@(currentPeriods.Count + 3)" style="background:#152c49;color:#fff">إجمالي المؤجلات</th>
                                </tr>
                                <tr>
                                    @foreach (var pk in postponementColorMap)
                                    {
                                        <th style="background:@pk.BgColor;color:#000;font-weight:700">المطلوب</th>
                                        @foreach (var p in currentPeriods)
                                        {
                                            <th style="background:@pk.BgColor;color:#000">@p.MonthNameAr</th>
                                        }
                                        <th style="background:@pk.BgColor;color:#000;font-weight:700">الموزع</th>
                                        <th style="background:@pk.BgColor;color:#000">الحالة</th>
                                    }
                                    <th style="background:#d9e1f2;font-weight:700">المجموع</th>
                                    @foreach (var p in currentPeriods)
                                    {
                                        <th style="background:#d9e1f2">@p.MonthNameAr</th>
                                    }
                                    <th style="background:#d9e1f2;font-weight:700">الموزع</th>
                                    <th style="background:#d9e1f2">التوازن</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var band in yearBands)
                                {
                                    var bId = band.Id;
                                    int totalRowTarget = 0;
                                    int totalRowDist = 0;

                                    <tr data-band="@band.Id" class="@(highlightedBandId == band.Id ? "highlight-row" : "")">
                                        <td>
                                            <span class="cs-year-main">@band.LabelAr</span>
                                        </td>
                                        @foreach (var pk in postponementColorMap)
                                        {
                                            var target = GetDistributionTarget(bId, pk.Kind);
                                            var distributed = GetTotalDistributed(bId, pk.Kind);
                                            var diff = target - distributed;
                                            totalRowTarget += target;
                                            totalRowDist += distributed;

                                            <td class="cs-computed" style="background:@pk.BgColor;font-weight:700">@target</td>
                                            @foreach (var p in currentPeriods)
                                            {
                                                <td>
                                                    @if (matrix.CanEdit)
                                                    {
                                                        <input type="number" class="cs-cell-input" min="0"
                                                               value="@GetDistribution(bId, pk.Kind, p.Id)"
                                                               @onchange='(e) => SetDistribution(bId, pk.Kind, p.Id, e)' />
                                                    } else { <span class="cs-computed">@GetDistribution(bId, pk.Kind, p.Id)</span> }
                                                </td>
                                            }
                                            <td class="cs-computed" style="background:@pk.BgColor">@distributed</td>
                                            <td>
                                                @if (diff == 0)
                                                {
                                                    <span class="cs-diff-good">✓</span>
                                                }
                                                else
                                                {
                                                    <span class="cs-diff-bad">@(diff > 0 ? $"+{diff}" : diff.ToString())</span>
                                                }
                                            </td>
                                        }

                                        @{ var rowDiff = totalRowTarget - totalRowDist; }
                                        <td class="cs-computed" style="background:#e0e7ff;font-weight:700">@totalRowTarget</td>
                                        @foreach (var p in currentPeriods)
                                        {
                                            var sumMonth = postponementColorMap.Sum(pk => GetDistribution(bId, pk.Kind, p.Id));
                                            <td class="cs-computed" style="background:#f8fafc">@sumMonth</td>
                                        }
                                        <td class="cs-computed" style="background:#e0e7ff;font-weight:700">@totalRowDist</td>
                                        <td>
                                            @if (rowDiff == 0)
                                            {
                                                <span class="cs-diff-good">✓</span>
                                            }
                                            else
                                            {
                                                <span class="cs-diff-bad">@(rowDiff > 0 ? $"+{rowDiff}" : rowDiff.ToString())</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="cs-panel-foot">
                    <span>💡 <strong>التوزيع اليدوي إلزامي:</strong> لا يُكمل النظام المتبقي تلقائياً. كل عدد موزّع يدخل في رصيد سابق شهره.</span>
                    <span>الأشهر المعروضة تبدأ من الشهر التالي لشهر الإحصائية مباشرة</span>
                </div>
            }

            @* -------------------- تبويب 5: ميزان التوازن والختامي -------------------- *@
            @if (activeTab == "closing")
            {
                <div class="cs-panel-head">
                    <div>
                        <h2>ميزان التوازن والأرصدة الختامية المتوقعة</h2>
                        <p>مطابقة تامة بين جملة المتاح للتداول وبين ما انتهى بحكم أو شطب أو استمر بالتأجيل.</p>
                    </div>
                </div>

                <div style="overflow-x:auto;padding:0">
                    <table class="cs-ledger" style="min-width:1050px;direction:rtl">
                        <thead>
                            <tr class="group-head">
                                <th style="width:115px">سنة القيد</th>
                                <th style="background:#eaf2fa;color:#1e3a8a">الرصيد السابق 🔒</th>
                                <th style="background:#e0f2fe;color:#0369a1">صافي الوارد الجديد</th>
                                <th style="background:#152c49;color:#fff;font-weight:700">جملة المقدم (المتاح)</th>
                                <th style="background:#dcfce7;color:#166534">الأحكام الصادرة (المنجز)</th>
                                <th style="background:#fef3c7;color:#92400e">المؤجل والشطب</th>
                                <th style="background:#126d69;color:#fff;font-weight:700">الرصيد الختامي المتوقع</th>
                                <th style="width:130px">حالة التوازن</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var band in yearBands)
                            {
                                var bId = band.Id;
                                var op = GetPreviousBalance(bId);
                                var jumlaMuq = ComputeJumlaMuqaddam(bId);
                                var pureInc = Math.Max(0, jumlaMuq - op);
                                var totalAvail = jumlaMuq;
                                var jud = ComputeAllJudgesFinal(bId) + ComputeAllJudgesStay(bId) + ComputeAllJudgesInterrupt(bId);
                                var other = GetManualProduction(bId, "STRIKE") + GetManualProduction(bId, "RECUSAL_WAIT") + ComputeTotalPostponements(bId) + ComputeAllJudgesInterlocAndEvidence(bId);
                                var closing = Math.Max(0, totalAvail - jud);
                                var balanceDiff = totalAvail - (jud + other);

                                <tr data-band="@band.Id" class="@(balanceDiff != 0 ? "row-error" : "") @(highlightedBandId == band.Id ? "highlight-row" : "")">
                                    <td>
                                        <span class="cs-year-main">@band.LabelAr</span>
                                    </td>
                                    <td class="cs-computed" style="background:#f8fafc">@op</td>
                                    <td class="cs-computed" style="background:#f0f7ff">@pureInc</td>
                                    <td class="cs-total-cell" style="background:#e2e8f0">@totalAvail</td>
                                    <td class="cs-computed" style="background:#f0fdf4;color:#15803d;font-weight:700">@jud</td>
                                    <td class="cs-computed" style="background:#fffbeb;color:#b45309">@other</td>
                                    <td class="cs-total-cell" style="background:#eaf5f3;color:#126d69">@closing</td>
                                    <td>
                                        @if (balanceDiff == 0)
                                        {
                                            <span class="cs-diff-good">✓ متزن (0)</span>
                                        }
                                        else
                                        {
                                            <span class="cs-diff-bad">فرق (@balanceDiff)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>المجموع الكلي</td>
                                <td class="cs-computed">@yearBands.Sum(b => GetPreviousBalance(b.Id))</td>
                                <td class="cs-computed">@yearBands.Sum(b => Math.Max(0, ComputeJumlaMuqaddam(b.Id) - GetPreviousBalance(b.Id)))</td>
                                <td class="cs-total-cell">@yearBands.Sum(b => ComputeJumlaMuqaddam(b.Id))</td>
                                <td class="cs-computed" style="color:#15803d">@yearBands.Sum(b => ComputeAllJudgesFinal(b.Id) + ComputeAllJudgesStay(b.Id) + ComputeAllJudgesInterrupt(b.Id))</td>
                                <td class="cs-computed" style="color:#b45309">@yearBands.Sum(b => GetManualProduction(b.Id, "STRIKE") + GetManualProduction(b.Id, "RECUSAL_WAIT") + ComputeTotalPostponements(b.Id) + ComputeAllJudgesInterlocAndEvidence(b.Id))</td>
                                <td class="cs-total-cell" style="color:#126d69">@ComputeTotalClosing()</td>
                                <td>-</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        }

            @* -------------------- تبويب 6: سجل التدقيق -------------------- *@
            @if (activeTab == "audit")
            {
                <div class="cs-panel-head">
                    <div>
                        <h2>سجل حركات وتدقيق الإحصائية</h2>
                        <p>تسجيل كامل لجميع عمليات الحفظ والتقديم والمراجعة والاعتماد وإعادة الفتح.</p>
                    </div>
                </div>

                <div style="overflow-x:auto;padding:0">
                    <table class="cs-ledger" style="direction:rtl">
                        <thead>
                            <tr class="group-head">
                                <th>الوقت والتاريخ</th>
                                <th>المستخدم</th>
                                <th>الإجراء</th>
                                <th>البيان والملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in matrix.AuditEntries)
                            {
                                <tr>
                                    <td>@entry.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="fw-bold">@(entry.UserNameAr ?? "النظام")</td>
                                    <td>
                                        <span class="badge badge-muted">@entry.Action</span>
                                    </td>
                                    <td>@(entry.Comment ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @* ==================== لوحة الدعم ودليل الأخطاء (Support Grid) ==================== *@
        <section class="cs-support-grid">
            @* بطاقة 1: ملاحظات تحتاج انتباهك (دليل الأخطاء التفاعلي) *@
            <div class="cs-support-card">
                <div class="cs-support-title">
                    <span>📋</span> دليل الأخطاء والملاحظات (@validationIssues.Count)
                </div>

                @if (validationIssues.Count == 0)
                {
                    <div class="cs-issue-empty">
                        <span>✅</span>
                        <span>اكتملت جميع قواعد التوازن والتوزيع! كل صفوف الإنتاج والمؤجلات متزنة وسليمة 100%.</span>
                    </div>
                }
                else
                {
                    @foreach (var issue in validationIssues.Take(5))
                    {
                        <div class="cs-issue-row">
                            <span style="display:flex;align-items:center;gap:6px">
                                <span style="color:#b91c1c">⚠️</span>
                                <strong>@issue.Title:</strong>
                                <span>@issue.Message</span>
                            </span>
                            <button type="button" class="cs-issue-btn" @onclick="() => GoToIssue(issue)">
                                انتقال ←
                            </button>
                        </div>
                    }

                    @if (validationIssues.Count > 5)
                    {
                        <div class="mt-2 text-center">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenReviewDialog">
                                عرض جميع الملاحظات (@validationIssues.Count) ←
                            </button>
                        </div>
                    }
                }
            </div>

            @* بطاقة 2: قاعدة ضبط الإحصائية *@
            <div class="cs-support-card">
                <div class="cs-support-title">
                    <span>⚖️</span> قاعدة ضبط الإحصائية القضائية
                </div>
                @if (IsCriminal)
                {
                    <div class="cs-equation">
                        <b>المقدم</b>
                        <span>=</span>
                        <b>المؤجل خارج الشهر</b>
                        <span>+</span>
                        <b>المحكوم فيه</b>
                    </div>
                    <p>
                        <strong>التدفق العكسي في الجنائي:</strong> يتم إدخال الأحكام في الإنتاج (المحكوم فيه) أولاً، ثم تُوزّع الفئات الإجمالية على القضاة تلقائياً.<br />
                        <strong>المؤجلات:</strong> تُرحّل تلقائياً إلى الشهر التالي مباشرة، مع إمكانية تعديل الشهور للحالات النادرة.
                    </p>
                }
                else
                {
                    <div class="cs-equation">
                        <b>المقدم</b>
                        <span>=</span>
                        <b>كل الأحكام</b>
                        <span>+</span>
                        <b>الشطب وطلب الرد</b>
                        <span>+</span>
                        <b>المؤجل دون أحكام</b>
                    </div>
                    <p>
                        <strong>المطلوب توزيعه</strong> = المؤجل دون أحكام + الأحكام الفرعية والإثبات.<br />
                        يُحسب الفرعي والإثبات مرة واحدة في الخارج، ويظلان ضمن القضايا المؤجلة لأن الخصومة لم تنتهِ بعد.
                    </p>
                }
            </div>
        </section>

        @* ==================== الشريط السفلي العائم (Floating Action Bar) ==================== *@
        <footer class="cs-action-bar">
            <div class="cs-action-inner">
                <div class="cs-validation-state @(validationIssues.Count == 0 ? "ok" : "")">
                    <span style="font-size:1.3rem">@(validationIssues.Count == 0 ? "✅" : "⚠️")</span>
                    <div>
                        <span>@(validationIssues.Count == 0 ? "الإحصائية صالحة للمراجعة (متزنة ومكتملة)" : $"الإحصائية تحتاج مراجعة · {validationIssues.Count} ملاحظات")</span>
                        <small>@(validationIssues.Count == 0 ? "جميع السنوات متزنة وتوزيع المؤجلات مكتمل." : "انقر على زر فحص الإحصائية لمراجعة التفاصيل والانتقال لمصدر الخلل")</small>
                    </div>
                </div>

                <div class="cs-bar-actions">
                    <span class="cs-saved-text">
                        @(string.IsNullOrEmpty(lastSavedTime) ? "مسودة غير محفوظة بعد" : $"آخر حفظ: {lastSavedTime}")
                    </span>

                    @if (matrix.CanEdit)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="HandleSaveDraft" disabled="@isSubmitting">
                            💾 حفظ المسودة
                        </button>
                    }

                    <button type="button" class="btn btn-primary" @onclick="OpenReviewDialog">
                        🔍 فحص الإحصائية
                    </button>

                    @if (matrix.CanSubmit)
                    {
                        <button type="button" class="btn btn-success" @onclick="HandleSubmit" disabled="@isSubmitting">
                            📤 تقديم للمراجعة
                        </button>
                    }
                </div>
            </div>
        </footer>
    </div>
}

@* ==================== مودال فحص الإحصائية (Review Dialog) ==================== *@
@if (showReviewDialog)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal" style="max-width:700px" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">🔍 فحص توازن ودقة الإحصائية</span>
                <button type="button" class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                @if (validationIssues.Count == 0)
                {
                    <div class="alert alert-success d-flex align-center gap-3">
                        <div style="font-size:2.2rem">✅</div>
                        <div>
                            <strong style="font-size:1.05rem">اكتملت جميع قواعد التوازن والتوزيع!</strong>
                            <p class="mb-0" style="font-size:0.88rem">المقدم يساوي الخارج في كل سنة قيد، وتوزيع المؤجلات سليم ومكتمل بنسبة 100%.</p>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded mt-3">
                        <div class="d-flex align-center gap-2 mb-2" style="font-size:0.9rem;color:#166534">
                            <span>✔️</span> المقدم يساوي الخارج في كل سنوات القيد
                        </div>
                        <div class="d-flex align-center gap-2 mb-2" style="font-size:0.9rem;color:#166534">
                            <span>✔️</span> الرصيد السابق محمل ومحسوب من قاعدة البيانات
                        </div>
                        <div class="d-flex align-center gap-2" style="font-size:0.9rem;color:#166534">
                            <span>✔️</span> المؤجلات والأحكام الفرعية والإثبات موزعة بالكامل على الشهور
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger d-flex align-center gap-3 mb-3">
                        <div style="font-size:2.2rem">⚠️</div>
                        <div>
                            <strong style="font-size:1.05rem">توجد ملاحظات مطلوب تصحيحها (@validationIssues.Count):</strong>
                            <p class="mb-0" style="font-size:0.88rem">انقر على زر «تصحيح» بجوار أي ملاحظة للانتقال فوراً للخلية أو الصف المعني.</p>
                        </div>
                    </div>

                    <div style="max-height:360px;overflow-y:auto;display:flex;flex-direction:column;gap:0.6rem">
                        @foreach (var issue in validationIssues)
                        {
                            <div class="p-2 border rounded d-flex justify-between align-center" style="background:#fcfcfc">
                                <div>
                                    <span class="fw-bold" style="color:var(--cs-navy);font-size:13.5px">@issue.Title</span>
                                    <div class="text-danger" style="font-size:12.5px">@issue.Message</div>
                                </div>
                                <button type="button" class="cs-issue-btn" @onclick="() => GoToIssue(issue)">
                                    تصحيح ←
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="CloseModals">العودة للنموذج</button>
            </div>
        </div>
    </div>
}

@* ==================== مودال المراجعة ==================== *@
@if (showReviewModal)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">@(isReviewApproval ? "✔️ قبول المراجعة وتأكيد المطابقة" : "↩️ إعادة الإحصائية للتعديل")</span>
                <button type="button" class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">ملاحظات المراجعة</label>
                    <textarea class="form-control" rows="4" @bind="reviewComment" placeholder="أدخل أي ملاحظات تدقيقية..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">إلغاء</button>
                <button type="button" class="btn @(isReviewApproval ? "btn-success" : "btn-warning")" @onclick="ConfirmReview">
                    @(isReviewApproval ? "تأكيد القبول" : "إعادة للتعديل")
                </button>
            </div>
        </div>
    </div>
}

