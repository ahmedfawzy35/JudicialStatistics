                                        </td>
                                        <td>
                                            <input type="number" class="crim-input" min="0" value="@GetCrimVal("CRIM_SUSP")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimVal("CRIM_SUSP", e)' />
                                        </td>
                                        <td class="crim-total-cell" style="background:#cffafe;color:#0e7490">
                                            @ComputeCrimExec()
                                        </td>
                                        <td>
                                            <input type="number" class="crim-input" min="0" value="@GetCrimVal("CRIM_STAY")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimVal("CRIM_STAY", e)' />
                                        </td>
                                        <td>
                                            <input type="number" class="crim-input" min="0" value="@GetCrimVal("CRIM_RESUME")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimVal("CRIM_RESUME", e)' />
                                        </td>
                                        <td>
                                            <input type="number" class="crim-input" min="0" value="@GetCrimVal("CRIM_OTHER")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimVal("CRIM_OTHER", e)' />
                                        </td>
                                        @foreach (var cJud in CustomCrimJudgmentItems)
                                        {
                                            <td>
                                                <input type="number" class="crim-input" min="0" value="@GetCrimVal(cJud.Code)" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimVal(cJud.Code, e)' />
                                            </td>
                                        }

                                        @* توزيع الأحكام على القضاة أ، ب، ج، د *@
                                        @for (int jIdx = 0; jIdx < 4; jIdx++)
                                        {
                                            var idx = jIdx;
                                            var jId = GetAppealJudgeId(idx);
                                            <td class="@(idx == 0 ? "crim-border-separator" : "")" style="background:@(idx % 2 == 0 ? "#fffbeb" : "#ffffff")">
                                                <input type="number" class="crim-input @(!IsCrimCategoryBalanced("SUBST") ? "crim-input-err" : "")" min="0" value="@GetCrimJudgeAlloc(jId, "SUBST")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimJudgeAlloc(jId, "SUBST", e)' />
                                            </td>
                                            <td style="background:@(idx % 2 == 0 ? "#fffbeb" : "#ffffff")">
                                                <input type="number" class="crim-input @(!IsCrimCategoryBalanced("PROC") ? "crim-input-err" : "")" min="0" value="@GetCrimJudgeAlloc(jId, "PROC")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimJudgeAlloc(jId, "PROC", e)' />
                                            </td>
                                            <td style="background:@(idx % 2 == 0 ? "#fffbeb" : "#ffffff")">
                                                <input type="number" class="crim-input @(!IsCrimCategoryBalanced("ORDER") ? "crim-input-err" : "")" min="0" value="@GetCrimJudgeAlloc(jId, "ORDER")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimJudgeAlloc(jId, "ORDER", e)' />
                                            </td>
                                            <td style="background:@(idx % 2 == 0 ? "#fffbeb" : "#ffffff")">
                                                <input type="number" class="crim-input @(!IsCrimCategoryBalanced("PREP") ? "crim-input-err" : "")" min="0" value="@GetCrimJudgeAlloc(jId, "PREP")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimJudgeAlloc(jId, "PREP", e)' />
                                            </td>
                                            <td style="background:@(idx % 2 == 0 ? "#fffbeb" : "#ffffff")">
                                                <input type="number" class="crim-input @(!IsCrimCategoryBalanced("STAY") ? "crim-input-err" : "")" min="0" value="@GetCrimJudgeAlloc(jId, "STAY")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimJudgeAlloc(jId, "STAY", e)' />
                                            </td>
                                            <td style="background:@(idx % 2 == 0 ? "#fffbeb" : "#ffffff")">
                                                <input type="number" class="crim-input @(!IsCrimCategoryBalanced("EXEC") ? "crim-input-err" : "")" min="0" value="@GetCrimJudgeAlloc(jId, "EXEC")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimJudgeAlloc(jId, "EXEC", e)' />
                                            </td>
                                            <td style="background:@(idx % 2 == 0 ? "#fffbeb" : "#ffffff")">
                                                <input type="number" class="crim-input @(!IsCrimCategoryBalanced("OTHER") ? "crim-input-err" : "")" min="0" value="@GetCrimJudgeAlloc(jId, "OTHER")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimJudgeAlloc(jId, "OTHER", e)' />
                                            </td>
                                        }
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr style="background:#f8fafc;font-weight:bold;font-size:0.85rem">
                                        <td colspan="@(7 + CustomCrimIncomingItems.Count)" class="text-start">مجموع المقدم: @ComputeCrimMuqaddam()</td>
                                        <td colspan="@(8 + CustomCrimDeferralItems.Count)" class="text-start" style="border-inline-start: 4px solid #f59e0b">مجموع المؤجل: @ComputeCrimMoajal()</td>
                                        <td colspan="@(28 + CustomCrimJudgmentItems.Count)" class="text-start">مجموع المحكوم فيه: @ComputeCrimMahkoum()</td>
                                        <td colspan="28" class="crim-border-separator text-center" style="background:#fef3c7">
                                            <div style="display:flex;align-items:center;justify-content:space-around;flex-wrap:wrap;gap:8px">
                                                <span>موضوعي: <b>@GetCrimJudgeCategoryTotal("SUBST") / @ComputeCrimSubst()</b> @(IsCrimCategoryBalanced("SUBST") ? "✓" : "⚠️")</span>
                                                <span>إجرائي: <b>@GetCrimJudgeCategoryTotal("PROC") / @ComputeCrimProc()</b> @(IsCrimCategoryBalanced("PROC") ? "✓" : "⚠️")</span>
                                                <span>أوامر: <b>@GetCrimJudgeCategoryTotal("ORDER") / @ComputeCrimOrder()</b> @(IsCrimCategoryBalanced("ORDER") ? "✓" : "⚠️")</span>
                                                <span>تمهيدي: <b>@GetCrimJudgeCategoryTotal("PREP") / @ComputeCrimPrep()</b> @(IsCrimCategoryBalanced("PREP") ? "✓" : "⚠️")</span>
                                                <span>وقف: <b>@GetCrimJudgeCategoryTotal("STAY") / @ComputeCrimStay()</b> @(IsCrimCategoryBalanced("STAY") ? "✓" : "⚠️")</span>
                                                <span>إشكالات: <b>@GetCrimJudgeCategoryTotal("EXEC") / @ComputeCrimExec()</b> @(IsCrimCategoryBalanced("EXEC") ? "✓" : "⚠️")</span>
                                                <span>أخرى: <b>@GetCrimJudgeCategoryTotal("OTHER") / @(ComputeCrimOther() + ComputeCustomCrimJudgments())</b> @(IsCrimCategoryBalanced("OTHER") ? "✓" : "⚠️")</span>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                }
            }
            else
            {
                @* -------------------- تبويب 1: المقدم والوارد -------------------- *@
                @if (activeTab == "incoming")
            {
                <div class="cs-panel-head">
                    <div>
                        <h2>كشف القضايا الواردة (المقدم) — @matrix.Header.PeriodMonthNameAr</h2>
                        <p>السابق للقراءة فقط (في شهر أكتوبر يُستمد تلقائياً من الرصيد الافتتاحي للجلسة أول العام، وفي باقي الشهور يُستمد من المؤجلات المتداولة داخل العام القضائي). إحالة من الدائرة تُخصم من المقدم.</p>
                    </div>
                    <div class="cs-input-legend">
                        <i/> خانات الإدخال
                    </div>
                </div>

                <div style="overflow-x:auto;padding:0">
                    <table class="cs-ledger cs-ledger-compact" style="width:100%;direction:rtl">
                        <thead>
                            @* الصف الأول (الرئيسي): سنة القيد (يمين) - المقدم (ممتد على 13 عمود) - جملة المقدم (أقصى اليسار) *@
                            <tr>
                                <th rowspan="4" style="width:95px;vertical-align:middle">سنة<br/>القيد</th>
                                <th colspan="13" class="cs-th-group-main">المقدم</th>
                                <th rowspan="4" class="cs-th-v cs-th-v-total" style="width:50px">
                                    <span>جملة المقدم</span>
                                </th>
                            </tr>
                            @* الصف الثاني: سابق - مجدد من الشطب - المتداول (10 أعمدة) - الجديد *@
                            <tr>
                                <th rowspan="3" class="cs-th-v cs-th-v-peach" style="width:48px">
                                    <span>سابق</span>
                                </th>
                                <th rowspan="3" class="cs-th-v cs-th-v-grey" style="width:48px">
                                    <span>مجدد من الشطب</span>
                                </th>
                                <th colspan="10" class="cs-th-group-sub">المتداول</th>
                                <th rowspan="3" class="cs-th-v" style="width:48px">
                                    <span>الجديد</span>
                                </th>
                            </tr>
                            @* الصف الثالث: المعجل من الوقف (4 أعمدة) - معجل انقطاع - معاد استئناف - التقصير (عمودان) - إحالة من - إحالة إلى *@
                            <tr>
                                <th colspan="4" class="cs-th-group-blue">المعجل من الوقف</th>
                                <th rowspan="2" class="cs-th-v" style="width:48px">
                                    <span>معجل من الانقطاع</span>
                                </th>
                                <th rowspan="2" class="cs-th-v" style="width:48px">
                                    <span>معاد من الاستئناف</span>
                                </th>
                                <th colspan="2" class="cs-th-group-blue">التقصير</th>
                                <th rowspan="2" class="cs-th-v" style="width:48px">
                                    <span>إحالة من الدائرة</span>
                                </th>
                                <th rowspan="2" class="cs-th-v" style="width:48px">
                                    <span>إحالة إلى الدائرة</span>
                                </th>
                            </tr>
                            @* الصف الرابع: الأعمدة الفرعية للمعجل من الوقف والتقصير *@
                            <tr>
                                <th class="cs-th-v" style="width:48px">
                                    <span>لحين الفصل في طلب الرد</span>
                                </th>
                                <th class="cs-th-v" style="width:44px">
                                    <span>جزائي</span>
                                </th>
                                <th class="cs-th-v" style="width:44px">
                                    <span>تعليقي</span>
                                </th>
                                <th class="cs-th-v" style="width:44px">
                                    <span>اتفاقي</span>
                                </th>
                                <th class="cs-th-v" style="width:48px">
                                    <span>عدد الدعاوى المقصرة</span>
                                </th>
                                <th class="cs-th-v" style="width:95px">
                                    <span>الشهر المقصر منه</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var band in yearBands)
                            {
                                var prev     = GetPreviousBalance(band.Id);
                                var renew    = GetIncomingByCode(band.Id, "RENEW");
                                var recusal  = GetIncomingByCode(band.Id, "RECUSAL_WAIT");
                                var accelP   = GetIncomingByCode(band.Id, "ACCEL_PENAL");
                                var accelS   = GetIncomingByCode(band.Id, "ACCEL_SUSP");
                                var accelA   = GetIncomingByCode(band.Id, "ACCEL_AGREE");
                                var accelI   = GetIncomingByCode(band.Id, "ACCEL_INTERRUPT");
                                var retApp   = GetIncomingByCode(band.Id, "RETURN_APPEAL");
                                var shortV   = GetIncomingByCode(band.Id, "SHORT");
                                var transF   = GetIncomingByCode(band.Id, "TRANSFER_FROM");
                                var transTo  = GetIncomingByCode(band.Id, "TRANSFER_TO");
                                var newV     = GetIncomingByCode(band.Id, "NEW");
                                var jumlaMuq = ComputeJumlaMuqaddam(band.Id);

                                <tr data-band="@band.Id" class="@(highlightedBandId == band.Id ? "highlight-row" : "")">
                                    @* 1. سنة القيد *@
                                    <td>
                                        <span class="cs-year-main">@band.LabelAr</span>
                                    </td>

                                    @* 2. سابق (قراءة فقط - خلفية خوخية) *@
