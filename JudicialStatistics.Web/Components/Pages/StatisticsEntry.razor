    private void AddExtraMonth() => displayedMonthsCount++;
    private void RemoveExtraMonth()
    {
        if (displayedMonthsCount > 1) displayedMonthsCount--;
    }

    private List<StatisticalPeriodDto> GetDisplayedPeriods()
    {
        if (futurePeriods == null || futurePeriods.Count == 0)
        {
            return Enumerable.Range(1, Math.Max(1, displayedMonthsCount))
                .Select(i => new StatisticalPeriodDto(i, 1, new DateOnly(2026, Math.Min(12, i), 1), $"شهر {i}", "2025/2026"))
                .ToList();
        }
        return futurePeriods.Take(displayedMonthsCount).ToList();
    }

    private int GetDistribution(long bandId, string kind, long periodId) =>
        detailedDistribution.GetValueOrDefault((bandId, kind, periodId), 0);

    private void SetDistribution(long bandId, string kind, long periodId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            detailedDistribution[(bandId, kind, periodId)] = Math.Max(0, val);
            UpdateValidationIssues();
            StateHasChanged();
        }
    }

    private int GetDistributionTarget(long bandId, string kind) =>
        kind switch
        {
            "INTERLOC_EVID"   => ComputeAllJudgesInterlocAndEvidence(bandId),
            "RESERVED"        => GetPostponementManual(bandId, "RESERVED"),
            "EXTEND"          => ComputeAllJudgesExtend(bandId),
            "RETURN_PLEADING" => ComputeAllJudgesReopen(bandId),
            "FOR_REPORT"      => GetPostponementManual(bandId, "FOR_REPORT"),
            "OTHER"           => GetPostponementManual(bandId, "OTHER"),
            _                 => 0
        };

    private int GetTotalDistributed(long bandId, string kind)
    {
        var periods = GetDisplayedPeriods();
        return periods.Sum(p => GetDistribution(bandId, kind, p.Id));
    }

    private int GetDistributionTargetTotal(string kind) =>
        yearBands.Sum(b => GetDistributionTarget(b.Id, kind));

    private int GetTotalDistributedTotal(string kind) =>
        yearBands.Sum(b => GetTotalDistributed(b.Id, kind));

    private int GetDistributionDifferenceTotal(string kind) =>
        GetDistributionTargetTotal(kind) - GetTotalDistributedTotal(kind);

    // ========== Aggregate Calculations ==========

    private int ComputeTotalOpening() =>
        IsCriminal ? GetCrimVal("CRIM_PREV") : yearBands.Sum(b => GetPreviousBalance(b.Id));

    private int ComputeTotalIncoming() =>
        IsCriminal ? ComputeCrimMuqaddam() : yearBands.Sum(b => ComputeJumlaMuqaddam(b.Id));

    private int ComputeTotalJudgments() =>
        IsCriminal ? ComputeCrimMahkoum() : yearBands.Sum(b => ComputeAllJudgesTotalJudged(b.Id));

    private int ComputeTotalInterlocAndEvidence() =>
        IsCriminal ? ComputeCrimPrep() : yearBands.Sum(b => ComputeAllJudgesInterlocAndEvidence(b.Id));

    private int ComputeRowOutgoing(long bandId) =>
        ComputeAllJudgesTotalJudged(bandId)
        + GetManualProduction(bandId, "STRIKE")
        + GetManualProduction(bandId, "RECUSAL_WAIT")
        + ComputeTotalPostponements(bandId);

    private int ComputeTotalOutgoing() =>
        IsCriminal ? (ComputeCrimMoajal() + ComputeCrimMahkoum()) : yearBands.Sum(b => ComputeRowOutgoing(b.Id));

    private int GetBalanceDifference(long bandId) =>
        ComputeJumlaMuqaddam(bandId) - ComputeRowOutgoing(bandId);

    private int ComputeTotalClosing()
    {
        var totalAvailable = ComputeTotalIncoming();
        return Math.Max(0, totalAvailable - ComputeTotalJudgments());
    }

    // ========== Validation & Navigation ==========

    private void UpdateValidationIssues()
    {
        validationIssues.Clear();
        if (IsCriminal)
        {
            if (!IsCrimBalanced)
            {
                var msg = CrimBalanceDiff > 0
                    ? $"المقدم ({ComputeCrimMuqaddam()}) أكبر من (المؤجل {ComputeCrimMoajal()} + المحكوم فيه {ComputeCrimMahkoum()}) بمقدار {CrimBalanceDiff}"
                    : $"المجموع ({ComputeCrimMoajal() + ComputeCrimMahkoum()}) أكبر من المقدم ({ComputeCrimMuqaddam()}) بمقدار {Math.Abs(CrimBalanceDiff)}";
                validationIssues.Add(new ValidationIssue("توازن إحصائية الجنح", msg, "crim_ledger"));
            }

            if (IsCriminalAppeal && !IsAllCrimCategoriesBalanced)
            {
                foreach (var cat in new[] { "SUBST", "PROC", "ORDER", "PREP", "STAY", "EXEC", "OTHER" })
                {
                    if (!IsCrimCategoryBalanced(cat))
                    {
                        var catName = cat switch
                        {
                            "SUBST" => "الأحكام الموضوعية",
                            "PROC" => "الأحكام الإجرائية",
                            "ORDER" => "الأوامر الجنائية",
                            "PREP" => "الأحكام التمهيدية",
                            "STAY" => "أحكام الوقف",
                            "EXEC" => "إشكالات التنفيذ",
                            "OTHER" => "الأحكام الأخرى",
                            _ => cat
                        };
                        var allocated = GetCrimJudgeCategoryTotal(cat);
                        var target = GetCrimJudgeCategoryTarget(cat);
                        validationIssues.Add(new ValidationIssue($"توزيع القضاة ({catName})", $"الموزع ({allocated}) لا يطابق المطلوب ({target})", "crim_ledger"));
                    }
                }
            }
            return;
        }

        if (yearBands == null || yearBands.Count == 0) return;

        foreach (var band in yearBands)
        {
            var bId = band.Id;
            var inc = ComputeJumlaMuqaddam(bId);
            var outg = ComputeRowOutgoing(bId);
            var diff = inc - outg;

            if (diff != 0)
            {
                var msg = diff > 0
                    ? $"المقدم ({inc}) أكبر من الخارج ({outg}) بمقدار {diff}"
                    : $"الخارج ({outg}) أكبر من المقدم ({inc}) بمقدار {Math.Abs(diff)}";
                validationIssues.Add(new ValidationIssue($"سنة {band.LabelAr} · كشف الإنتاج", msg, "production", bId));
            }

            var kinds = new[]
            {
                ("INTERLOC_EVID", "أحكام فرعية وإثبات"),
                ("RESERVED", "محجوز للحكم"),
                ("EXTEND", "مد الأجل"),
                ("RETURN_PLEADING", "إعادة للمرافعة"),
                ("FOR_REPORT", "المؤجل للتقرير"),
                ("OTHER", "المؤجل لأسباب أخرى")
            };

            foreach (var (k, label) in kinds)
            {
                var target = GetDistributionTarget(bId, k);
                var dist = GetTotalDistributed(bId, k);
                if (target != dist)
                {
                    var msg = target > dist
                        ? $"متبقي توزيع {target - dist} قضية على الشهور"
                        : $"زيادة توزيع {dist - target} قضية عن المطلوب";
                    validationIssues.Add(new ValidationIssue($"توزيع {label} ({band.LabelAr})", msg, "postponements", bId, k));
                }
            }
        }
    }

    private int GetProductionIssuesCount() =>
        validationIssues.Count(i => i.TargetTab == "production");

    private int GetPostponementIssuesCount() =>
