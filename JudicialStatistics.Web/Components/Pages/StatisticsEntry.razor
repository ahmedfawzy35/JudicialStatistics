    // ========== دوال المقدم المفصّل حسب الكود ==========

    private int GetIncomingByCode(long bandId, string code)
    {
        if (incomingByCode.TryGetValue((bandId, code), out var cached)) return cached;

        var it = filteredIncomingTypes.FirstOrDefault(x => x.Code == code);
        if (it == null) return 0;

        var ct = caseTypes?.FirstOrDefault();
        if (ct == null) return 0;

        return incomingValues.GetValueOrDefault((ct.Id, bandId, it.Id), 0);
    }

    private void SetIncomingByCode(long bandId, string code, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var val)) return;
        val = Math.Max(0, val);

        incomingByCode[(bandId, code)] = val;

        var it = filteredIncomingTypes.FirstOrDefault(x => x.Code == code);
        if (it != null && caseTypes != null)
        {
            foreach (var ct in caseTypes)
                incomingValues[(ct.Id, bandId, it.Id)] = val;
        }

        UpdateValidationIssues();
        StateHasChanged();
    }

    private int GetPreviousBalance(long bandId) =>
        matrix?.OpeningBalances.Where(ob => ob.CaseYearBandId == bandId).Sum(ob => ob.Count) ?? 0;

    private int ComputeJumlaMuqaddam(long bandId)
    {
        var prev    = GetPreviousBalance(bandId);
        var newV    = GetIncomingByCode(bandId, "NEW");
        var renew   = GetIncomingByCode(bandId, "RENEW");
        var recusal = GetIncomingByCode(bandId, "RECUSAL_WAIT");
        var shortV  = GetIncomingByCode(bandId, "SHORT");
        var accelP  = GetIncomingByCode(bandId, "ACCEL_PENAL");
        var accelS  = GetIncomingByCode(bandId, "ACCEL_SUSP");
        var accelA  = GetIncomingByCode(bandId, "ACCEL_AGREE");
        var accelI  = GetIncomingByCode(bandId, "ACCEL_INTERRUPT");
        var retApp  = GetIncomingByCode(bandId, "RETURN_APPEAL");
        var transTo = GetIncomingByCode(bandId, "TRANSFER_TO");
        var transF  = GetIncomingByCode(bandId, "TRANSFER_FROM");
        return prev + newV + renew + recusal + shortV + accelP + accelS + accelA + accelI + retApp + transTo - transF;
    }

