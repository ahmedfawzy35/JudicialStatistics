                                        </td>
                                        <td>
                                            <input type="number" class="crim-input" min="0" value="@GetCrimVal("CRIM_ORDER_FINAL")" disabled="@(!matrix.CanEdit)" @onchange='(e) => SetCrimVal("CRIM_ORDER_FINAL", e)' />
                                        </td>
                                        <td>
