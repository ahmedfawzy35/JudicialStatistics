    private void ToggleSessionSelection(long sessionId)
    {
        if (selectedSessionIdsSet.Contains(sessionId))
            selectedSessionIdsSet.Remove(sessionId);
        else
            selectedSessionIdsSet.Add(sessionId);
    }

    private void SelectAllSessions()
    {
        selectedSessionIdsSet = availableSessions.Select(s => s.SessionId).ToHashSet();
    }

    private void DeselectAllSessions()
    {
        selectedSessionIdsSet.Clear();
    }

    private async Task HandleSaveScope()
    {
        if (scopeTargetUser == null) return;
        isActionInProgress = true;
        try
        {
            var (success, msg) = await UserService.SaveUserSessionScopeAsync(
                scopeTargetUser.Id,
                scopeTargetUser.PrimaryCourtId,
                scopeMode,
                selectedSessionIdsSet.ToList()
            );

            statusMessage = msg;
            isError = !success;

            if (success)
            {
                CloseModals();
                await LoadUsersAsync();
            }
        }
        catch (Exception ex)
        {
            statusMessage = "حدث خطأ: " + ex.Message;
            isError = true;
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private static string GetRoleBadgeClass(string? code) => code switch
    {
        RoleCodes.SystemAdmin => "badge-primary",
        RoleCodes.ScopeAdmin => "badge-info",
        RoleCodes.Approver => "badge-success",
        RoleCodes.Reviewer => "badge-warning",
        RoleCodes.DataEntry => "badge-secondary",
        _ => "badge-secondary"
    };

